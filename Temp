package com.cnb.reports.service;

import java.util.Set;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.cnb.reports.config.ReportPluginConfigUtil;
import com.cnb.reports.constants.ReportPluginConstants;
import com.ibm.ecm.extension.PluginResponseUtil;
import com.ibm.ecm.extension.PluginService;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.ecm.json.JSONResponse;
import com.ibm.json.java.JSONArray;

/**
 * Returns plug-in configuration needed by the client (adminUsers list).
 */
public class GetReportUserContextService extends PluginService {

	public static final String SERVICE_ID = ReportPluginConstants.SERVICE_GET_REPORT_USER_CONTEXT;

	@Override
	public String getId() {
		return SERVICE_ID;
	}

	@Override
	public void execute(PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		final String method = "execute";
		callbacks.getLogger().logEntry(this, method, request);
		try {
			Set<String> admins = ReportPluginConfigUtil.parseAdminUsers(
					ReportPluginConfigUtil.loadConfigObject(callbacks));

			JSONArray adminUsers = new JSONArray();
			for (String admin : admins) {
				adminUsers.add(admin);
			}

			JSONResponse ok = new JSONResponse();
			ok.put("success", true);
			ok.put("adminUsers", adminUsers);
			PluginResponseUtil.writeJSONResponse(request, response, ok, callbacks, SERVICE_ID);
		} catch (Exception e) {
			callbacks.getLogger().logError(this, method, request, e);
			JSONResponse fail = new JSONResponse();
			fail.put("success", false);
			fail.put("adminUsers", new JSONArray());
			fail.put("message", e.getMessage() != null ? e.getMessage() : "Unable to load configuration.");
			PluginResponseUtil.writeJSONResponse(request, response, fail, callbacks, SERVICE_ID);
		} finally {
			callbacks.getLogger().logExit(this, method, request);
		}
	}
}
