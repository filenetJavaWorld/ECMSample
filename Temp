package com.cnb.repo.export.util;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.TimeZone;

public final class ExportFileNameUtil {

	private ExportFileNameUtil() {
	}

	public static String documentClassFileName(String className) {
		return "DocumentClassMetadata_" + sanitize(className) + "_" + timestamp() + ".xlsx";
	}

	public static String choiceListsFileName() {
		return "ChoiceLists_" + timestamp() + ".xlsx";
	}

	private static String timestamp() {
		SimpleDateFormat fmt = new SimpleDateFormat("yyyyMMdd_HHmmss");
		fmt.setTimeZone(TimeZone.getDefault());
		return fmt.format(new Date());
	}

	private static String sanitize(String name) {
		if (name == null || name.trim().isEmpty()) {
			return "Export";
		}
		String cleaned = name.trim().replaceAll("[\\\\/:*?\"<>|\\s]+", "_");
		if (cleaned.length() > 40) {
			cleaned = cleaned.substring(0, 40);
		}
		return cleaned;
