define([
	"dojo/_base/declare",
	"dojo/_base/lang",
	"dojo/_base/array",
	"dojo/aspect",
	"dojo/dom-class",
	"dojo/dom-construct",
	"dojo/dom-geometry",
	"dojo/dom-style",
	"dojo/string",
	"ecm/model/Message",
	"ecm/model/Request",
	"ecm/model/ResultSet",
	"ecm/model/SearchCriterion",
	"ecm/model/SearchFolder",
	"./AdvancedSearchControlsPanel",
	"ecm/widget/layout/SearchPane",
	"dojo/text!./templates/AdvancedSearchFeature.html"
], function(declare, lang, array, aspect, domClass, domConstruct, domGeometry, domStyle, string, Message, Request, ResultSet, SearchCriterion,
	SearchFolder, AdvancedSearchControlsPanel, SearchPane, template) {

	var LOG = "[MetlifeAdvancedSearch]";

	/**
	 * Document symbolic name → folder symbolic name mapping for folder / both modes.
	 * Keys and values must be P8 symbolic template names only (not display names).
	 * Unmapped document classes: Both mode runs document search only (no folder phase).
	 * Folders-only UI mode still uses same symbolic name when not listed here.
	 */
	var DOCUMENT_TO_FOLDER_CLASS_MAP = {
		"BaseDocument": "Base Folder",
		"AdministrativeReleases_Document": "AdministrativeReleases",
		"AnnuityandInvestments_Document": "AnnuityandInvestments"
	};

	return declare("searchPluginDojo.AdvancedSearchFeature", [ SearchPane ], {
		templateString: template,
		widgetsInTemplate: true,
		_tabStateByKey: null,
		_hooksInstalled: false,
		_slicesConfig: null,
		_documentRootClassId: "Document",
		_defaultDocumentClassIds: [ "BaseDocument", "Base Document", "Document" ],
		_defaultFolderClassIds: [ "BaseFolder", "Base Folder", "Folder" ],
		_folderRootClassId: "Folder",
		_postDocumentSearchDelayMs: 400,
		_extraResultColumnPropertyId: null,
		_extraResultColumnDisplayLabels: {
			"FolderPath": "Folder Path",
			"cmis:path": "Folder Path"
		},

		constructor: function() {
			this._tabStateByKey = {};
			this._slicesConfig = [];
		},

		postCreate: function() {
			this.logEntry("postCreate");
			this.inherited(arguments);
			this._installTabHooks();
			this._loadSlicesConfiguration(lang.hitch(this, function() {
				console.log(LOG, "Slices ready", this._slicesConfig);
			}));
			this.logExit("postCreate");
		},

		setParams: function(params) {
			this.logEntry("setParams", params);
			if (params) {
				this.setRepository(params.repository);
				this.loadContent();
				if (params.searchTemplate && this.openTab) {
					var openParams = lang.mixin({}, params);
					if (!openParams.tabType) {
						var isUnified = params.searchTemplate.isInstanceOf &&
							params.searchTemplate.isInstanceOf(ecm.model.UnifiedSearchTemplate);
						openParams.tabType = isUnified ? "unifiedsearchbuilder" : "searchbuilder";
					}
					this.openTab(openParams);
				}
			}
			this.logExit("setParams");
		},

		loadContent: function() {
			this.logEntry("loadContent");
			this.inherited(arguments);
			this.needReset = false;
			this.logExit("loadContent");
		},

		/**
		 * Saved searches open in SearchBuilder (custom criteria UI) instead of read-only SearchTab.
		 */
		_doSearchSelectorConnections: function() {
			var self = this;
			var UnifiedSearchTemplate = ecm.model.UnifiedSearchTemplate;

			this.searchSelector.connect(this.searchSelector, "onSearchTemplateSelected", function(searchTemplate) {
				var isUnified = searchTemplate.isInstanceOf && searchTemplate.isInstanceOf(UnifiedSearchTemplate);
				var tabType = isUnified ? "unifiedsearchbuilder" : "searchbuilder";
				self.openTab({
					UUID: searchTemplate.UUID,
					tabType: tabType,
					repository: self.repository,
					teamspace: self.teamspace,
					selected: true,
					closable: true,
					searchTemplate: searchTemplate
				});
			});

			this.searchSelector.connect(this.searchSelector, "onNewSearchButtonClick", function() {
				if (self.searchSelector) {
					self.searchSelector.clearSelection();
				}
				self.openTab({
					tabType: "searchbuilder",
					repository: self.repository,
					teamspace: self.teamspace,
					selected: true,
					closable: true
				});
			});

			this.searchSelector.connect(this.searchSelector, "onNewUnifiedSearchButtonClick", function() {
				if (self.searchSelector) {
					self.searchSelector.clearSelection();
				}
				self.openTab({
					tabType: "unifiedsearchbuilder",
					repository: self.repository,
					teamspace: self.teamspace,
					selected: true,
					closable: true
				});
			});
		},

		_parseSlicesConfiguration: function(pluginConfig) {
			pluginConfig = pluginConfig || {};
			var desktopId = ecm.model.desktop.id;
			var slicesText;
			if (desktopId == "Enterprise" || desktopId == "MSR") {
				slicesText = pluginConfig.enterpriseRepoScliceConfiguration;
			} else if (desktopId == "Correspondence") {
				slicesText = pluginConfig.correspondenceRepoScliceConfiguration;
			} else {
				slicesText = "[]";
			}
			if (slicesText === undefined || slicesText === null || slicesText === "") {
				slicesText = "[]";
			}
			var raw = typeof slicesText === "string" ? JSON.parse(slicesText) : slicesText;
			if (!Array.isArray(raw) || !raw.length) {
				return [];
			}
			var normalized = [];
			var i;
			for (i = 0; i < raw.length; i++) {
				var entry = raw[i];
				if (!entry) {
					continue;
				}
				var folderId = entry.folderId || entry.folderID || entry.id;
				if (!folderId) {
					continue;
				}
				normalized.push({
					label: entry.label || String(folderId),
					folderId: String(folderId).trim(),
					priority: entry.priority,
					repositoryId: entry.repositoryId,
					_orderIndex: normalized.length
				});
			}
			return normalized;
		},

		_getOrderedSlices: function() {
			var slices = (this._slicesConfig || []).slice();
			var hasPriority = function(slice) {
				return slice && slice.priority !== undefined && slice.priority !== null && slice.priority !== "";
			};
			slices.sort(function(a, b) {
				var aHasPriority = hasPriority(a);
				var bHasPriority = hasPriority(b);
				if (aHasPriority || bHasPriority) {
					var pa = aHasPriority ? Number(a.priority) : 999;
					var pb = bHasPriority ? Number(b.priority) : 999;
					if (pa !== pb) {
						return pa - pb;
					}
				}
				var ai = a && a._orderIndex !== undefined ? a._orderIndex : 999;
				var bi = b && b._orderIndex !== undefined ? b._orderIndex : 999;
				return ai - bi;
			});
			return slices;
		},

		_loadSlicesConfiguration: function(callback) {
			var self = this;
			Request.invokePluginService("SearchPlugin", "GetSearchPluginConfigurationService", {
				requestParams: {},
				requestCompleteCallback: function(response) {
					try {
						var pluginConfig = response || {};
						if (typeof pluginConfig === "string") {
							pluginConfig = JSON.parse(pluginConfig);
						}
						self._slicesConfig = self._parseSlicesConfiguration(pluginConfig);
						self._populateAllSliceDropdownOptions();
					} catch (e) {
						console.error(LOG, "Failed to parse slices configuration", e);
						self._slicesConfig = [];
					}
					if (callback) {
						callback();
					}
				},
				requestFailedCallback: function(error) {
					console.error(LOG, "Failed to load plugin configuration", error);
					self._slicesConfig = [];
					if (callback) {
						callback();
					}
				}
			});
		},

		_installTabHooks: function() {
			var self = this;
			if (this._hooksInstalled) {
				return;
			}
			this._hooksInstalled = true;
			aspect.after(this, "openTab", function(tab) {
				if (tab) {
					tab._metlifeAdvancedSearchTab = true;
				}
				setTimeout(function() {
					self._initializeAdvancedTab();
				}, 150);
			});
			if (this.searchTabContainer) {
				aspect.after(this.searchTabContainer, "selectChild", function() {
					setTimeout(function() {
						self._initializeAdvancedTab();
					}, 150);
				}, true);
			}
		},

		_getTabKey: function(tab) {
			return tab.id || tab.UUID || ("tab_" + new Date().getTime());
		},

		_getTemplateIdentity: function(template) {
			if (!template) {
				return "";
			}
			return String(template.id || template.vsId || template.UUID || "").trim();
		},

		_isNewSearchTemplate: function(def) {
			return !def || !def.searchTemplate || def.searchTemplate.isNew();
		},

		_getDefaultNewSearchSlice: function() {
			var slices = this._getOrderedSlices();
			return slices.length ? slices[0] : null;
		},

		_getSearchTemplateFolders: function(template, def) {
			if (template && template.folders && template.folders.length) {
				return template.folders;
			}
			if (def && def._folders && def._folders.length) {
				return def._folders;
			}
			return [];
		},

		/**
		 * Normalizes persisted search-type values to documents | folders | both.
		 */
		_normalizeAdvancedSearchType: function(searchType) {
			if (searchType === "documents" || searchType === "folders" || searchType === "both") {
				return searchType;
			}
			return "both";
		},

		/**
		 * Resolves the search type for a saved template.
		 * New searches default to Both elsewhere; this only runs for persisted templates.
		 * Both and Documents both store OOTB objectType=document, so the custom value
		 * must come from persisted MetLife metadata (moreOptions / application).
		 */
		_getSavedSearchType: function(template) {
			if (!template) {
				return "both";
			}
			var fromApplication = this._readApplicationAdvancedState(template);
			if (fromApplication && fromApplication.searchType) {
				return this._normalizeAdvancedSearchType(fromApplication.searchType);
			}
			if (template.moreOptions && template.moreOptions.metlifeSearchType) {
				return this._normalizeAdvancedSearchType(template.moreOptions.metlifeSearchType);
			}
			if (template._metlifeAdvancedSearchType) {
				return this._normalizeAdvancedSearchType(template._metlifeAdvancedSearchType);
			}
			return "both";
		},

		_normalizeFolderId: function(folderId) {
			if (!folderId) {
				return "";
			}
			return String(folderId).trim().toUpperCase();
		},

		/**
		 * Finds the slice whose configured folderId matches a folder from the saved search template Search In.
		 */
		_findSliceMatchingSearchInFolder: function(template, def) {
			var folders = this._getSearchTemplateFolders(template, def);
			if (!folders.length) {
				return null;
			}
			var i;
			for (i = 0; i < folders.length; i++) {
				var folder = folders[i];
				if (!folder) {
					continue;
				}
				var searchInFolderId = folder.id || folder.itemId;
				if (!searchInFolderId) {
					continue;
				}
				var slice = this._getSliceByValue(searchInFolderId);
				if (slice) {
					console.log(LOG, "Saved Search In folder matched slice config", {
						searchInFolderId: searchInFolderId,
						sliceLabel: slice.label,
						sliceFolderId: slice.folderId
					});
					return slice;
				}
			}
			console.log(LOG, "No slice config match for saved Search In folder(s)", folders);
			return null;
		},

		_initializeAdvancedTab: function(retryCount) {
			retryCount = retryCount || 0;
			var tab = this.searchTabContainer && this.searchTabContainer.selectedChildWidget;
			if (!tab || !tab.searchDefinition || !tab.searchDefinition.domNode) {
				if (retryCount < 25) {
					var self = this;
					setTimeout(function() {
						self._initializeAdvancedTab(retryCount + 1);
					}, 150);
				}
				return;
			}
			var tabKey = this._getTabKey(tab);
			var template = tab.searchDefinition.searchTemplate;
			var templateId = this._getTemplateIdentity(template);
			var state = this._tabStateByKey[tabKey];
			if (state && state.initialized) {
				if (state.restoredTemplateId === templateId) {
					return;
				}
				state.restoredTemplateId = templateId;
				state.userControlsActive = false;
				state.controlsRestored = false;
				state._savedTemplateRestoreAttempted = false;
				console.log(LOG, "Search template changed — restoring advanced controls", tabKey, templateId);
				this._refreshControlsSliceOptions(tabKey, { templateChanged: true, initialRestore: true });
				return;
			}
			console.log(LOG, "Initializing advanced search tab", tabKey);
			this._setupAdvancedSearchTab(tab, tabKey);
		},

		_setupAdvancedSearchTab: function(tab, tabKey) {
			var def = tab.searchDefinition;
			var state = this._tabStateByKey[tabKey] || {};
			state.tab = tab;
			state.def = def;
			this._tabStateByKey[tabKey] = state;

			this._hideOotbSearchInAndOptions(def);
			this._injectAdvancedControls(tab, tabKey, state);
			this._installTextSearchOperatorAllHook(def);
			this._installAdvancedSearchExecutionHook(tab, state);
			this._installModifiedOnUiSortHook(def);
			this._installAdvancedSearchPersistenceHooks(tab, state);
			this._installAdvancedSearchRestoreHooks(tab, state, tabKey);
			state.restoredTemplateId = this._getTemplateIdentity(def.searchTemplate);
			this._installDocumentClassCacheHook(def, state);
			this._installExtraResultColumnSearchHook(tab);
			this._scheduleEnsureExtraResultColumn(tabKey);
			this._scheduleDocumentClassSelectorUi(def);
			state.initialized = true;
		},

		/**
		 * Applies default BaseDocument selection after OOTB search definition load completes.
		 */
		_scheduleDocumentClassSelectorUi: function(def) {
			if (!def || def._metlifeAdvancedClassInitHooked) {
				return;
			}
			def._metlifeAdvancedClassInitHooked = true;
			var self = this;
			var run = function() {
				self._ensureDocumentClassSelectorUi(def);
			};
			if (def._classLoaded && def._folderLoaded) {
				run();
			} else if (def.onLoad) {
				var handle = aspect.after(def, "onLoad", function() {
					handle.remove();
					run();
				});
			} else {
				setTimeout(run, 300);
			}
		},

		_hideOotbSearchInAndOptions: function(def) {
			if (!def) {
				return;
			}
			// Hide only Search In + OOTB Search Options row; keep class selector visible.
			if (def._folderLabelNode && def._folderLabelNode.parentNode && def._folderLabelNode.parentNode.parentNode) {
				domStyle.set(def._folderLabelNode.parentNode.parentNode, "display", "none");
			}
			if (def._moreOptions && def._moreOptions.set) {
				def._moreOptions.set("objectTypeOptionHidden", true);
				def._moreOptions._selectedObjectType = "document";
				def._moreOptions._selectedFileTypes = def._moreOptions._selectedFileTypes || [];
			}
			if (def._moreOptionsNode) {
				domStyle.set(def._moreOptionsNode, "display", "none");
			}
			this._installMoreOptionsHiddenPatch(def);
		},

		/**
		 * When objectTypeOptionHidden is true, OOTB SearchMoreOptions.getSelectedOptions() omits
		 * objectType and macros — causing searchTemplate.objectType to be blank and server errors.
		 */
		_installMoreOptionsHiddenPatch: function(def) {
			var mo = def && def._moreOptions;
			if (!mo || mo._metlifeAdvancedOptionsPatch) {
				return;
			}
			mo._metlifeAdvancedOptionsPatch = true;
			aspect.around(mo, "getSelectedOptions", function(originalGetSelectedOptions) {
				return function() {
					var options = originalGetSelectedOptions.apply(this, arguments) || {};
					if (!options.objectType) {
						options.objectType = this._selectedObjectType || "document";
					}
					if (!options.macros) {
						options.macros = {
							fileTypes: this._selectedFileTypes || []
						};
					} else if (options.macros.fileTypes === undefined || options.macros.fileTypes === null) {
						options.macros.fileTypes = this._selectedFileTypes || [];
					}
					return options;
				};
			});
		},

		/**
		 * Ensures hidden OOTB moreOptions state matches a document search before template build.
		 */
		_ensureOotbDocumentMoreOptionsBeforeExecute: function(def) {
			if (!def || !def._moreOptions) {
				return;
			}
			var mo = def._moreOptions;
			mo._selectedObjectType = "document";
			mo._selectedFileTypes = mo._selectedFileTypes || [];
			if (mo._objectTypeOption && mo._objectTypeOption.setValue) {
				try {
					mo._objectTypeOption.setValue("document");
				} catch (e) {
					console.warn(LOG, "Could not set hidden object type option widget", e);
				}
			}
			if (mo._fileTypeOption && mo._fileTypeOption.setValue) {
				try {
					mo._fileTypeOption.setValue(mo._selectedFileTypes);
				} catch (e) {
					// file type option may be hidden/disabled — patch still supplies macros
				}
			}
			this._installMoreOptionsHiddenPatch(def);
		},

		_ensureOotbFolderMoreOptionsBeforeExecute: function(def) {
			if (!def || !def._moreOptions) {
				return;
			}
			var mo = def._moreOptions;
			mo._selectedObjectType = "folder";
			if (mo._objectTypeOption && mo._objectTypeOption.setValue) {
				try {
					mo._objectTypeOption.setValue("folder");
				} catch (e) {
					console.warn(LOG, "Could not set hidden object type option to folder", e);
				}
			}
			this._installMoreOptionsHiddenPatch(def);
		},

		_ensureClassSelectorVisible: function(def) {
			if (!def) {
				return;
			}
			if (def.contentClassSelectorArea) {
				domClass.remove(def.contentClassSelectorArea, "dijitHidden");
				domStyle.set(def.contentClassSelectorArea, "display", "");
			}
			if (def.searchScopeFields) {
				domStyle.set(def.searchScopeFields, "display", "");
			}
		},

		_resolveDefaultDocumentClass: function(repository) {
			if (!repository || !repository.getContentClass) {
				return null;
			}
			var ids = this._defaultDocumentClassIds || [ "BaseDocument", "Document" ];
			var i;
			for (i = 0; i < ids.length; i++) {
				var contentClass = repository.getContentClass(ids[i]);
				if (contentClass) {
					return contentClass;
				}
			}
			return null;
		},

		/**
		 * Keeps OOTB class selector on the Document hierarchy with BaseDocument selected on first load.
		 * Folders/Both/Documents modes are applied via _applyAdvancedSearchTypeUi when the user changes radios.
		 */
		_ensureDocumentClassSelectorUi: function(def) {
			if (!def || !def.repository) {
				return;
			}
			this._ensureClassSelectorVisible(def);

			if (def._metlifeAdvancedClassInitialized) {
				return;
			}
			// Saved/opened templates: let OOTB restore class and property criteria.
			if (def.searchTemplate && !def.searchTemplate.isNew()) {
				def._metlifeAdvancedClassInitialized = true;
				return;
			}

			var self = this;
			var applyClass = function() {
				if (def._metlifeAdvancedClassInitialized) {
					return;
				}
				var contentClass = self._resolveDefaultDocumentClass(def.repository);
				if (!contentClass) {
					console.warn(LOG, "Default document class not found", self._defaultDocumentClassIds);
					return;
				}
				var selector = def.contentClassSelector;
				if (!selector) {
					return;
				}
				if (selector.setRootClassId) {
					selector.setRootClassId(self._documentRootClassId, true);
				}
				if (def.repository._isP8 && def.repository._isP8()) {
					if (selector.setShowIncludeSubclasses) {
						selector.setShowIncludeSubclasses(true);
					}
					var includeSubclasses = def.searchTemplate ? def.searchTemplate.includeSubclasses !== false : true;
					if (selector.setIncludeSubclasses) {
						selector.setIncludeSubclasses(includeSubclasses);
					}
				}
				// setSelected triggers OOTB onContentClassSelected -> _setAttributeDefinitionFormFields
				if (selector.setSelected) {
					selector.setSelected(contentClass, false);
				}
				def._metlifeAdvancedClassInitialized = true;
				var tabState = self._tabStateByKey[def._metlifeAdvancedTabKey];
				if (tabState) {
					tabState._cachedDocumentClass = contentClass;
					self._scheduleEnsureExtraResultColumn(def._metlifeAdvancedTabKey);
				}
				self._syncOotbSearchType(def, "documents");
				console.log(LOG, "Document class selector ready", contentClass.id || contentClass.name);
			};

			if (def.contentClassSelector && def.contentClassSelector.getRepository && def.contentClassSelector.getRepository()) {
				applyClass();
			} else if (def.contentClassSelector) {
				var handle = this.connect(def.contentClassSelector, "onLoaded", function() {
					self.disconnect(handle);
					applyClass();
				});
				if (!def.contentClassSelector.getRepository()) {
					def.contentClassSelector.setRepository(def.repository);
				}
			}
		},

		_injectAdvancedControls: function(tab, tabKey, state) {
			var def = tab.searchDefinition;
			if (!def || state.controlsWidget) {
				return;
			}
			var self = this;
			var controls;
			var hostNode = domConstruct.create("div", {
				style: "display:none"
			}, def.searchSection || tab.domNode);

			if (def.contentClassSelectorArea && def.contentClassSelectorArea.parentNode) {
				var sliceRow = domConstruct.create("tr", {
					"class": "sectionContent metlifeAdvancedSliceRow"
				}, def.contentClassSelectorArea, "before");
				var sliceLabelCell = domConstruct.create("td", {
					"class": "sectionContent"
				}, sliceRow);
				var sliceControlCell = domConstruct.create("td", {
					"class": "sectionContent"
				}, sliceRow);

				var searchTypeRow = domConstruct.create("tr", {
					"class": "sectionContent metlifeAdvancedSearchTypeRow"
				}, def.contentClassSelectorArea, "before");
				var searchTypeLabelCell = domConstruct.create("td", {
					"class": "sectionContent"
				}, searchTypeRow);
				var searchTypeControlCell = domConstruct.create("td", {
					"class": "sectionContent"
				}, searchTypeRow);

				controls = new AdvancedSearchControlsPanel({});
				controls.placeAt(hostNode);
				controls.startup();
				controls.placeInSearchScopeTable(sliceLabelCell, sliceControlCell, searchTypeLabelCell, searchTypeControlCell);
				state.sliceRow = sliceRow;
				state.searchTypeRow = searchTypeRow;
			} else if (def.searchSection) {
				var panelNode = domConstruct.create("div", {
					"class": "metlifeAdvancedSearchControlsHost"
				}, def.searchSection, "first");
				controls = new AdvancedSearchControlsPanel({});
				controls.placeAt(panelNode);
				controls.startup();
				state.panelNode = panelNode;
			} else {
				return;
			}

			controls.onSliceChanged = function(value) {
				self._onAdvancedSliceSelected(tabKey, value);
			};
			controls.onSearchTypeChanged = function(searchType) {
				self._onAdvancedSearchTypeChanged(tabKey, searchType);
			};
			state.controlsWidget = controls;
			state.hostNode = hostNode;
			this._installAdvancedControlResizeHook(tab, state);
			if (def.contentClassSelector) {
				this.connect(def.contentClassSelector, "onLoaded", function() {
					self._alignAdvancedControlWidths(def, state);
				});
			}
			state.controlsWidget.updateSliceOptionsOnly(this._getOrderedSlices());
			if (this._isNewSearchTemplate(def)) {
				this._applyInitialAdvancedControls(tabKey, { initialRestore: true });
			}
			var selfRef = this;
			setTimeout(function() {
				selfRef._alignAdvancedControlWidths(def, state);
			}, 0);
		},

		_installAdvancedControlResizeHook: function(tab, state) {
			var def = state.def;
			if (!def || state.resizeHook) {
				return;
			}
			var self = this;
			if (def.resize) {
				state.resizeHook = aspect.after(def, "resize", function() {
					self._alignAdvancedControlWidths(def, state);
				}, true);
			}
		},

		_alignAdvancedControlWidths: function(def, state) {
			if (!def || !state || !state.controlsWidget) {
				return;
			}
			var classSelector = def.contentClassSelector;
			var sliceSelect = state.controlsWidget.sliceSelect;
