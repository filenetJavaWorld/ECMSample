package com.cnb.reports.service;

import javax.security.auth.Subject;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.filenet.api.util.UserContext;
import com.ibm.ecm.extension.PluginResponseUtil;
import com.ibm.ecm.extension.PluginService;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.ecm.json.JSONMessage;
import com.ibm.ecm.json.JSONResultSetResponse;
import com.cnb.reports.constants.ReportPluginConstants;

/**
 * Plugin search service for the Report Requests list, following the IBM sample plug-in pattern
 * ({@code SamplePluginSearchService} / {@code JSONResultSetResponse} + {@code ecm.model.ResultSet} +
 * {@code ecm.widget.listView.ContentList}).
 */
public class ReportRequestsSearchService extends PluginService {

	public static final String SERVICE_ID = ReportPluginConstants.SERVICE_REPORT_REQUESTS_SEARCH;

	public static final String REPOSITORY_ID = "repositoryId";
	public static final String REPOSITORY_TYPE = "repositoryType";

	@Override
	public String getId() {
		return SERVICE_ID;
	}

	@Override
	public void execute(PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		String methodName = "execute";
		callbacks.getLogger().logEntry(this, methodName, request);

		String repositoryId = request.getParameter(REPOSITORY_ID);
		String repositoryType = request.getParameter(REPOSITORY_TYPE);

		JSONResultSetResponse jsonResults = new JSONResultSetResponse();
		jsonResults.setPageSize(350);

		boolean pushedP8Subject = false;
		try {
			if (repositoryId == null || repositoryId.trim().isEmpty()) {
				throw new IllegalArgumentException("repositoryId is required.");
			}
			if (repositoryType == null || repositoryType.trim().isEmpty()) {
				throw new IllegalArgumentException("repositoryType is required.");
			}
			if (!"p8".equalsIgnoreCase(repositoryType.trim())) {
				throw new IllegalArgumentException("Only repositoryType p8 is supported for report requests.");
			}

			Subject subject = callbacks.getP8Subject(repositoryId);
			UserContext.get().pushSubject(subject);
			pushedP8Subject = true;

			Object synchObject = callbacks.getSynchObject(repositoryId, repositoryType);
			if (synchObject != null) {
				synchronized (synchObject) {
					ReportRequestsSearchServiceP8.executeP8Search(repositoryId, callbacks, jsonResults,
							request.getLocale());
				}
			} else {
				ReportRequestsSearchServiceP8.executeP8Search(repositoryId, callbacks, jsonResults,
						request.getLocale());
			}

			PluginResponseUtil.writeJSONResponse(request, response, jsonResults, callbacks, SERVICE_ID);

		} catch (Exception e) {
			callbacks.getLogger().logError(this, methodName, request, e);
			JSONMessage jsonMessage = new JSONMessage(0, e.getMessage(),
					"This error may occur if the search cannot be run on the repository.", "",
					"Check the IBM Content Navigator logs for more details.", "");
			jsonResults.addErrorMessage(jsonMessage);
			PluginResponseUtil.writeJSONResponse(request, response, jsonResults, callbacks, SERVICE_ID);
		} finally {
			if (pushedP8Subject) {
				UserContext.get().popSubject();
			}
			callbacks.getLogger().logExit(this, methodName, request);
		}
	}
}
