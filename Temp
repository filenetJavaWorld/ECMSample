define([
	"dojo/_base/array",
	"dojo/_base/lang",
	"ecm/model/SearchCriterion",
	"ecm/model/SearchTemplate"
], function(array, lang, SearchCriterion, SearchTemplate) {

	var EMAIL_SEPARATOR = ";";

	function mapCriterionValues(criterion) {
		var vals = [];
		if (criterion.values && criterion.values.length) {
			array.forEach(criterion.values, function(v) {
				if (v && typeof v === "object" && v.value !== undefined && v.value !== null) {
					vals.push(v.value);
				} else if (v !== undefined && v !== null) {
					vals.push(v);
				}
			});
		} else if (criterion.value !== undefined && criterion.value !== null && criterion.value !== "") {
			vals.push(criterion.value);
		}
		return vals;
	}

	function mapCriteria(searchTemplate) {
		var list = searchTemplate.searchCriteria || [];
		return array.map(list, function(c, idx) {
			return {
				sequence: idx + 1,
				propertySymbolicName: c.id || "",
				propertyDisplayName: c.name || c.label || c.id || "",
				operator: c.selectedOperator || "",
				dataType: c.dataType || "",
				values: mapCriterionValues(c)
			};
		});
	}

	function mapResultDisplay(searchTemplate) {
		var rd = searchTemplate.resultsDisplay || {};
		var cols = array.map(rd.columns || [], function(colId) {
			return {
				propertySymbolicName: colId,
				propertyDisplayName: colId
			};
		});
		var sort = [];
		// ICN uses sortAsc; accept sortAscending as a fallback.
		var ascending = rd.sortAsc !== undefined ? rd.sortAsc !== false : rd.sortAscending !== false;
		if (rd.sortBy) {
			sort.push({
				propertySymbolicName: rd.sortBy,
				direction: ascending ? "ASC" : "DESC"
			});
		}
		return {
			columns: cols,
			sort: sort
		};
	}

	function mapSearchScope(searchTemplate) {
		var folders = searchTemplate.folders || [];
		if (!folders.length) {
			return "OBJECT_STORE";
		}
		return "FOLDER";
	}

	function mapVersionOption(searchTemplate) {
		if (!searchTemplate.moreOptions) {
			return "CURRENT_VERSION";
		}
		var v = searchTemplate.moreOptions.versionOption;
		if (!v) {
			return "CURRENT_VERSION";
		}
		return String(v).toUpperCase();
	}

	function parseSemicolonEmails(raw) {
		if (raw === undefined || raw === null) {
			return [];
		}
		var text = String(raw).trim();
		if (text.length === 0) {
			return [];
		}
		var seen = {};
		var emails = [];
		array.forEach(text.split(EMAIL_SEPARATOR), function(part) {
			var email = lang.trim(part);
			if (!email) {
				return;
			}
			var key = email.toLowerCase();
			if (!seen[key]) {
				seen[key] = true;
				emails.push(email);
			}
		});
		return emails;
	}

	function formatEmailsForField(emailList) {
		if (!emailList || !emailList.length) {
			return "";
		}
		return array.map(emailList, function(email) {
			return String(email);
		}).join(EMAIL_SEPARATOR);
	}

	function resolveSendEmailsFromPayload(payload) {
		if (!payload) {
			return true;
		}
		if (payload.sendEmails !== undefined && payload.sendEmails !== null) {
			return !!payload.sendEmails;
		}
		if (payload.sendEmail !== undefined && payload.sendEmail !== null) {
			return !!payload.sendEmail;
		}
		return true;
	}

	function isValidEmailAddress(email) {
		return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
	}

	function findInvalidEmail(emails) {
		for (var i = 0; i < emails.length; i++) {
			if (!isValidEmailAddress(emails[i])) {
				return emails[i];
			}
		}
		return null;
	}

	function buildInvalidEmailMessage(invalidEmail) {
		return "Invalid email address detected:\n" + invalidEmail
			+ "\nPlease enter valid email addresses separated by semicolon (;).";
	}

	function buildPayload(repository, reportName, sendEmail, sendEmailTo, sendEmailCc, searchTemplate, extras) {
		var os = (searchTemplate.objectStores && searchTemplate.objectStores[0]) || {};
		var targetSym = searchTemplate.className || "";
		var targetDisp = targetSym;
		if (repository && targetSym) {
			var cls = repository.getContentClass(targetSym);
			if (cls && cls.name) {
				targetDisp = cls.name;
			}
		}
		// Always persist FileNet ObjectStore *symbolic* name (e.g. OBJ1) — used by ReportsExecutionTool.
		var objectStoreSymbolicName = (repository && repository.objectStoreName)
			|| (os && (os.symbolicName || os.name))
			|| "";
		var payload = {
			reportName: reportName,
			sendEmails: !!sendEmail,
			sendEmailTo: sendEmail ? (sendEmailTo || []) : [],
			sendEmailCC: sendEmail ? (sendEmailCc || []) : [],
			repositoryId: repository.id,
			repositoryName: objectStoreSymbolicName,
			objectStoreId: os.id || (repository && repository.objectStoreId) || objectStoreSymbolicName || "",
			objectStoreName: objectStoreSymbolicName,
			targetClassSymbolicName: targetSym,
			targetClassDisplayName: targetDisp,
			includeSubclasses: !!searchTemplate.includeSubclasses,
			searchScope: mapSearchScope(searchTemplate),
			versionOption: mapVersionOption(searchTemplate),
			criteria: mapCriteria(searchTemplate),
			resultDisplay: mapResultDisplay(searchTemplate)
		};
		if (extras) {
			lang.mixin(payload, extras);
		}
		return payload;
	}

	function normalizeCriterionValues(rawValues) {
		var values = [];
		array.forEach(rawValues || [], function(v) {
			if (v === undefined || v === null || v === "") {
				return;
			}
			if (typeof v === "object" && v.value !== undefined && v.value !== null) {
				values.push(String(v.value));
			} else {
				values.push(String(v));
			}
		});
		return values.length ? values : [
			""
		];
	}

	function buildSearchCriteriaFromPayload(criteria) {
		return array.map(criteria || [], function(c) {
			var values = normalizeCriterionValues(c.values);
			var operator = c.operator || "";
			// AttributeDefinitionWidget only applies operator/values when criterion is a SearchCriterion.
			var criterion = new SearchCriterion({
				id: c.propertySymbolicName || "",
				name: c.propertyDisplayName || c.propertySymbolicName || "",
				dataType: c.dataType || "",
				selectedOperator: operator,
				defaultOperator: operator || undefined,
				defaultValue: values
			});
			if (operator) {
				criterion.selectedOperator = operator;
			}
			criterion.setValues(values);
			return criterion;
		});
	}

	function buildResultsDisplayFromPayload(resultDisplay) {
		var rd = resultDisplay || {};
		var columns = array.map(rd.columns || [], function(col) {
			if (col && typeof col === "object") {
				return col.propertySymbolicName || col.id || "";
			}
			return String(col);
		}).filter(function(colId) {
			return !!colId;
		});
		var sort = (rd.sort && rd.sort[0]) || null;
		var sortBy = sort ? (sort.propertySymbolicName || "") : (rd.sortBy || "");
		var sortAsc = true;
		if (sort) {
			sortAsc = String(sort.direction || "ASC").toUpperCase() !== "DESC";
		} else if (rd.sortAsc !== undefined) {
			sortAsc = !!rd.sortAsc;
		} else if (rd.sortAscending !== undefined) {
			sortAsc = !!rd.sortAscending;
		}
		return {
			columns: columns,
			sortBy: sortBy || null,
			sortAsc: sortAsc,
			magazineColumns: lang.isArray(rd.magazineColumns) ? lang.clone(rd.magazineColumns) : [],
			// Marks this as an existing/saved display so later IBM processing keeps sort/columns.
			saved: true,
			honorNameProperty: rd.honorNameProperty !== undefined ? !!rd.honorNameProperty : true,
			showContentSummary: !!rd.showContentSummary,
			maxResults: rd.maxResults != null ? rd.maxResults : 0
		};
	}

	function buildSearchTemplateFromPayload(searchDefinition, repository, payload) {
		var templateId = "cnb-report-" + (payload.reportRequestId || payload.documentId || "request");
		var params = {
			id: templateId,
			name: payload.reportName || "Report Request",
			description: payload.reportName || "Report Request",
			repository: repository
		};
		var template = (searchDefinition && lang.isFunction(searchDefinition.createSearchTemplate))
			? searchDefinition.createSearchTemplate(params)
			: new SearchTemplate(params);

		template.repository = repository;
		template.className = payload.targetClassSymbolicName || "";
		template.includeSubclasses = payload.includeSubclasses !== undefined ? !!payload.includeSubclasses : true;
		template.objectType = payload.objectType || "document";
		template.searchCriteria = buildSearchCriteriaFromPayload(payload.criteria);
		template.resultsDisplay = buildResultsDisplayFromPayload(payload.resultDisplay || payload.resultsDisplay);
		template._searchContentClass = null;

		var versionOption = payload.versionOption
			? String(payload.versionOption).toLowerCase()
			: "currentversion";
