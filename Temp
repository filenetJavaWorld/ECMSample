		_buildSliceSelectOptions: function(slices) {
			slices = slices || [];
			var selectOptions = [];
			var i;
			for (i = 0; i < slices.length; i++) {
				var slice = slices[i];
				if (!slice || !slice.folderId) {
					continue;
				}
				selectOptions.push({
					label: slice.label || String(slice.folderId),
					value: String(slice.folderId).trim()
				});
			}
			return selectOptions;
		},

		/**
		 * Refreshes slice dropdown entries without changing the current selection or search type.
		 */
		updateSliceOptionsOnly: function(slices) {
			if (!this.sliceSelect) {
				return;
			}
			var currentValue = this.getSelectedSliceValue();
			this.sliceSelect.set("options", this._buildSliceSelectOptions(slices));
			if (currentValue) {
				this._suppressSliceChangeEvents = true;
				this._applySliceValue(currentValue, null);
				this._suppressSliceChangeEvents = false;
			}
		},

		setSlices: function(slices, setupOptions) {
			setupOptions = setupOptions || {};
			var syncOnly = !!setupOptions.syncOnly;
			slices = slices || [];
			var selectOptions = this._buildSliceSelectOptions(slices);
			this.sliceSelect.set("options", selectOptions);
			if (syncOnly || setupOptions.skipAutoSelect) {
				this._suppressSliceChangeEvents = true;
			}
			try {
				if (this.sliceSelect.reset && !syncOnly) {
					this.sliceSelect.reset();
				}
			} finally {
				if (!syncOnly) {
					this._suppressSliceChangeEvents = !!setupOptions.skipAutoSelect;
				}
			}
			if (setupOptions.selectedValue) {
				this._applySliceValue(
					setupOptions.selectedValue,
					setupOptions.onSelectComplete || function() {}
				);
			} else if (!syncOnly && setupOptions.defaultLabel) {
				this.selectSliceByLabel(setupOptions.defaultLabel, setupOptions.onSelectComplete, !!setupOptions.strictLabelMatch);
			} else if (!syncOnly && !setupOptions.skipAutoSelect && slices.length) {
				this.selectSliceByLabel("Enterprise", setupOptions.onSelectComplete, true);
			}
			if (setupOptions.searchType) {
				this.setSearchType(setupOptions.searchType, syncOnly);
			} else if (!syncOnly) {
				this.setSearchType("both", false);
			}
			if (syncOnly) {
				this._suppressSliceChangeEvents = false;
			}
		},

		selectSliceByLabel: function(label, onComplete, strictLabelMatch) {
			if (!label || !this.sliceSelect) {
				if (onComplete) {
					onComplete(false);
				}
				return false;
			}
			var options = this.sliceSelect.get("options") || [];
			var targetValue = null;
			var i;
			for (i = 0; i < options.length; i++) {
				if (options[i] && String(options[i].label).trim() === String(label).trim()) {
					targetValue = options[i].value;
					break;
				}
			}
			if (!targetValue && !strictLabelMatch && options.length) {
				targetValue = options[0].value;
			}
			if (!targetValue) {
				if (onComplete) {
					onComplete(false);
				}
				return false;
			}
			return this._applySliceValue(targetValue, onComplete);
		},

		setSelectedSliceValue: function(value) {
			return this._applySliceValue(value, null);
		},

		_applySliceValue: function(value, onComplete) {
			var self = this;
			var tryApply = function(attempt) {
				if (!self.sliceSelect) {
					if (onComplete) {
						onComplete(false);
					}
					return false;
				}
				self.sliceSelect.set("value", value);
				if (String(self.sliceSelect.get("value")).trim() === String(value).trim()) {
					if (!self._suppressSliceChangeEvents && !onComplete) {
						self.onSliceChanged(value);
					}
					if (onComplete) {
						onComplete(true);
					}
					return true;
				}
				if (attempt < 20) {
					setTimeout(function() {
						tryApply(attempt + 1);
					}, 50);
					return false;
				}
				if (onComplete) {
					onComplete(false);
				}
				return false;
			};
			return tryApply(0);
		},

		getSelectedSliceValue: function() {
			return this.sliceSelect ? this.sliceSelect.get("value") : "";
		},

		getSearchType: function() {
			if (this.bothRadio && this.bothRadio.get("checked")) {
				return "both";
			}
			if (this.foldersRadio && this.foldersRadio.get("checked")) {
				return "folders";
			}
			return "documents";
		},

		setSearchType: function(searchType, silent) {
			var prevSuppress = this._suppressSearchTypeChangeEvents;
			if (silent) {
				this._suppressSearchTypeChangeEvents = true;
			}
			try {
				if (searchType === "documents" && this.documentsRadio) {
					this.documentsRadio.set("checked", true);
				} else if (searchType === "folders" && this.foldersRadio) {
					this.foldersRadio.set("checked", true);
				} else if (this.bothRadio) {
					this.bothRadio.set("checked", true);
				}
			} finally {
				if (silent) {
					this._suppressSearchTypeChangeEvents = prevSuppress;
				}
			}
		},

		/**
		 * Moves controls into the OOTB searchScopeFields table so labels and fields
		 * align with the Class row (label column + control column).
		 */
		placeInSearchScopeTable: function(sliceLabelCell, sliceControlCell, searchTypeLabelCell, searchTypeControlCell) {
			if (sliceLabelCell && this.sliceLabelNode) {
				sliceLabelCell.appendChild(this.sliceLabelNode);
			}
			if (sliceControlCell && this.sliceSelect && this.sliceSelect.domNode) {
				sliceControlCell.appendChild(this.sliceSelect.domNode);
			}
			if (searchTypeLabelCell && this.searchTypeLabelNode) {
				searchTypeLabelCell.appendChild(this.searchTypeLabelNode);
			}
			if (searchTypeControlCell && this.searchTypeOptionsNode) {
				searchTypeControlCell.appendChild(this.searchTypeOptionsNode);
			}
			if (this.containerNode) {
				domStyle.set(this.containerNode, "display", "none");
			}
		},

		onSliceChanged: function(value) {},
		onSearchTypeChanged: function(searchType) {}
	});
