define([
	"dojo/_base/lang"
], function(lang) {

	var REPORT_REQUEST_CLASS = "ReportRequest";

	/**
	 * Resolves the FileNet / ICN item class (template) symbolic name.
	 */
	function resolveItemClass(item) {
		if (!item) {
			return "";
		}
		if (item.template) {
			return String(item.template).trim();
		}
		if (item.attributes && item.attributes.className) {
			return String(item.attributes.className).trim();
		}
		if (lang.isFunction(item.getValue)) {
			var className = item.getValue("className");
			if (className) {
				return String(className).trim();
			}
		}
		if (item.id) {
			var parts = String(item.id).split(",");
			if (parts.length >= 1 && parts[0]) {
				return String(parts[0]).trim();
			}
		}
		if (lang.isFunction(item.getContentClass)) {
			try {
				var cls = item.getContentClass();
				if (cls && cls.id) {
					return String(cls.id).trim();
				}
			} catch (e) {
				// ignore
			}
		}
		return "";
	}

	function isReportRequestItem(item) {
		return resolveItemClass(item) === REPORT_REQUEST_CLASS;
	}

	/**
	 * True when every selected item is a ReportRequest (or there are no items yet).
	 */
	function areAllReportRequestItems(items) {
		if (!items || !items.length) {
			return false;
		}
		for (var i = 0; i < items.length; i++) {
			if (!isReportRequestItem(items[i])) {
				return false;
			}
		}
		return true;
	}

	return {
		REPORT_REQUEST_CLASS: REPORT_REQUEST_CLASS,
		resolveItemClass: resolveItemClass,
		isReportRequestItem: isReportRequestItem,
		areAllReportRequestItems: areAllReportRequestItems
	};
});
