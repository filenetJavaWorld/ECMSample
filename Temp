/**
 * Phase 2 service: exports choice lists to Excel.
 */
public class ExportChoiceListsService extends PluginService {

	public static final String SERVICE_ID = "exportChoiceLists";
	private static final String CONTENT_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

	@Override
	public String getId() {
		return SERVICE_ID;
	}

	@Override
	public void execute(PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		final String method = "execute";
		callbacks.getLogger().logEntry(this, method, request);
		try {
			JSONObject payloadJson;
			try {
				payloadJson = JsonRequestUtil.parseObject(JsonRequestUtil.readBody(request));
			} catch (IllegalArgumentException e) {
				writeFailure(response, request, callbacks, e.getMessage());
				return;
			}

			final ChoiceListExportRequest exportRequest = ChoiceListExportRequest.fromJson(payloadJson);
			try {
				exportRequest.validate();
			} catch (IllegalArgumentException e) {
				writeFailure(response, request, callbacks, e.getMessage());
				return;
			}

			callbacks.getLogger().logDebug(this, method,
					"Export choice lists repo=" + exportRequest.getRepositoryId() + " mode="
							+ exportRequest.getExportMode() + " selected="
							+ exportRequest.getSelectedChoiceListIds().size());

			byte[] workbookBytes;
			try {
				workbookBytes = P8ContextUtil.runWithP8Context(callbacks, exportRequest.getRepositoryId(),
						new P8ContextUtil.P8Callback<byte[]>() {
							public byte[] run(ObjectStore objectStore) throws Exception {
								return new ChoiceListWorkbookGenerator().generate(objectStore, exportRequest);
							}
						});
			} catch (MetadataExportException e) {
				callbacks.getLogger().logError(this, method, request, e);
				writeFailure(response, request, callbacks, e.getMessage());
				return;
			} catch (Exception e) {
				callbacks.getLogger().logError(this, method, request, e);
				writeFailure(response, request, callbacks, friendlyConnectError(e));
				return;
			}

			String fileName = ExportFileNameUtil.choiceListsFileName();
			JSONResponse ok = new JSONResponse();
			ok.put("success", Boolean.TRUE);
			ok.put("fileName", fileName);
			ok.put("contentType", CONTENT_TYPE);
			ok.put("base64Content", Base64.getEncoder().encodeToString(workbookBytes));
			ok.put("size", Integer.valueOf(workbookBytes.length));
			PluginResponseUtil.writeJSONResponse(request, response, ok, callbacks, SERVICE_ID);
		} finally {
			callbacks.getLogger().logExit(this, method, request);
		}
	}

	private static String friendlyConnectError(Exception e) {
		String msg = e.getMessage() != null ? e.getMessage().toLowerCase() : "";
		if (msg.contains("connect") || msg.contains("repository")) {
			return "Unable to connect to the repository.";
		}
		if (msg.contains("permission") || msg.contains("access") || msg.contains("security")) {
			return "Permission denied while reading repository metadata.";
		}
		return "Unable to retrieve choice-list metadata.";
	}

	private static void writeFailure(HttpServletResponse response, HttpServletRequest request,
			PluginServiceCallbacks callbacks, String message) throws Exception {
		JSONResponse err = new JSONResponse();
		err.put("success", Boolean.FALSE);
		err.put("message", message != null ? message : "The Excel report could not be generated.");
		PluginResponseUtil.writeJSONResponse(request, response, err, callbacks, SERVICE_ID);
	}
}
