		_mapCriterionToFolderFallback: function(def, criterion) {
			if (!criterion || !criterion.id) {
				return null;
			}
			var docNameProp = this._getNamePropertyForMode(def, "document");
			var folderNameProp = this._getNamePropertyForMode(def, "folder");
			var mappedCriterion = criterion.clone ? criterion.clone() : lang.clone(criterion);
			if (this._isDocumentNameProperty(criterion.id, docNameProp)) {
				mappedCriterion.id = folderNameProp;
				mappedCriterion.name = "Folder Name";
				return mappedCriterion;
			}
			return mappedCriterion;
		},

		/**
		 * Folder search uses property operators (LIKE), not CBR. Remove CBR syntax chars
		 * (", ?, *) so values like "Sample test" become Sample test.
		 * Document / CBR search must not call this.
		 */
		_sanitizeFolderSearchToken: function(token) {
			if (token == null) {
				return "";
			}
			return String(token).replace(/["?*]/g, "").trim();
		},

		/**
		 * Sanitize FolderName criterion values on a folder template (folder call only).
		 */
		_sanitizeFolderNameCriteriaOnTemplate: function(def, folderTemplate) {
			if (!folderTemplate || !folderTemplate.searchCriteria) {
				return folderTemplate;
			}
			var folderNameProp = this._getNamePropertyForMode(def, "folder") || "FolderName";
			var i;
			for (i = 0; i < folderTemplate.searchCriteria.length; i++) {
				var criterion = folderTemplate.searchCriteria[i];
				if (!this._isFolderNameCriterion(criterion, folderNameProp)) {
					continue;
				}
				if (!criterion.values || !criterion.values.length) {
					continue;
				}
				var before = criterion.values.slice ? criterion.values.slice() : criterion.values;
				var sanitizedValues = [];
				var v;
				for (v = 0; v < criterion.values.length; v++) {
					var raw = criterion.values[v];
					if (raw == null || raw === "") {
						sanitizedValues.push(raw === undefined ? "" : raw);
					} else {
						sanitizedValues.push(this._sanitizeFolderSearchToken(raw));
					}
				}
				if (criterion.setValues) {
					criterion.setValues(sanitizedValues);
				} else {
					criterion.values = sanitizedValues;
				}
				criterion.defaultValue = sanitizedValues;
				console.log(LOG, "Sanitized FolderName values for folder search (removed CBR chars \" ? *)", {
					before: before,
					after: sanitizedValues
				});
			}
			return folderTemplate;
		},

		/**
		 * First non-empty string from a criterion values array (Both folder-phase helper).
		 */
		_getCriterionFirstNonEmptyValue: function(criterion) {
			if (!criterion || !criterion.values || !criterion.values.length) {
				return "";
			}
			var i;
			for (i = 0; i < criterion.values.length; i++) {
				if (criterion.values[i] != null && String(criterion.values[i]).trim()) {
					return String(criterion.values[i]).trim();
				}
			}
			return "";
		},

		/**
		 * Token for FolderName — mirrors Basic Search behavior.
		 * Prefer document name property values; fall back to CBR/text (template then live widget).
		 */
		_extractFolderNameTokenFromDocumentTemplate: function(def, documentTemplate) {
			if (documentTemplate) {
				var docNameProp = this._getNamePropertyForMode(def, "document");
				var criteria = documentTemplate.searchCriteria || [];
				var i;
				for (i = 0; i < criteria.length; i++) {
					var criterion = criteria[i];
					if (!criterion || !criterion.id) {
						continue;
					}
					if (this._isDocumentNameProperty(criterion.id, docNameProp)) {
						var nameValue = this._getCriterionFirstNonEmptyValue(criterion);
						if (nameValue) {
							return nameValue;
						}
					}
				}
				var fromTemplate = this._extractTextSearchToken(documentTemplate);
				if (fromTemplate) {
					return fromTemplate;
				}
			}
			if (def && def._textSearchText && def._textSearchText.get) {
				return String(def._textSearchText.get("value") || "").trim();
			}
			return "";
		},

		/**
		 * Non-empty CBR / text-search string from a prepared document template.
		 */
		_extractTextSearchToken: function(template) {
			if (!template) {
				return "";
			}
			var criteria = template.textSearchCriteria;
			if (criteria && !lang.isArray(criteria) && criteria.text != null) {
				return String(criteria.text).trim();
			}
			if (!lang.isArray(criteria) || !criteria.length) {
				return "";
			}
			var i;
			for (i = 0; i < criteria.length; i++) {
				var c = criteria[i];
				if (c && c.text != null && String(c.text).trim()) {
					return String(c.text).trim();
				}
			}
			return "";
		},

		_isFolderNameCriterion: function(criterion, folderNameProp) {
			if (!criterion) {
				return false;
			}
			var id = criterion.id || criterion.name;
			return id === folderNameProp || id === "FolderName" || criterion.name === "Folder Name";
		},

		/**
		 * Both folder phase only: ensure FolderName LIKE has a real value (Basic-style),
		 * or drop an empty FolderName so it is not submitted as values [].
		 */
		_ensureFolderNameCriterionForBothFolderPhase: function(def, folderTemplate, documentTemplate) {
			if (!folderTemplate) {
				return folderTemplate;
			}
			var folderNameProp = this._getNamePropertyForMode(def, "folder") || "FolderName";
			var token = this._sanitizeFolderSearchToken(
				this._extractFolderNameTokenFromDocumentTemplate(def, documentTemplate));
			var criteria = folderTemplate.searchCriteria ? folderTemplate.searchCriteria.slice() : [];
			var folderNameCriterion = null;
			var i;
			for (i = 0; i < criteria.length; i++) {
				if (this._isFolderNameCriterion(criteria[i], folderNameProp)) {
					folderNameCriterion = criteria[i];
					break;
				}
			}
			var existingValue = this._sanitizeFolderSearchToken(
				this._getCriterionFirstNonEmptyValue(folderNameCriterion));
			if (existingValue) {
				var existingValues = [ existingValue, "" ];
				if (folderNameCriterion.setValues) {
					folderNameCriterion.setValues(existingValues);
				} else {
					folderNameCriterion.values = existingValues;
				}
				folderNameCriterion.defaultValue = existingValues;
				folderNameCriterion.selectedOperator = "LIKE";
				folderNameCriterion.defaultOperator = "LIKE";
				return this._sanitizeFolderNameCriteriaOnTemplate(def, folderTemplate);
			}
			if (token) {
				var values = [ token, "" ];
				if (folderNameCriterion) {
					folderNameCriterion.id = folderNameProp;
					folderNameCriterion.name = "Folder Name";
					// Force LIKE (Basic parity) — OOTB empty FolderName often defaults to STARTSWITH.
					folderNameCriterion.selectedOperator = "LIKE";
					folderNameCriterion.defaultOperator = "LIKE";
					folderNameCriterion.dataType = folderNameCriterion.dataType || "xs:string";
					folderNameCriterion.cardinality = folderNameCriterion.cardinality || "SINGLE";
					folderNameCriterion.defaultValue = values;
					if (folderNameCriterion.setValues) {
						folderNameCriterion.setValues(values);
					} else {
						folderNameCriterion.values = values;
					}
				} else {
					folderNameCriterion = new SearchCriterion({
						id: folderNameProp,
						name: "Folder Name",
						selectedOperator: "LIKE",
						defaultOperator: "LIKE",
						dataType: "xs:string",
						cardinality: "SINGLE",
						valueRequired: false,
						readOnly: false,
						hidden: false
					});
					if (folderNameCriterion.setValues) {
						folderNameCriterion.setValues(values);
					} else {
						folderNameCriterion.values = values;
					}
					folderNameCriterion.defaultValue = values;
					criteria.push(folderNameCriterion);
					folderTemplate.searchCriteria = criteria;
				}
				console.log(LOG, "Both folder phase — FolderName value applied from document name/CBR text", {
					folderNameProp: folderNameProp,
					token: token
				});
				return this._sanitizeFolderNameCriteriaOnTemplate(def, folderTemplate);
			}
			// No token: remove empty FolderName so it does not go out as values [].
			if (folderNameCriterion) {
				folderTemplate.searchCriteria = array.filter(criteria, lang.hitch(this, function(c) {
					return !this._isFolderNameCriterion(c, folderNameProp);
				}));
				console.log(LOG, "Both folder phase — removed empty FolderName criterion (no document name/CBR token)");
			}
			return this._sanitizeFolderNameCriteriaOnTemplate(def, folderTemplate);
		},

		_prepareFolderTemplateFromDocumentTemplate: function(def, documentTemplate, callback) {
			var self = this;
			var documentClass = this._getDocumentClassFromTemplate(def, documentTemplate) ||
				this._getSelectedDocumentClass(def);
			var folderClassId = this._getExplicitFolderClassMapping(documentClass);
			if (!folderClassId) {
				console.log(LOG, "Folder search skipped — document class has no entry in DOCUMENT_TO_FOLDER_CLASS_MAP", {
					documentClassId: documentClass && documentClass.id,
					documentClassName: documentClass && (documentClass.name || documentClass.displayName)
				});
				callback(null);
				return;
			}

			this._resolveFolderContentClass(def, folderClassId, function(folderClass) {
				if (!documentTemplate || !folderClass) {
					callback(null);
					return;
				}
				var folderTemplate = documentTemplate.clone ? documentTemplate.clone() : lang.clone(documentTemplate);
				folderTemplate = self._applyOotbFolderSearchTemplateFields(folderTemplate, def);
				folderTemplate = self._mergeExtraResultColumnOnSearchTemplate(folderTemplate, def.repository);
				var sourceCriteria = documentTemplate.searchCriteria || [];
				var clonedCriteria = [];
				var c;
				for (c = 0; c < sourceCriteria.length; c++) {
					if (sourceCriteria[c] && sourceCriteria[c].clone) {
						clonedCriteria.push(sourceCriteria[c].clone());
					} else if (sourceCriteria[c]) {
						clonedCriteria.push(lang.clone(sourceCriteria[c]));
					}
				}
				folderTemplate.searchCriteria = self._mapCriteriaForFolderClass(def, clonedCriteria, folderClass);
				// Both folder phase only (this method is not used by folders-only / documents-only).
				// Fill FolderName from DocumentTitle or CBR text when mapping left it empty.
				folderTemplate = self._ensureFolderNameCriterionForBothFolderPhase(def, folderTemplate, documentTemplate);
				if (folderTemplate.setSearchContentClass) {
					folderTemplate.setSearchContentClass(folderClass);
				} else {
					folderTemplate.classes = [ folderClass.id ];
				}
				folderTemplate.includeSubclasses = documentTemplate.includeSubclasses !== false;
				if (documentTemplate.folders) {
					folderTemplate.folders = lang.clone(documentTemplate.folders);
				}
				var criteriaSummary = [];
				if (folderTemplate.searchCriteria) {
					var s;
					for (s = 0; s < folderTemplate.searchCriteria.length; s++) {
						var mc = folderTemplate.searchCriteria[s];
						if (mc) {
							criteriaSummary.push({
								id: mc.id,
								operator: mc.selectedOperator,
								values: mc.values
							});
						}
					}
				}
				console.log(LOG, "Folder template prepared (behind the scenes)", {
					documentClass: documentClass && (documentClass.name || documentClass.id || documentTemplate.className),
					folderClass: folderClass.id || folderClass.name,
					mappedFromClass: documentTemplate.className,
					criteriaCount: folderTemplate.searchCriteria ? folderTemplate.searchCriteria.length : 0,
					criteria: criteriaSummary
				});
				callback(folderTemplate);
			});
		},

		/**
		 * Folders-only: match Basic Search — objectType=folder, FolderName LIKE from CBR text,
		 * folder textSearchCriteria cleared. Mutates the prepared template before template.search().
		 */
		_alignFoldersOnlyTemplateLikeBasic: function(def, template) {
			if (!template) {
				return template;
			}
			// Capture CBR / FolderName token before folder fields clear textSearchCriteria.
			var token = this._sanitizeFolderSearchToken(
				this._extractFolderNameTokenFromDocumentTemplate(def, template));
			if (!token) {
				var folderNameProp = this._getNamePropertyForMode(def, "folder") || "FolderName";
				var criteria = template.searchCriteria || [];
				var i;
				for (i = 0; i < criteria.length; i++) {
					if (this._isFolderNameCriterion(criteria[i], folderNameProp)) {
						token = this._sanitizeFolderSearchToken(
							this._getCriterionFirstNonEmptyValue(criteria[i]));
						if (token) {
							break;
						}
					}
				}
			}
			template = this._applyOotbFolderSearchTemplateFields(template, def);
			template = this._mergeExtraResultColumnOnSearchTemplate(template, def && def.repository);
			// Rebuild FolderName from captured token (Basic parity).
			if (token) {
				var snapshot = {
					searchCriteria: [],
					textSearchCriteria: [ { text: token } ]
				};
				template = this._ensureFolderNameCriterionForBothFolderPhase(def, template, snapshot);
			} else {
				template = this._ensureFolderNameCriterionForBothFolderPhase(def, template, template);
			}
			console.log(LOG, "Folders-only template aligned like Basic", {
				objectType: template.objectType,
				className: template.className,
				token: token,
				criteriaCount: template.searchCriteria ? template.searchCriteria.length : 0
			});
			return this._sanitizeFolderNameCriteriaOnTemplate(def, template);
		},

		_installAdvancedSearchExecutionHook: function(tab, state) {
			var def = tab.searchDefinition;
			if (!def || def._metlifeAdvancedExecuteHook) {
				return;
			}
			var tabKey = this._getTabKey(tab);
			def._metlifeAdvancedExecuteHook = true;
			def._metlifeAdvancedTabKey = tabKey;
			var self = this;
			aspect.around(def, "_executeSearch", function(originalExecute) {
				def._metlifeAdvancedOriginalExecute = originalExecute;
				return function() {
					var execState = self._resolveExecutionState(def, state);
					if (!execState) {
						console.warn(LOG, "No execution state — falling back to OOTB search");
						return originalExecute.apply(def, arguments);
					}
					var searchType = execState.controlsWidget ?
						execState.controlsWidget.getSearchType() : "both";
					self._persistAdvancedState(execState);
					console.log(LOG, "Search button clicked", { searchType: searchType, tabKey: tabKey });

					var runSearch = function(ready) {
						if (!ready) {
							console.error(LOG, "Search aborted — slice Search In folder could not be applied");
							return;
						}
						// Every search uses Text Options "All of the terms".
						self._applyTextSearchOperatorAll(def);
						if (searchType === "documents") {
							self._ensureOotbDocumentMoreOptionsBeforeExecute(def);
							self._logSearchExecutionContext(execState, "documents");
							// Use around (not after) so we receive the real prepared template argument.
							var docPrepHandle = aspect.around(def, "onSearchTemplatePrepared", function(originalPrepared) {
								return function(template) {
									if (docPrepHandle) {
										docPrepHandle.remove();
										docPrepHandle = null;
									}
									self._forceTextSearchCriteriaOperatorAll(template);
									// Rank is text/CBR only — skip for property-only document searches.
									if (self._templateHasTextSearchCriteria(template)) {
										self._applyDocumentRankSort(template);
										self._installOneShotDocumentRankSearchHook(template);
									}
									self._logSearchPayload(execState, "document", template);
									console.log(LOG, "Document Search Started", {
										useRankSort: self._templateHasTextSearchCriteria(template)
									});
									return originalPrepared.apply(this, arguments);
								};
							});
							var docCompleteHandle = aspect.after(def, "onSearchCompleted", function(results) {
								if (docCompleteHandle) {
									docCompleteHandle.remove();
								}
								self._logSearchPhaseComplete("document", results);
								self._logTotalResults(results);
							}, true);
							originalExecute.apply(def, arguments);
							return;
						}
						if (searchType === "folders") {
							self._ensureOotbFolderMoreOptionsBeforeExecute(def);
							self._logSearchExecutionContext(execState, "folders");
							var folderPrepHandle = aspect.around(def, "onSearchTemplatePrepared", function(originalPrepared) {
								return function(template) {
									if (folderPrepHandle) {
										folderPrepHandle.remove();
										folderPrepHandle = null;
									}
									// Basic parity: FolderName LIKE from CBR + objectType=folder.
									template = self._alignFoldersOnlyTemplateLikeBasic(def, template);
									self._forceTextSearchCriteriaOperatorAll(template);
									self._logSearchPayload(execState, "folder", template);
									console.log(LOG, "Folder Search Started");
									return originalPrepared.apply(this, arguments);
								};
							});
							var folderCompleteHandle = aspect.after(def, "onSearchCompleted", function(results) {
								if (folderCompleteHandle) {
									folderCompleteHandle.remove();
								}
								self._logSearchPhaseComplete("folder", results);
								self._logTotalResults(results);
							}, true);
							originalExecute.apply(def, arguments);
							return;
						}
						self._runAdvancedBothSearch(execState, def);
					};

					self._ensureSearchInBeforeExecute(execState, runSearch);
				};
			});
		},

		_runAdvancedBothSearch: function(state, def) {
			var self = this;
			console.log(LOG, "Both mode — document search first, folder search behind the scenes (UI stays on document class)");
			this._beginBothSearchStatusCapture(state);
			def._metlifeAdvancedDeferButtonEnable = true;
			this._executeOotbDocumentSearch(def, state, function(documentResults, documentTemplate) {
				var documentClass = self._getDocumentClassFromTemplate(def, documentTemplate) ||
					self._getSelectedDocumentClass(def);
				var mappedFolderClassId = self._getExplicitFolderClassMapping(documentClass);
				if (!mappedFolderClassId) {
					console.log(LOG, "Both mode — no folder class mapping; returning document results only", {
						documentClassId: documentClass && documentClass.id,
						documentClassName: documentClass && (documentClass.name || documentClass.displayName)
					});
					def._metlifeAdvancedDeferButtonEnable = false;
					self._logTotalResults(documentResults);
					self._completeAdvancedSearch(state, documentResults);
					return;
				}
				console.log(LOG, "Both mode — starting behind-the-scenes folder search", {
					documentClassId: documentClass && documentClass.id,
					mappedFolderClassId: mappedFolderClassId
				});
				setTimeout(function() {
					var templateIsPrepared = !documentResults && !!documentTemplate;
					self._runAdvancedFolderPhase(state, def, documentResults || documentTemplate, function(folderResults) {
						def._metlifeAdvancedDeferButtonEnable = false;
						var merged = self._mergeAdvancedResults(documentResults, folderResults, state);
						self._logTotalResults(merged);
						self._completeAdvancedSearch(state, merged);
					}, templateIsPrepared, documentTemplate);
				}, self._postDocumentSearchDelayMs);
			});
		},

		_runAdvancedFolderPhase: function(state, def, documentTemplateOrResults, onComplete, templateInputIsPrepared, fallbackDocumentTemplate) {
			var self = this;
			var preparedDocumentTemplate = null;
			// Prefer the prepared document template from the document phase (has criteria/CBR text).
			if (fallbackDocumentTemplate) {
				preparedDocumentTemplate = fallbackDocumentTemplate;
			} else if (templateInputIsPrepared) {
				preparedDocumentTemplate = documentTemplateOrResults;
			} else if (documentTemplateOrResults && documentTemplateOrResults.searchTemplate) {
				preparedDocumentTemplate = documentTemplateOrResults.searchTemplate;
			} else {
				this._ensureOotbDocumentMoreOptionsBeforeExecute(def);
				preparedDocumentTemplate = def._prepareSearchTemplateForExecution();
			}
			this._prepareFolderTemplateFromDocumentTemplate(def, preparedDocumentTemplate, function(folderTemplate) {
				if (!folderTemplate) {
					console.error(LOG, "Folder search skipped — folder template unavailable");
					if (onComplete) {
						onComplete(null);
					}
					return;
				}
				self._logSearchPayload(state, "folder", folderTemplate);
				console.log(LOG, "Folder Search Started");
				folderTemplate.search(function(folderResults) {
					self._logSearchPhaseComplete("folder", folderResults);
					if (onComplete) {
						onComplete(folderResults);
					}
				}, null, null, def.teamspace, function(err) {
					console.error(LOG, "Folder search request failed", err);
					self._logSearchPhaseComplete("folder", null);
					if (onComplete) {
						onComplete(null);
					}
				});
			});
		},

		_mergeAdvancedResults: function(documentResults, folderResults, state) {
			if (!documentResults && !folderResults) {
				return null;
			}
			if (!documentResults) {
				return this._attachAdvancedRefreshHandler(folderResults, state);
			}
			if (!folderResults) {
				return this._attachAdvancedRefreshHandler(documentResults, state);
			}

			// Option A: dual-stream Both paging — documents first, then folders; UI page ≤ 200.
			return this._attachAdvancedRefreshHandler(
				this._buildBothPagedResultSet(documentResults, folderResults, state), state);
		},

		/**
		 * Combined Both UI page size (not 200 docs + 200 folders per page).
		 */
		_getCombinedUiPageSize: function(docRs, folderRs) {
			var ps = (docRs && docRs.pageSize) || (folderRs && folderRs.pageSize) || 200;
			return ps > 0 ? ps : 200;
		},

		_bothPagerHasMore: function(pager) {
			if (!pager) {
				return false;
			}
			if (pager.docOffset < pager.docFetched.length) {
				return true;
			}
			if (pager.docContinuation) {
				return true;
			}
			if (pager.folderOffset < pager.folderFetched.length) {
				return true;
			}
			if (pager.folderContinuation) {
				return true;
			}
			return false;
		},

		_takeNextBothPageItems: function(pager, maxCount) {
			var pageItems = [];
			if (!pager || !maxCount) {
				return pageItems;
			}
			while (pageItems.length < maxCount && pager.docOffset < pager.docFetched.length) {
				pageItems.push(pager.docFetched[pager.docOffset++]);
			}
			while (pageItems.length < maxCount && pager.folderOffset < pager.folderFetched.length) {
				pageItems.push(pager.folderFetched[pager.folderOffset++]);
			}
			return pageItems;
		},

		_fetchBothStreamPage: function(pager, stream, callback, onError) {
			var rs = stream === "document" ? pager.docRs : pager.folderRs;
			var continuation = stream === "document" ? pager.docContinuation : pager.folderContinuation;
			if (!rs || !continuation) {
				if (stream === "document") {
					pager.docContinuation = null;
				} else {
					pager.folderContinuation = null;
				}
				callback(false);
				return;
			}
			rs.continuationData = continuation;
			rs.items = stream === "document" ? pager.docFetched : pager.folderFetched;
			var prevLen = rs.items ? rs.items.length : 0;
			var self = this;
			rs.retrieveNextPage(function() {
				var items = rs.items || [];
				if (stream === "document") {
					pager.docFetched = items;
					pager.docContinuation = rs.continuationData || null;
					pager.docMaxResultsReached = !!rs.maxResultsReached;
					self._markCombinedSearchResultTypes(items.slice(prevLen), "Document");
				} else {
					pager.folderFetched = items;
					pager.folderContinuation = rs.continuationData || null;
					pager.folderMaxResultsReached = !!rs.maxResultsReached;
					self._markCombinedSearchResultTypes(items.slice(prevLen), "Folder");
				}
				if (items.length <= prevLen) {
					if (stream === "document") {
						pager.docContinuation = null;
					} else {
						pager.folderContinuation = null;
					}
					callback(false);
					return;
				}
				callback(true);
			}, pager.pageSize, function(err) {
				console.error(LOG, "Both pager continueQuery failed", stream, err);
				if (stream === "document") {
					pager.docContinuation = null;
				} else {
					pager.folderContinuation = null;
				}
				if (onError) {
					onError(err);
				}
				callback(false);
			});
		},

		/**
		 * Ensure buffers can supply `needed` more UI items (docs first, then folders).
		 */
		_fillBothPagerBuffers: function(pager, needed, callback, onError) {
			var self = this;
			if (!pager || needed <= 0) {
				callback();
				return;
			}
			var available = function() {
				return (pager.docFetched.length - pager.docOffset) +
					(pager.folderFetched.length - pager.folderOffset);
			};
			var step = function() {
				if (available() >= needed) {
					callback();
					return;
				}
				var docsLeft = pager.docFetched.length - pager.docOffset;
				if (docsLeft > 0) {
					if (docsLeft >= needed) {
						callback();
						return;
					}
					if (pager.docContinuation) {
						self._fetchBothStreamPage(pager, "document", function() {
							step();
						}, onError);
						return;
					}
					var foldersLeft = pager.folderFetched.length - pager.folderOffset;
					if (docsLeft + foldersLeft >= needed) {
						callback();
						return;
					}
					if (pager.folderContinuation) {
						self._fetchBothStreamPage(pager, "folder", function() {
							step();
						}, onError);
						return;
					}
					callback();
					return;
				}
				if (pager.docContinuation) {
					self._fetchBothStreamPage(pager, "document", function() {
						step();
					}, onError);
					return;
				}
				var foldersLeft2 = pager.folderFetched.length - pager.folderOffset;
				if (foldersLeft2 >= needed) {
					callback();
					return;
				}
				if (pager.folderContinuation) {
					self._fetchBothStreamPage(pager, "folder", function() {
						step();
					}, onError);
					return;
				}
				callback();
			};
			step();
		},

		_installBothPagedRetrieveNextPage: function(merged) {
			var self = this;
			merged.retrieveNextPage = function(retrievedCallback, itemsNeeded, onError) {
				var pager = merged._metlifeBothPager;
				if (!pager) {
					merged.continuationData = null;
					if (retrievedCallback) {
						retrievedCallback(merged.items || []);
					}
					return null;
				}
				var target = itemsNeeded && itemsNeeded > 0 ?
					itemsNeeded :
					((merged.items ? merged.items.length : 0) + pager.pageSize);
				var fillMore = function() {
					if ((merged.items && merged.items.length >= target) || !self._bothPagerHasMore(pager)) {
						merged.continuationData = self._bothPagerHasMore(pager) ? "metlifeBothPaging" : null;
						merged.maxResultsReached = !!(pager.docMaxResultsReached || pager.folderMaxResultsReached);
						if (merged.onNextPageRetrieved) {
							merged.onNextPageRetrieved(merged);
						}
						if (retrievedCallback) {
							retrievedCallback(merged.items || []);
						}
						return;
					}
					var stillNeeded = Math.min(pager.pageSize, target - (merged.items ? merged.items.length : 0));
					if (stillNeeded <= 0) {
						stillNeeded = pager.pageSize;
					}
					self._fillBothPagerBuffers(pager, stillNeeded, function() {
						var pageItems = self._takeNextBothPageItems(pager, stillNeeded);
						if (!pageItems.length) {
							merged.continuationData = self._bothPagerHasMore(pager) ? "metlifeBothPaging" : null;
							if (merged.onNextPageRetrieved) {
								merged.onNextPageRetrieved(merged);
							}
							if (retrievedCallback) {
								retrievedCallback(merged.items || []);
							}
							return;
						}
						merged.items = (merged.items || []).concat(pageItems);
						fillMore();
					}, onError);
				};
				fillMore();
				return null;
			};
		},

		/**
		 * Builds a Both ResultSet with independent doc/folder continuations.
		 * UI pages are ≤ pageSize combined items; documents are exhausted before folders.
		 */
		_buildBothPagedResultSet: function(docRs, folderRs, state) {
			var pageSize = this._getCombinedUiPageSize(docRs, folderRs);
			var docItems = this._markCombinedSearchResultTypes(
				docRs.items ? docRs.items.slice() : [], "Document");
			var folderItems = this._markCombinedSearchResultTypes(
				folderRs.items ? folderRs.items.slice() : [], "Folder");

			var pager = {
				pageSize: pageSize,
				docRs: docRs,
				folderRs: folderRs,
				docFetched: docItems,
				folderFetched: folderItems,
				docOffset: 0,
				folderOffset: 0,
				docContinuation: docRs.continuationData || null,
				folderContinuation: folderRs.continuationData || null,
				docMaxResultsReached: !!docRs.maxResultsReached,
				folderMaxResultsReached: !!folderRs.maxResultsReached
			};
			// keep stream ResultSets aligned for continueQuery skip=items.length
			docRs.items = pager.docFetched;
			folderRs.items = pager.folderFetched;

			var pageItems = this._takeNextBothPageItems(pager, pageSize);
			var totalCount = null;
			if (docRs.totalCount != null || folderRs.totalCount != null) {
				totalCount = (docRs.totalCount || 0) + (folderRs.totalCount || 0);
			}
			var merged = new ResultSet({
				id: docRs.id || folderRs.id || "metlifeBothResults",
				name: "Search results",
				repository: docRs.repository || folderRs.repository,
				parentFolder: docRs.parentFolder || folderRs.parentFolder,
				searchTemplate: docRs.searchTemplate || folderRs.searchTemplate,
				setType: docRs.setType || folderRs.setType,
				pageSize: pageSize,
				structure: this._pickMergedGridStructure(docRs, folderRs),
				magazineStructure: (docRs.magazineStructure && docRs.magazineStructure.length) ?
					lang.clone(docRs.magazineStructure) :
					(folderRs.magazineStructure ? lang.clone(folderRs.magazineStructure) : null),
				items: pageItems,
				continuationData: this._bothPagerHasMore(pager) ? "metlifeBothPaging" : null,
				totalCount: totalCount,
				totalCountType: docRs.totalCountType || folderRs.totalCountType,
				maxResultsReached: !!(pager.docMaxResultsReached || pager.folderMaxResultsReached)
			});
			if (merged.searchTemplate && !merged.searchTemplate.name) {
				merged.searchTemplate.name = "Search results";
			}
			merged._metlifeBothPager = pager;
			merged._metlifeAdvancedCombinedSearch = true;
			this._installBothPagedRetrieveNextPage(merged);
			console.log(LOG, "Both paged result set built (Option A: docs then folders)", {
				pageSize: pageSize,
				firstPageCount: pageItems.length,
				docBuffered: pager.docFetched.length,
				folderBuffered: pager.folderFetched.length,
				hasMore: !!merged.continuationData,
				docContinuation: !!pager.docContinuation,
				folderContinuation: !!pager.folderContinuation,
				totalCount: totalCount
			});
			return merged;
		},

		_pickMergedGridStructure: function(docRs, folderRs) {
			var docStruct = docRs && docRs.structure;
			var folderStruct = folderRs && folderRs.structure;
			var docCells = docStruct && docStruct.cells && docStruct.cells[0] ?
				docStruct.cells[0].length : 0;
			var folderCells = folderStruct && folderStruct.cells && folderStruct.cells[0] ?
				folderStruct.cells[0].length : 0;
			var picked = null;
			if (docCells >= folderCells && docStruct) {
				picked = lang.clone(docStruct);
			} else if (folderStruct) {
				picked = lang.clone(folderStruct);
			} else if (docStruct) {
				picked = lang.clone(docStruct);
			}
			return this._preserveFolderColumnDecoratorsOnMergedStructure(picked, folderStruct);
		},

		_markCombinedSearchResultTypes: function(items, resultType) {
			if (!items || !items.length) {
				return items;
			}
			for (var i = 0; i < items.length; i++) {
				if (items[i]) {
					items[i]._metlifeResultType = resultType;
				}
			}
			return items;
		},

		/**
		 * Copies missing grid cell decorators (e.g. FolderPath → EnterpriseLinkDecorator)
		 * from the folder result structure onto the merged structure.
		 */
		_preserveFolderColumnDecoratorsOnMergedStructure: function(mergedStructure, folderStructure) {
			if (!mergedStructure || !folderStructure) {
				return mergedStructure;
			}
			var mergedCells = mergedStructure.cells && mergedStructure.cells[0];
			var folderCells = folderStructure.cells && folderStructure.cells[0];
			if (!mergedCells || !folderCells) {
				return mergedStructure;
			}
			var folderDecoratorByField = {};
			for (var i = 0; i < folderCells.length; i++) {
				var folderCell = folderCells[i];
				if (folderCell && folderCell.field && folderCell.decorator) {
					folderDecoratorByField[folderCell.field] = folderCell.decorator;
				}
			}
			for (var j = 0; j < mergedCells.length; j++) {
				var cell = mergedCells[j];
				if (!cell || !cell.field || cell.decorator) {
					continue;
				}
				if (folderDecoratorByField[cell.field]) {
					cell.decorator = folderDecoratorByField[cell.field];
					console.log(LOG, "Restored column decorator from folder result structure", cell.field);
				}
			}
			return mergedStructure;
		},

		/**
		 * True when the prepared template has real CBR/text criteria (non-empty text).
		 * Rank sort is only valid in that case ("Rank (Text search only)").
		 */
		_templateHasTextSearchCriteria: function(template) {
			if (!template) {
				return false;
			}
			var criteria = template.textSearchCriteria;
			if (criteria && !lang.isArray(criteria) && criteria.text) {
				return String(criteria.text).trim().length > 0;
			}
			if (!lang.isArray(criteria) || !criteria.length) {
				return false;
			}
			var i;
			for (i = 0; i < criteria.length; i++) {
				var c = criteria[i];
				if (c && c.text != null && String(c.text).trim().length > 0) {
					return true;
				}
			}
			return false;
		},

		/**
		 * Document/text search must sort by Rank (not OOTB Name default).
		 * Caller must only invoke this when _templateHasTextSearchCriteria(template) is true.
		 */
		_applyDocumentRankSort: function(template) {
			if (!template) {
				return template;
			}
			if (!template.resultsDisplay) {
				template.resultsDisplay = {};
			}
			template.resultsDisplay.sortBy = "Rank";
			template.resultsDisplay.sortAsc = false;
			console.log(LOG, "Document search sort set to Rank descending");
			return template;
		},

		/**
		 * One-shot wrap so the next template.search() call uses order_by=Rank.
		 * Removed after first use so later folder searches on the same template are unaffected.
		 */
		_installOneShotDocumentRankSearchHook: function(template) {
			if (!template || !template.search) {
				return;
			}
			var searchHandle = aspect.around(template, "search", function(originalSearch) {
				return function(callback, sortProperty, descending, teamspace, errorCallback, useCache) {
					if (searchHandle) {
						searchHandle.remove();
						searchHandle = null;
					}
					return originalSearch.call(this, callback, "Rank", true, teamspace, errorCallback, useCache);
				};
			});
		},

		_completeAdvancedSearch: function(state, resultSet) {
			var def = state.def;
			var tab = state.tab;
			if (def) {
				def._metlifeAdvancedDeferButtonEnable = false;
			}
			if (def && def.searchButton && def.searchButton.set) {
				def.searchButton.set("disabled", false);
			}
			if (resultSet && resultSet.searchTemplate && !resultSet.searchTemplate.name) {
				resultSet.searchTemplate.name = "Search results";
			}
			// Both paged stream keeps docs-then-folders order; skip global Modified On resort.
			// Documents-only / Folders-only still sort loaded rows by Modified On.
			if (resultSet && !resultSet._metlifeBothPager) {
				resultSet = this._sortResultSetByModifiedDescending(resultSet);
			}
			if (def && def.onSearchCompleted) {
				def.onSearchCompleted(resultSet);
			} else if (tab && tab.searchResults && tab.searchResults.setResultSet) {
				tab.searchResults.setResultSet(resultSet);
			}
			if (tab && tab._setToolbarButtonDisabledState) {
				tab._setToolbarButtonDisabledState("RefreshGrid", false);
			}
			this._endBothSearchStatusCaptureAndPublish(state, resultSet);
		},

		/**
		 * Documents/Folders OOTB execute path: sort loaded results by Modified On before the grid binds.
		 * Both mode is handled in _completeAdvancedSearch.
		 */
		_installModifiedOnUiSortHook: function(def) {
			if (!def || def._metlifeModifiedOnUiSortHook) {
				return;
			}
			def._metlifeModifiedOnUiSortHook = true;
			var self = this;
			aspect.around(def, "onSearchCompleted", function(originalOnSearchCompleted) {
				return function(resultSet) {
					// Both Option A pager must keep documents-then-folders order.
					if (!resultSet || !resultSet._metlifeBothPager) {
						self._sortResultSetByModifiedDescending(resultSet);
					}
					return originalOnSearchCompleted.apply(this, arguments);
				};
			});
			console.log(LOG, "Modified On UI sort hook installed");
		},

		/**
		 * Client-side only: sort the loaded result page by DateLastModified descending
		 * (latest modified on top). Does not change the CE search Rank order_by.
		 * Does not trigger a server re-sort when continuation pages exist.
		 */
		_sortResultSetByModifiedDescending: function(resultSet) {
			if (!resultSet || !resultSet.items || !resultSet.items.length) {
				return resultSet;
			}
			var propId = "DateLastModified";
			var self = this;
			var items = resultSet.items.slice();
			items.sort(function(a, b) {
				var aVal = self._getItemModifiedTimeValue(a, propId);
				var bVal = self._getItemModifiedTimeValue(b, propId);
				if (aVal === bVal) {
					return 0;
				}
				if (aVal == null) {
					return 1;
				}
				if (bVal == null) {
					return -1;
				}
				return aVal > bVal ? -1 : 1;
			});
			resultSet.items = items;
			var colIndex = this._findResultSetColumnSortIndex(resultSet, propId);
			if (colIndex > 0) {
				resultSet.sortIndex = colIndex;
				resultSet.sortDirection = -1;
			}
			console.log(LOG, "UI sorted loaded results by DateLastModified descending", {
				itemCount: items.length,
				sortIndex: resultSet.sortIndex,
				hasContinuation: !!resultSet.continuationData
			});
			return resultSet;
		},

		_getItemModifiedTimeValue: function(item, propId) {
			if (!item) {
				return null;
			}
			var val = null;
			if (item.getValue) {
				try {
					val = item.getValue(propId);
				} catch (e) {
					val = null;
				}
			}
			if ((val == null || val === "") && item.attributes && item.attributes[propId] != null) {
				val = item.attributes[propId];
			}
			if (lang.isArray(val)) {
				val = val.length ? val[0] : null;
			}
			if (val == null || val === "") {
				return null;
			}
			if (val instanceof Date) {
				return val.getTime();
			}
			if (typeof val === "number" && !isNaN(val)) {
				return val;
			}
			var parsed = Date.parse(val);
			if (!isNaN(parsed)) {
				return parsed;
			}
			return null;
		},

		_findResultSetColumnSortIndex: function(resultSet, propId) {
			if (!resultSet || !propId) {
				return -1;
			}
			resultSet.columnNames = null;
			var columns = resultSet.getColumns ? resultSet.getColumns() : null;
			if (columns && columns.length) {
				var i;
				for (i = 0; i < columns.length; i++) {
					if (columns[i] === propId) {
						return i + 1;
					}
				}
			}
			var cells = resultSet.structure && resultSet.structure.cells && resultSet.structure.cells[0];
			if (cells && cells.length) {
				var j;
				for (j = 0; j < cells.length; j++) {
					var cell = cells[j];
					if (cell && (cell.field === propId || cell.name === propId)) {
						return j + 1;
					}
				}
			}
			return -1;
		},

		/**
		 * OOTB posts one footer status message per search request. In Both mode the folder phase
		 * overwrites the document count — capture and replace with the merged total.
		 */
		_beginBothSearchStatusCapture: function(state) {
			var self = this;
			var desktop = ecm.model.desktop;
			if (!state || !desktop || typeof desktop.addMessage !== "function") {
				return;
			}
			this._endBothSearchStatusCapture(state);
			state._metlifeBothSearchStatusCaptureActive = true;
			state._metlifeBothSearchStatusSample = null;
			state._metlifeBothSearchStatusOriginalAddMessage = desktop.addMessage;
			desktop.addMessage = function(message) {
				if (state._metlifeBothSearchStatusCaptureActive &&
					self._isSearchResultsStatusMessage(message)) {
					state._metlifeBothSearchStatusSample = message.text;
					return;
				}
				return state._metlifeBothSearchStatusOriginalAddMessage.apply(desktop, arguments);
			};
		},

		_endBothSearchStatusCapture: function(state) {
			if (!state || !state._metlifeBothSearchStatusCaptureActive) {
				return state ? state._metlifeBothSearchStatusSample : null;
			}
			var desktop = ecm.model.desktop;
			state._metlifeBothSearchStatusCaptureActive = false;
			if (desktop && state._metlifeBothSearchStatusOriginalAddMessage) {
				desktop.addMessage = state._metlifeBothSearchStatusOriginalAddMessage;
				delete state._metlifeBothSearchStatusOriginalAddMessage;
			}
			return state._metlifeBothSearchStatusSample;
		},

		_endBothSearchStatusCaptureAndPublish: function(state, resultSet) {
			var sampleText = this._endBothSearchStatusCapture(state);
			if (!resultSet || !resultSet._metlifeAdvancedCombinedSearch) {
				return;
			}
			this._publishCombinedSearchStatusMessage(resultSet, sampleText);
		},

		_isSearchResultsStatusMessage: function(message) {
			if (!message || message.level !== 0 || !message.text) {
				return false;
			}
			var text = String(message.text);
			// OOTB server keys: search.results.returned / returnedOne / returned.limit
			return /\d/.test(text) && (/returned/i.test(text) || /returnerte/i.test(text) ||
				/\u8fd4\u56de/.test(text) || /\u50b3\u56de/.test(text));
		},

		_getCombinedSearchResultCount: function(resultSet) {
			if (!resultSet) {
				return 0;
			}
			if (resultSet.totalCount != null && resultSet.totalCount !== undefined &&
				(!resultSet.totalCountType || resultSet.totalCountType === "total")) {
				return parseInt(resultSet.totalCount, 10) || 0;
			}
			return resultSet.items ? resultSet.items.length : 0;
		},

		_formatCombinedSearchStatusMessage: function(sampleText, totalCount, maxResultsReached) {
			var count = Math.max(parseInt(totalCount, 10) || 0, 0);
			if (sampleText) {
				var text = String(sampleText);
				if (maxResultsReached && /first|f\u00f8rste|premier|prim/i.test(text)) {
					return text.replace(/\d[\d,]*/, String(count));
				}
				if (count === 1) {
					text = text.replace(/\d[\d,]*/, "1");
					return text.replace(/ items(\.|$)/i, " item$1");
				}
				text = text.replace(/\d[\d,]*/, String(count));
				return text.replace(/ item(\.|$)/i, " items$1");
			}
			if (maxResultsReached) {
				return string.substitute("The search returned the first ${0} items that were found.", [ count ]);
			}
			if (count === 1) {
				return "The search returned 1 item.";
			}
			return string.substitute("The search returned ${0} items.", [ count ]);
		},

		_publishCombinedSearchStatusMessage: function(resultSet, sampleText) {
			var desktop = ecm.model.desktop;
			if (!desktop || typeof desktop.addMessage !== "function") {
				return;
			}
			var count = this._getCombinedSearchResultCount(resultSet);
			var text = this._formatCombinedSearchStatusMessage(sampleText, count,
				!!(resultSet && resultSet.maxResultsReached));
			console.log(LOG, "Publishing combined search footer status", { count: count, text: text });
			desktop.addMessage(new Message({
				number: 0,
				level: 0,
				text: text
			}));
		},

		_attachAdvancedRefreshHandler: function(resultSet, state) {
			if (!resultSet) {
