_installAdvancedSearchRestoreHooks: function(tab, state, tabKey) {
			var def = tab.searchDefinition;
			if (!def || def._metlifeAdvancedRestoreHook) {
				return;
			}
			def._metlifeAdvancedRestoreHook = true;
			def._metlifeAdvancedTabKey = tabKey;
			var self = this;
			var restoreSavedControls = function() {
				if (self._isNewSearchTemplate(def)) {
					return;
				}
				if (state.userControlsActive) {
					return;
				}
				// At this point moreOptions / application are populated by OOTB
				// _applyRetrievedSearchCriteria (onLoad). Re-read the persisted type
				// which may have been unavailable during _injectAdvancedControls.
				var savedType = self._getSavedSearchType(def.searchTemplate);
				if (state.controlsRestored) {
					// Slice already restored earlier; just re-apply the search-type
					// radios + OOTB object-type from the now-loaded template metadata.
					self._restoreSavedSearchTypeControls(tabKey, savedType);
					return;
				}
				var matchedSlice = self._findSliceMatchingSearchInFolder(def.searchTemplate, def);
				if (!matchedSlice) {
					self._restoreSavedSearchTypeControls(tabKey, savedType);
					if (def._loaded) {
						state._savedTemplateRestoreAttempted = true;
						state.controlsRestored = true;
					}
					return;
				}
				state._savedTemplateRestoreAttempted = true;
				state.controlsRestored = false;
				self._applyInitialAdvancedControls(tabKey, {
					initialRestore: true,
					templateChanged: true
				});
			};
			if (def.onLoad) {
				aspect.after(def, "onLoad", function() {
					restoreSavedControls();
				});
			}
			// Criteria may already be loaded before our hook is installed.
			if (!this._isNewSearchTemplate(def) && def._loaded) {
				setTimeout(function() {
					restoreSavedControls();
				}, 0);
			}
			aspect.after(def, "onSearchSaved", function(savedTemplate) {
				if (savedTemplate) {
					state.restoredTemplateId = self._getTemplateIdentity(savedTemplate);
					// Keep MetLife search type on the saved template object returned by OOTB.
					if (state.controlsWidget) {
						var searchType = state.controlsWidget.getSearchType();
						savedTemplate._metlifeAdvancedSearchType = searchType;
						if (!savedTemplate.moreOptions) {
							savedTemplate.moreOptions = {};
						}
						savedTemplate.moreOptions.metlifeSearchType = searchType;
					}
				}
				state.controlsRestored = true;
				self._persistAdvancedState(state);
				return savedTemplate;
			});
		}
