	/** JSON payload key for {@link #REPORT_REQUEST_PROPERTY_SEND_EMAILS}. */
	public static final String JSON_SEND_EMAILS = "sendEmails";
	/** JSON payload key for {@link #REPORT_REQUEST_PROPERTY_SEND_EMAIL_TO}. */
	public static final String JSON_SEND_EMAIL_TO = "sendEmailTo";
	/** JSON payload key for {@link #REPORT_REQUEST_PROPERTY_SEND_EMAIL_CC}. */
	public static final String JSON_SEND_EMAIL_CC = "sendEmailCC";
	public static final String REPORT_REQUEST_PROPERTY_SEARCH_CRITERIA_PARAMS = "SearchCriteriaParams";
	public static final String REPORT_REQUEST_PROPERTY_RESULT_SET_COLUMNS = "ResultSetColumns";
	public static final String REPORT_REQUEST_PROPERTY_SQL_QUERY = "SQLQuery";

	public static final String REPORT_REQUEST_PROPERTY_LAST_EXECUTION_DATE = "LastExecutionDate";
	public static final String REPORT_REQUEST_PROPERTY_REPORT_EXECUTION_START_DATE = "ReportExecutionStartDate";
	public static final String REPORT_REQUEST_PROPERTY_REPORT_EXECUTION_END_DATE = "ReportExecutionEndDate";

	/** System property used for list sort order ({@code ORDER BY DateCreated DESC}). */
	public static final String REPORT_REQUEST_PROPERTY_DATE_CREATED = "DateCreated";

	/** System property: document creator (short name). Used to scope the dashboard list to the signed-in user. */
	public static final String REPORT_REQUEST_PROPERTY_CREATOR = "Creator";

	/**
	 * Plugin configuration JSON key: comma-separated short names of report-module admin users who may see all
	 * requests. Example: {@code {"adminUsers":"jsmith,admin,reportadmin"}}.
	 */
	public static final String CONFIG_KEY_ADMIN_USERS = "adminUsers";

	/** Display format for date/time columns in {@code JSONResultSetResponse} grids. */
	public static final String RESULT_SET_DATETIME_DISPLAY_PATTERN = "MM/dd/yyyy hh:mm";

	/**
	 * SELECT list for report-request dashboard / my-requests queries. Append {@code WHERE}/{@code ORDER BY} via
	 * {@link com.cnb.reports.config.ReportPluginConfigUtil#buildReportRequestListSql(boolean, String)}.
	 * {@code [This]} and {@code MimeType} are required so search rows carry enough state for privilege masks and
	 * ContentList (avoids FNRCA0024E when only a narrow projection was returned).
	 */
	public static final String REPORT_REQUEST_LIST_SELECT = "SELECT [This], Id, DocumentTitle, "
			+ REPORT_REQUEST_PROPERTY_TARGET_DOCUMENT_CLASS + ", "
			+ REPORT_REQUEST_PROPERTY_REPOSITORY_NAME + ", " + REPORT_REQUEST_PROPERTY_STATUS + ", "
			+ REPORT_REQUEST_PROPERTY_DATE_CREATED + ", " + REPORT_REQUEST_PROPERTY_LAST_EXECUTION_DATE + ", "
			+ REPORT_REQUEST_PROPERTY_REPORT_EXECUTION_START_DATE + ", "
