package com.cnb.updater.config;

import com.filenet.api.constants.RefreshMode;

public enum UpdateRefreshMode {
    REFRESH(RefreshMode.REFRESH),
    NO_REFRESH(RefreshMode.NO_REFRESH);

    private final RefreshMode refreshMode;

    UpdateRefreshMode(RefreshMode refreshMode) {
        this.refreshMode = refreshMode;
    }

    public RefreshMode toRefreshMode() {
        return refreshMode;
    }

    public static UpdateRefreshMode fromConfig(String value) {
        if (value == null) {
            throw new IllegalArgumentException("update.refreshMode is required.");
        }
        try {
            return UpdateRefreshMode.valueOf(value.trim().toUpperCase());
        } catch (IllegalArgumentException ex) {
            throw new IllegalArgumentException("Unsupported update.refreshMode: " + value
                    + ". Supported values: REFRESH, NO_REFRESH");
        }
    }
}
