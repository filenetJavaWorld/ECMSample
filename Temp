/**
 * Updates an existing system property in the openItem response.
 *
 * Important:
 * For date properties, the raw ISO value is placed in "values".
 * We do not use ZoneId.systemDefault(), because that uses the
 * application-server timezone and causes the four-hour difference.
 */
private void setSystemPropertyValue(
        JSONArray systemProperties,
        String systemPropertyName,
        Object newValue,
        boolean isDate) {

    if (systemProperties == null
            || systemPropertyName == null
            || newValue == null) {
        return;
    }

    for (Object obj : systemProperties) {

        if (!(obj instanceof JSONObject)) {
            continue;
        }

        JSONObject property = (JSONObject) obj;
        String name = getStringValue(property, "name");

        if (systemPropertyName.equalsIgnoreCase(name)) {

            /*
             * Set the raw custom-property value.
             *
             * Do not change the UTC value.
             */
            property.put("values", newValue);

            if (isDate) {
                /*
                 * Remove the server-generated displayValue.
                 *
                 * This allows ICN to render the raw date according to the
                 * user's browser/desktop timezone instead of the JVM timezone.
                 */
                property.remove("displayValue");
            } else {
                /*
                 * Creator/Added By is a string, so no date formatting
                 * is required.
                 */
                property.put("displayValue", newValue);
            }

            /*
             * Remove the original Creator user-information object because
             * it belongs to the previous system-property value.
             */
            if (property.containsKey("userInfo")) {
                property.remove("userInfo");
            }

            System.out.println(
                    "Updated system property [" +
                    systemPropertyName +
                    "] with raw value: " +
                    newValue
            );

            return;
        }
    }

    System.out.println(
            "System property not found: " +
            systemPropertyName
    );
}

