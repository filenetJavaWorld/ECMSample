define([
	"dojo/_base/declare",
	"dojo/_base/lang",
	"ecm/model/Action",
	"cNBReportsPluginDojo/ReportRequestItemUtil"
], function(declare, lang, Action, ReportRequestItemUtil) {

	function resolveItemStatus(item) {
		if (!item) {
			return "";
		}
		var status = null;
		if (lang.isFunction(item.getValue)) {
			status = item.getValue("Status");
		}
		if ((status == null || status === "") && item.attributes) {
			status = item.attributes.Status;
		}
		if ((status == null || status === "") && lang.isFunction(item.getDisplayValue)) {
			status = item.getDisplayValue("Status");
		}
		return status != null ? String(status).trim() : "";
	}

	function isPendingStatus(status) {
		return status != null && String(status).toLowerCase() === "pending";
	}

	/**
	 * Enables Hold Request only for a single Pending ReportRequest.
	 */
	return declare("cNBReportsPluginDojo.HoldReportRequestAction", [
		Action
	], {
		isVisible: function(repository, items, repositoryTypes, teamspace) {
			if (!this.inherited(arguments)) {
				return false;
			}
			if (!items || !items.length) {
				return true;
			}
			return ReportRequestItemUtil.areAllReportRequestItems(items);
		},

		isEnabled: function(repository, listType, items, teamspace, resultSet) {
			var enabled = this.inherited(arguments);
			if (!enabled) {
				return false;
			}
			if (!items || items.length !== 1 || !items[0]) {
				return false;
			}
			if (!ReportRequestItemUtil.isReportRequestItem(items[0])) {
				return false;
			}
			return isPendingStatus(resolveItemStatus(items[0]));
		}
	});
});
