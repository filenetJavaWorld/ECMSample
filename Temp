		_applyOotbFolderSearchTemplateFields: function(searchTemplate, def) {
			if (!searchTemplate) {
				return searchTemplate;
			}
			searchTemplate.objectType = "folder";
			searchTemplate.includeSubclasses = true;
			searchTemplate.pageSize = -1;
			searchTemplate.textSearchType = (def && def.repository && def.repository.textSearchType) || "";
			searchTemplate.textSearchCriteria = this._getOotbFolderTextSearchCriteria();
			searchTemplate.resultsDisplay = this._getOotbFolderResultsDisplay();
			if (!searchTemplate.moreOptions) {
				searchTemplate.moreOptions = {};
			}
			searchTemplate.moreOptions.objectType = "folder";
			if (!searchTemplate.moreOptions.macros) {
				searchTemplate.moreOptions.macros = { fileTypes: [] };
			}
			if (def && def._folders && def._folders.length) {
				searchTemplate.folders = def._folders.slice();
			} else if (def && def.searchTemplate && def.searchTemplate.folders) {
				searchTemplate.folders = def.searchTemplate.folders.slice();
			}
			return searchTemplate;
		},
		
