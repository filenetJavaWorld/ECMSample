import org.apache.commons.lang3.StringUtils;
import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ExecutionException;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.Future;
import java.util.concurrent.atomic.AtomicInteger;

public final class DocumentUpdateService {

    private static final Logger LOGGER = LogManager.getLogger(DocumentUpdateService.class);

    private final AppConfig config;

    public DocumentUpdateService(FileNetConnectionManager connectionManager) {
        this.config = connectionManager.getConfig();
    }

    public UpdateResultRecord processUpdates(List<SearchResultRecord> records) {
        int totalRows = records.size();
        AtomicInteger eligibleRows = new AtomicInteger();
        AtomicInteger updatedRows = new AtomicInteger();
        AtomicInteger skippedRows = new AtomicInteger();
        AtomicInteger failedRows = new AtomicInteger();
        AtomicInteger ignoredRows = new AtomicInteger();
        AtomicInteger processedRows = new AtomicInteger();

        List<SearchResultRecord> eligibleRecords = new ArrayList<>();
        for (SearchResultRecord record : records) {
            if (!SearchResultRecord.STATUS_DOES_NOT_EXIST.equals(record.getStatus())) {
                ignoredRows.incrementAndGet();
                continue;
            }
            eligibleRows.incrementAndGet();
            eligibleRecords.add(record);
        }

        if (eligibleRecords.isEmpty()) {
            return new UpdateResultRecord(
                    totalRows,
                    eligibleRows.get(),
                    updatedRows.get(),
                    skippedRows.get(),
                    failedRows.get(),
                    ignoredRows.get()
            );
        }

        int threadPoolSize = Math.min(config.getUpdateThreadPoolSize(), eligibleRecords.size());
        List<List<SearchResultRecord>> workerPartitions =
                ProcessingUtil.partitionEvenly(eligibleRecords, threadPoolSize);

        LOGGER.info("Starting parallel update for {} eligible row(s) using {} worker(s). "
                        + "resolveCurrentVersion={}, recheckCisBeforeUpdate={}, refreshMode={}",
                eligibleRecords.size(),
                threadPoolSize,
                config.isUpdateResolveCurrentVersion(),
                config.isUpdateRecheckCisBeforeUpdate(),
                config.getUpdateRefreshMode());

        ExecutorService executorService = Executors.newFixedThreadPool(threadPoolSize);
        try {
            List<Future<?>> futures = new ArrayList<>();
            for (int workerIndex = 0; workerIndex < workerPartitions.size(); workerIndex++) {
                final List<SearchResultRecord> workerRecords = workerPartitions.get(workerIndex);
                if (workerRecords.isEmpty()) {
                    continue;
                }
                final int currentWorkerNumber = workerIndex + 1;
                futures.add(executorService.submit(() -> runUpdateWorker(
                        currentWorkerNumber,
                        workerRecords,
                        eligibleRecords.size(),
                        updatedRows,
                        skippedRows,
                        failedRows,
                        processedRows
                )));
            }

            for (Future<?> future : futures) {
                try {
                    future.get();
                } catch (ExecutionException ex) {
                    Throwable cause = ex.getCause();
                    if (cause instanceof RuntimeException) {
                        throw (RuntimeException) cause;
                    }
                    throw new RuntimeException(cause == null ? ex : cause);
                }
            }
        } finally {
            ProcessingUtil.shutdownExecutor(executorService);
        }

        return new UpdateResultRecord(
                totalRows,
                eligibleRows.get(),
                updatedRows.get(),
                skippedRows.get(),
                failedRows.get(),
                ignoredRows.get()
        );
    }

    private void runUpdateWorker(int workerNumber,
                                 List<SearchResultRecord> workerRecords,
                                 int totalEligibleRows,
                                 AtomicInteger updatedRows,
                                 AtomicInteger skippedRows,
                                 AtomicInteger failedRows,
                                 AtomicInteger processedRows) {
        PropertyDefinition targetProperty = config.getTargetCis().getPropertyDefinition();
        UpdateWorkerContext workerContext = new UpdateWorkerContext(targetProperty, config.getUpdateRefreshMode());

        try (FileNetConnectionManager workerConnection = new FileNetConnectionManager(config)) {
            ObjectStore objectStore = workerConnection.getObjectStore();
            LOGGER.info("Update worker {} started with {} assigned row(s)", workerNumber, workerRecords.size());

            for (SearchResultRecord record : workerRecords) {
                processSingleUpdate(objectStore, workerContext, record, updatedRows, skippedRows, failedRows);

                int completed = processedRows.incrementAndGet();
                if (completed % config.getUpdateProgressLogInterval() == 0
                        || completed == totalEligibleRows) {
                    LOGGER.info("Update progress: processed {}/{} eligible row(s). updated={}, skipped={}, failed={}",
                            completed,
                            totalEligibleRows,
                            updatedRows.get(),
                            skippedRows.get(),
                            failedRows.get());
                }
            }

            LOGGER.info("Update worker {} completed {} row(s)", workerNumber, workerRecords.size());
        } catch (Exception ex) {
            throw new RuntimeException("Update worker " + workerNumber + " failed: " + ex.getMessage(), ex);
        }
    }

    private void processSingleUpdate(ObjectStore objectStore,
                                     UpdateWorkerContext workerContext,
                                     SearchResultRecord record,
                                     AtomicInteger updatedRows,
                                     AtomicInteger skippedRows,
                                     AtomicInteger failedRows) {
        if (StringUtils.isBlank(record.getDocumentGuid())) {
            record.setUpdateStatus(UpdateResultRecord.UPDATE_STATUS_FAILED);
            record.appendComment("Document GUID is missing");
            failedRows.incrementAndGet();
            return;
        }

        try {
            UpdateOutcome outcome = updateDocument(objectStore, workerContext, record);
            record.setUpdateStatus(outcome.getUpdateStatus());

            if (UpdateResultRecord.UPDATE_STATUS_UPDATED.equals(outcome.getUpdateStatus())) {
                updatedRows.incrementAndGet();
                LOGGER.debug("Updated CIS Number for document GUID {}", record.getDocumentGuid());
            } else if (UpdateResultRecord.UPDATE_STATUS_SKIPPED.equals(outcome.getUpdateStatus())) {
                skippedRows.incrementAndGet();
                record.setComments(SearchResultRecord.COMMENT_SKIPPED_DURING_UPDATE);
                LOGGER.debug("Skipped update for document GUID {} because CIS Number already exists",
                        record.getDocumentGuid());
            }
        } catch (Exception ex) {
            record.setUpdateStatus(UpdateResultRecord.UPDATE_STATUS_FAILED);
            record.appendComment(ex.getMessage());
            failedRows.incrementAndGet();
            LOGGER.error("Failed to update document GUID {}: {}", record.getDocumentGuid(), ex.getMessage(), ex);
        }
    }

    private UpdateOutcome updateDocument(ObjectStore objectStore,
                                         UpdateWorkerContext workerContext,
                                         SearchResultRecord record) throws Exception {
        PropertyDefinition targetProperty = workerContext.getTargetProperty();
        String cisPropertyName = targetProperty.getSymbolicName();

        Document document = fetchDocumentForUpdate(objectStore, workerContext, record.getDocumentGuid());
        Properties properties = document.getProperties();

        if (config.isUpdateRecheckCisBeforeUpdate()
                && FileNetPropertyHelper.hasAnyCisValue(properties, targetProperty)) {
            return new UpdateOutcome(UpdateResultRecord.UPDATE_STATUS_SKIPPED);
        }

        if (StringUtils.isBlank(record.getCisNumber())) {
            throw new IllegalStateException("CSV CIS Number value is blank");
        }

        FileNetPropertyHelper.setMultiValueCis(properties, cisPropertyName, record.getCisNumber());
        document.save(workerContext.getRefreshMode());
        return new UpdateOutcome(UpdateResultRecord.UPDATE_STATUS_UPDATED);
    }

    private Document fetchDocumentForUpdate(ObjectStore objectStore,
                                            UpdateWorkerContext workerContext,
                                            String documentGuid) {
        if (!config.isUpdateResolveCurrentVersion()) {
            return Factory.Document.fetchInstance(
                    objectStore,
                    new Id(documentGuid),
                    workerContext.getDocumentPropertyFilter()
            );
        }

        Document document = Factory.Document.fetchInstance(
                objectStore,
                new Id(documentGuid),
                workerContext.getVersionSeriesPropertyFilter()
        );
        VersionSeries versionSeries = document.get_VersionSeries();
        if (versionSeries != null) {
            Object currentVersion = versionSeries.get_CurrentVersion();
            if (currentVersion instanceof Document) {
                Document currentDocument = (Document) currentVersion;
                if (!documentGuid.equals(currentDocument.get_Id().toString())) {
                    return Factory.Document.fetchInstance(
                            objectStore,
                            currentDocument.get_Id(),
                            workerContext.getDocumentPropertyFilter()
                    );
                }
            }
        }
        return document;
    }

    private static final class UpdateWorkerContext {
        private final PropertyDefinition targetProperty;
        private final RefreshMode refreshMode;
        private final PropertyFilter documentPropertyFilter;
        private final PropertyFilter versionSeriesPropertyFilter;

        private UpdateWorkerContext(PropertyDefinition targetProperty, UpdateRefreshMode updateRefreshMode) {
            this.targetProperty = targetProperty;
            this.refreshMode = updateRefreshMode.toRefreshMode();
            this.documentPropertyFilter = createDocumentPropertyFilter(targetProperty);
            this.versionSeriesPropertyFilter = createVersionSeriesPropertyFilter(targetProperty);
        }

        private PropertyDefinition getTargetProperty() {
            return targetProperty;
        }

        private RefreshMode getRefreshMode() {
            return refreshMode;
        }

        private PropertyFilter getDocumentPropertyFilter() {
            return documentPropertyFilter;
        }

        private PropertyFilter getVersionSeriesPropertyFilter() {
            return versionSeriesPropertyFilter;
        }

        private static PropertyFilter createDocumentPropertyFilter(PropertyDefinition targetProperty) {
            PropertyFilter filter = new PropertyFilter();
            filter.addIncludeProperty(0, null, null, PropertyNames.ID, null);
            filter.addIncludeProperty(0, null, null, targetProperty.getSymbolicName(), null);
            return filter;
        }

        private static PropertyFilter createVersionSeriesPropertyFilter(PropertyDefinition targetProperty) {
            PropertyFilter filter = createDocumentPropertyFilter(targetProperty);
            filter.addIncludeProperty(0, null, null, PropertyNames.VERSION_SERIES, null);
            return filter;
        }
    }

    private static final class UpdateOutcome {
        private final String updateStatus;

        private UpdateOutcome(String updateStatus) {
            this.updateStatus = updateStatus;
        }

        private String getUpdateStatus() {
            return updateStatus;
        }
    }
}




package com.cnb.updater.util;

import java.util.ArrayList;
import java.util.Collections;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.TimeUnit;

public final class ProcessingUtil {

    private ProcessingUtil() {
    }

    public static <T> List<List<T>> partition(List<T> items, int batchSize) {
        if (items == null || items.isEmpty()) {
            return Collections.emptyList();
        }
        if (batchSize < 1) {
            throw new IllegalArgumentException("Batch size must be at least 1.");
        }

        List<List<T>> batches = new ArrayList<>();
        for (int index = 0; index < items.size(); index += batchSize) {
            int end = Math.min(index + batchSize, items.size());
            batches.add(new ArrayList<>(items.subList(index, end)));
        }
        return batches;
    }

    public static List<String> distinctAccountNumbers(List<String> accountNumbers) {
        Set<String> uniqueAccountNumbers = new LinkedHashSet<>();
        if (accountNumbers != null) {
            for (String accountNumber : accountNumbers) {
                if (accountNumber != null && !accountNumber.trim().isEmpty()) {
                    uniqueAccountNumbers.add(accountNumber.trim());
                }
            }
        }
        return new ArrayList<>(uniqueAccountNumbers);
    }

    public static <T> List<List<T>> partitionEvenly(List<T> items, int partitionCount) {
        if (items == null || items.isEmpty()) {
            return Collections.emptyList();
        }
        if (partitionCount < 1) {
            throw new IllegalArgumentException("Partition count must be at least 1.");
        }

        List<List<T>> partitions = new ArrayList<>();
        for (int index = 0; index < partitionCount; index++) {
            partitions.add(new ArrayList<>());
        }

        for (int index = 0; index < items.size(); index++) {
            partitions.get(index % partitionCount).add(items.get(index));
        }
        return partitions;
    }

    public static void shutdownExecutor(ExecutorService executorService) {
        executorService.shutdown();
        try {
            if (!executorService.awaitTermination(1, TimeUnit.HOURS)) {
                executorService.shutdownNow();
            }
        } catch (InterruptedException ex) {
            executorService.shutdownNow();
            Thread.currentThread().interrupt();
        }
    }
}




package com.cnb.updater.util;

import com.cnb.updater.config.AppConfig;
import com.cnb.updater.config.PropertyDefinition;
import org.apache.commons.lang3.StringUtils;

import java.io.File;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

public final class ValidationUtil {

    private ValidationUtil() {
    }

    public static void validateForSearchUtility(AppConfig config) {
        validateCommonConfig(config);
        validateReadableFile(config.getInputExcel(), "input.excel");
        validateWritableParent(config.getOutputSearchCsv(), "output.searchCsv");
    }

    public static void validateForUpdateUtility(AppConfig config) {
        validateCommonConfig(config);
        validateReadableFile(config.getOutputSearchCsv(), "output.searchCsv");
        validateWritableParent(config.getOutputUpdatedCsv(), "output.updatedCsv");
    }

    private static void validateCommonConfig(AppConfig config) {
        if (config.getDocumentClasses().isEmpty()) {
            throw new IllegalArgumentException("At least one document class must be configured.");
        }
        if (config.getSearchCriteria().isEmpty()) {
            throw new IllegalArgumentException("At least one search criterion must be configured.");
        }
        for (PropertyDefinition criterion : config.getSearchCriteria()) {
            if (StringUtils.isBlank(criterion.getSymbolicName())) {
                throw new IllegalArgumentException("Search criterion symbolicName must be configured.");
            }
        }
        if (config.getTargetCis() == null
                || config.getTargetCis().getPropertyDefinition() == null
                || StringUtils.isBlank(config.getTargetCis().getPropertyDefinition().getSymbolicName())) {
            throw new IllegalArgumentException("target.cis.symbolicName must be configured.");
        }
        validatePositiveInt(config.getSearchBatchSize(), "search.batchSize");
        validatePositiveInt(config.getSearchAccountBatchSize(), "search.accountBatchSize");
        validatePositiveInt(config.getSearchThreadPoolSize(), "processing.searchThreadPoolSize");
        validatePositiveInt(config.getUpdateThreadPoolSize(), "processing.updateThreadPoolSize");
        validatePositiveInt(config.getUpdateProgressLogInterval(), "processing.updateProgressLogInterval");
    }

    private static void validatePositiveInt(int value, String propertyName) {
        if (value < 1) {
            throw new IllegalArgumentException(propertyName + " must be at least 1.");
        }
    }

    private static void validateReadableFile(String filePath, String propertyName) {
        Path path = Paths.get(filePath);
        if (!Files.isRegularFile(path)) {
            throw new IllegalArgumentException("Configured file does not exist or is not readable: "
                    + propertyName + "=" + filePath);
        }
    }

    private static void validateWritableParent(String filePath, String propertyName) {
        File file = new File(filePath);
        File parent = file.getParentFile();
        if (parent != null && !parent.exists() && !parent.mkdirs()) {
            throw new IllegalArgumentException("Unable to create output directory for "
                    + propertyName + "=" + filePath);
        }
        if (parent != null && !parent.canWrite()) {
            throw new IllegalArgumentException("Output directory is not writable for "
                    + propertyName + "=" + filePath);
        }
    }
}





package com.cnb.updater.util;

import com.cnb.updater.config.AppConfig;
import com.cnb.updater.config.CisExistenceCheck;
import com.cnb.updater.config.ExcelColumnConfig;
import com.cnb.updater.config.PropertyCardinality;
import com.cnb.updater.config.PropertyDataType;
import com.cnb.updater.config.PropertyDefinition;
import com.cnb.updater.config.UpdateRefreshMode;
import org.apache.commons.lang3.StringUtils;

import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Properties;
import java.util.stream.Collectors;

public final class PropertyLoader {

    public static final String CONFIG_FILE_SYSTEM_PROPERTY = "config.file";
    public static final String DEFAULT_CONFIG_FILE = "config/CISNumberUpdateUtility.properties";

    private PropertyLoader() {
    }

    public static String resolveConfigPath(String[] args) {
        String configFromSystemProperty = System.getProperty(CONFIG_FILE_SYSTEM_PROPERTY);
        if (StringUtils.isNotBlank(configFromSystemProperty)) {
            return configFromSystemProperty.trim();
        }
        if (args != null && args.length > 0 && StringUtils.isNotBlank(args[0])) {
            return args[0].trim();
        }
        return DEFAULT_CONFIG_FILE;
    }

    public static AppConfig load() throws IOException {
        return load(DEFAULT_CONFIG_FILE);
    }

    public static AppConfig load(String configFilePath) throws IOException {
        Properties props = new Properties();
        try (InputStream input = new FileInputStream(configFilePath)) {
            props.load(input);
        }

        String logPath = props.getProperty("log.path", "logs/cis-update.log");
        System.setProperty("log.path", logPath);

        List<String> documentClasses = resolveDocumentClasses(props);
        List<PropertyDefinition> searchCriteria = loadSearchCriteria(props);
        TargetCisConfig targetCis = loadTargetCisConfig(props);

        return new AppConfig(
                trimTrailingSlash(require(props, "filenet.uri")),
                require(props, "filenet.username"),
                require(props, "filenet.password"),
                require(props, "filenet.objectStore"),
                documentClasses,
                searchCriteria,
                targetCis,
                require(props, "input.excel"),
                loadExcelColumnConfig(props),
                require(props, "output.searchCsv"),
                require(props, "output.updatedCsv"),
                logPath,
                parseRequiredInt(props, "search.batchSize"),
                parseRequiredInt(props, "search.accountBatchSize"),
                parseRequiredInt(props, "processing.searchThreadPoolSize"),
                parseRequiredInt(props, "processing.updateThreadPoolSize"),
                parseRequiredInt(props, "processing.updateProgressLogInterval"),
                parseRequiredBoolean(props, "update.resolveCurrentVersion"),
                parseRequiredBoolean(props, "update.recheckCisBeforeUpdate"),
                UpdateRefreshMode.fromConfig(require(props, "update.refreshMode"))
        );
    }

    private static List<PropertyDefinition> loadSearchCriteria(Properties props) {
        int count = parseInt(props, "search.criteria.count", -1);
        if (count < 1) {
            throw new IllegalArgumentException("search.criteria.count must be at least 1.");
        }

        List<PropertyDefinition> criteria = new ArrayList<>();
        for (int index = 1; index <= count; index++) {
            String prefix = "search.criteria." + index;
            criteria.add(loadPropertyDefinition(props, prefix));
        }
        return criteria;
    }

    private static TargetCisConfig loadTargetCisConfig(Properties props) {
        PropertyDefinition propertyDefinition = loadPropertyDefinition(props, "target.cis");
        CisExistenceCheck existenceCheck = CisExistenceCheck.fromConfig(
                require(props, "target.cis.existenceCheck"));
        return new TargetCisConfig(propertyDefinition, existenceCheck);
    }

    private static ExcelColumnConfig loadExcelColumnConfig(Properties props) {
        return new ExcelColumnConfig(
                props.getProperty("input.excel.column.accountNumber", "ACCOUNT_NUMBER").trim(),
                props.getProperty("input.excel.column.accountName", "ACCOUNT_NAME").trim(),
                props.getProperty("input.excel.column.cis", "CIS").trim(),
                props.getProperty("input.excel.column.cisName", "CIS_NAME").trim()
        );
    }

    private static PropertyDefinition loadPropertyDefinition(Properties props, String prefix) {
        return new PropertyDefinition(
                require(props, prefix + ".symbolicName"),
                PropertyDataType.fromConfig(require(props, prefix + ".dataType")),
                PropertyCardinality.fromConfig(require(props, prefix + ".cardinality"))
        );
    }

    private static List<String> resolveDocumentClasses(Properties props) {
        String classes = props.getProperty("document.classes");
        if (StringUtils.isNotBlank(classes)) {
            return Arrays.stream(classes.split(","))
                    .map(String::trim)
                    .filter(StringUtils::isNotBlank)
                    .collect(Collectors.toList());
        }

        String singleClass = props.getProperty("document.className");
        if (StringUtils.isBlank(singleClass)) {
            throw new IllegalArgumentException("Missing required property: document.className or document.classes");
        }

        List<String> result = new ArrayList<>();
        result.add(singleClass.trim());
        return result;
    }

    private static String require(Properties props, String key) {
        String value = props.getProperty(key);
        if (StringUtils.isBlank(value)) {
            throw new IllegalArgumentException("Missing required property: " + key);
        }
        return value.trim();
    }

    private static int parseInt(Properties props, String key, int defaultValue) {
        String value = props.getProperty(key);
        if (StringUtils.isBlank(value)) {
            return defaultValue;
        }
        return Integer.parseInt(value.trim());
    }

    private static int parseRequiredInt(Properties props, String key) {
        String value = require(props, key);
        return Integer.parseInt(value);
    }

    private static boolean parseRequiredBoolean(Properties props, String key) {
        String value = require(props, key);
        if ("true".equalsIgnoreCase(value)) {
            return true;
        }
        if ("false".equalsIgnoreCase(value)) {
            return false;
        }
        throw new IllegalArgumentException("Property " + key + " must be true or false.");
    }

    private static String trimTrailingSlash(String uri) {
        if (uri.endsWith("/")) {
            return uri.substring(0, uri.length() - 1);
        }
        return uri;
    }
}





package com.cnb.updater.config;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public final class AppConfig {

    private final String fileNetUri;
    private final String fileNetUsername;
    private final String fileNetPassword;
    private final String fileNetObjectStore;
    private final List<String> documentClasses;
    private final List<PropertyDefinition> searchCriteria;
    private final TargetCisConfig targetCis;
    private final String inputExcel;
    private final ExcelColumnConfig excelColumns;
    private final String outputSearchCsv;
    private final String outputUpdatedCsv;
    private final String logPath;
    private final int searchBatchSize;
    private final int searchAccountBatchSize;
    private final int searchThreadPoolSize;
    private final int updateThreadPoolSize;
    private final int updateProgressLogInterval;
    private final boolean updateResolveCurrentVersion;
    private final boolean updateRecheckCisBeforeUpdate;
    private final UpdateRefreshMode updateRefreshMode;

    public AppConfig(String fileNetUri,
                     String fileNetUsername,
                     String fileNetPassword,
                     String fileNetObjectStore,
                     List<String> documentClasses,
                     List<PropertyDefinition> searchCriteria,
                     TargetCisConfig targetCis,
                     String inputExcel,
                     ExcelColumnConfig excelColumns,
                     String outputSearchCsv,
                     String outputUpdatedCsv,
                     String logPath,
                     int searchBatchSize,
                     int searchAccountBatchSize,
                     int searchThreadPoolSize,
                     int updateThreadPoolSize,
                     int updateProgressLogInterval,
                     boolean updateResolveCurrentVersion,
                     boolean updateRecheckCisBeforeUpdate,
                     UpdateRefreshMode updateRefreshMode) {
        this.fileNetUri = fileNetUri;
        this.fileNetUsername = fileNetUsername;
        this.fileNetPassword = fileNetPassword;
        this.fileNetObjectStore = fileNetObjectStore;
        this.documentClasses = Collections.unmodifiableList(new ArrayList<>(documentClasses));
        this.searchCriteria = Collections.unmodifiableList(new ArrayList<>(searchCriteria));
        this.targetCis = targetCis;
        this.inputExcel = inputExcel;
        this.excelColumns = excelColumns;
        this.outputSearchCsv = outputSearchCsv;
        this.outputUpdatedCsv = outputUpdatedCsv;
        this.logPath = logPath;
        this.searchBatchSize = searchBatchSize;
        this.searchAccountBatchSize = searchAccountBatchSize;
        this.searchThreadPoolSize = searchThreadPoolSize;
        this.updateThreadPoolSize = updateThreadPoolSize;
