package com.cnb.repo.export.service;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.Iterator;
import java.util.List;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.cnb.repo.export.p8.P8ContextUtil;
import com.filenet.api.admin.ChoiceList;
import com.filenet.api.collection.ChoiceListSet;
import com.filenet.api.constants.PropertyNames;
import com.filenet.api.core.ObjectStore;
import com.ibm.ecm.extension.PluginResponseUtil;
import com.ibm.ecm.extension.PluginService;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.ecm.json.JSONResponse;
import com.ibm.json.java.JSONArray;
import com.ibm.json.java.JSONObject;

/**
 * Phase 1 support service: lists choice lists for the Choice List Export tab UI.
 * Does not generate Excel workbooks.
 */
public class ListChoiceListsService extends PluginService {

	public static final String SERVICE_ID = "listChoiceLists";

	@Override
	public String getId() {
		return SERVICE_ID;
	}

	@Override
	public void execute(final PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		final String method = "execute";
		callbacks.getLogger().logEntry(this, method, request);
		try {
			String repositoryId = trim(request.getParameter("repositoryId"));
			if (repositoryId == null) {
				writeFailure(response, request, callbacks, "Please select an object store.");
				return;
			}

			JSONArray choiceLists;
			try {
				choiceLists = P8ContextUtil.runWithP8Context(callbacks, repositoryId,
						new P8ContextUtil.P8Callback<JSONArray>() {
							public JSONArray run(ObjectStore objectStore) throws Exception {
								return loadChoiceLists(objectStore);
							}
						});
			} catch (Exception e) {
				callbacks.getLogger().logError(this, method, request, e);
				writeFailure(response, request, callbacks, "Unable to retrieve choice-list metadata.");
				return;
			}

			JSONResponse ok = new JSONResponse();
			ok.put("success", Boolean.TRUE);
			ok.put("choiceLists", choiceLists);
			PluginResponseUtil.writeJSONResponse(request, response, ok, callbacks, SERVICE_ID);
		} finally {
			callbacks.getLogger().logExit(this, method, request);
		}
	}

	private static JSONArray loadChoiceLists(ObjectStore objectStore) throws Exception {
		objectStore.fetchProperties(new String[] {
			PropertyNames.CHOICE_LISTS
		});
		ChoiceListSet set = objectStore.get_ChoiceLists();
		List<JSONObject> rows = new ArrayList<JSONObject>();
		if (set != null) {
			@SuppressWarnings("unchecked")
			Iterator<ChoiceList> it = set.iterator();
			while (it.hasNext()) {
				ChoiceList choiceList = it.next();
				if (choiceList == null) {
					continue;
				}
				choiceList.fetchProperties(new String[] {
					PropertyNames.ID,
					PropertyNames.DISPLAY_NAME,
					PropertyNames.NAME,
					PropertyNames.DATA_TYPE,
					PropertyNames.HAS_HIERARCHY
				});
				JSONObject row = new JSONObject();
				row.put("id", choiceList.get_Id() != null ? choiceList.get_Id().toString() : "");
				row.put("displayName", safe(choiceList.get_DisplayName()));
				row.put("symbolicName", safe(choiceList.get_Name()));
				row.put("dataType", choiceList.get_DataType() != null ? choiceList.get_DataType().toString() : "");
				row.put("hierarchical", Boolean.valueOf(choiceList.get_HasHierarchy()));
				rows.add(row);
			}
		}

		Collections.sort(rows, new Comparator<JSONObject>() {
			public int compare(JSONObject a, JSONObject b) {
				String left = safe((String) a.get("displayName"));
				String right = safe((String) b.get("displayName"));
				return left.compareToIgnoreCase(right);
			}
		});

		JSONArray array = new JSONArray();
		for (JSONObject row : rows) {
			array.add(row);
		}
		return array;
	}

	private static void writeFailure(HttpServletResponse response, HttpServletRequest request,
			PluginServiceCallbacks callbacks, String message) throws Exception {
		JSONResponse err = new JSONResponse();
		err.put("success", Boolean.FALSE);
		err.put("message", message);
		PluginResponseUtil.writeJSONResponse(request, response, err, callbacks, SERVICE_ID);
	}

	private static String trim(String s) {
		if (s == null) {
			return null;
		}
		s = s.trim();
		return s.length() == 0 ? null : s;
	}

	private static String safe(String value) {
		return value != null ? value : "";
	}
}
