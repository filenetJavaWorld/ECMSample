package com.cnb.repo.export.excel;

import java.io.ByteArrayOutputStream;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import com.cnb.repo.export.exception.MetadataExportException;
import com.cnb.repo.export.metadata.ChoiceListMetadataProvider;
import com.cnb.repo.export.metadata.DocumentClassMetadataProvider;
import com.cnb.repo.export.model.ChoiceListMetadata;
import com.cnb.repo.export.model.DocumentClassExportRequest;
import com.cnb.repo.export.model.PropertyMetadata;
import com.filenet.api.core.ObjectStore;

/**
 * Builds the Document Class Assets Export workbook.
 */
public class DocumentClassWorkbookGenerator {

	public byte[] generate(ObjectStore objectStore, DocumentClassExportRequest request)
			throws MetadataExportException {
		DocumentClassMetadataProvider classProvider = new DocumentClassMetadataProvider();
		ChoiceListMetadataProvider choiceProvider = new ChoiceListMetadataProvider();

		List<PropertyMetadata> properties = classProvider.loadProperties(objectStore,
				request.getDocumentClassSymbolicName(), request.getDocumentClassDisplayName(),
				request.isIncludeInheritedProperties());
		if (properties == null || properties.isEmpty()) {
			throw new MetadataExportException("No properties found for the selected class.");
		}

		Map<String, ChoiceListMetadata> uniqueChoiceLists = new LinkedHashMap<String, ChoiceListMetadata>();
		if (request.isExportChoiceListDetails()) {
			for (PropertyMetadata prop : properties) {
				if (prop.getChoiceListAssigned() != null && prop.getChoiceListAssigned().booleanValue()
						&& prop.getChoiceListId() != null && prop.getChoiceListId().length() > 0
						&& !uniqueChoiceLists.containsKey(prop.getChoiceListId())) {
					ChoiceListMetadata cl = choiceProvider.loadById(objectStore, prop.getChoiceListId(), true);
					uniqueChoiceLists.put(prop.getChoiceListId(), cl);
				}
			}
		}

		XSSFWorkbook workbook = null;
		try {
			workbook = new XSSFWorkbook();
			WorkbookStyleFactory styles = new WorkbookStyleFactory(workbook);
			WorksheetNameUtil nameUtil = new WorksheetNameUtil();

			// Reserve Document Properties first.
			nameUtil.uniqueName(DocumentPropertiesSheetWriter.SHEET_NAME);

			Map<String, String> sheetByChoiceId = new LinkedHashMap<String, String>();
			List<ChoiceListMetadata> choiceOrder = new ArrayList<ChoiceListMetadata>(uniqueChoiceLists.values());
			for (ChoiceListMetadata cl : choiceOrder) {
				String preferred = cl.getDisplayName() != null && cl.getDisplayName().length() > 0
						? cl.getDisplayName()
						: cl.getSymbolicName();
				String sheetName = nameUtil.uniqueName(preferred);
				sheetByChoiceId.put(cl.getId(), sheetName);
			}

			new DocumentPropertiesSheetWriter().write(workbook, styles, request.getSelectedColumns(), properties,
					request.isExportChoiceListDetails(), sheetByChoiceId);

			ChoiceListSheetWriter choiceWriter = new ChoiceListSheetWriter();
			for (ChoiceListMetadata cl : choiceOrder) {
				String sheetName = sheetByChoiceId.get(cl.getId());
				choiceWriter.write(workbook, styles, sheetName, cl, DocumentPropertiesSheetWriter.SHEET_NAME,
						"Back to Document Properties");
			}

			ByteArrayOutputStream out = new ByteArrayOutputStream();
			workbook.write(out);
			return out.toByteArray();
		} catch (Exception e) {
			if (e instanceof MetadataExportException) {
				throw (MetadataExportException) e;
			}
			throw new MetadataExportException("The Excel report could not be generated.", e);
		} finally {
			if (workbook != null) {
				try {
					workbook.close();
				} catch (Exception ignore) {
					// ignore
				}
			}
		}
	}
}
