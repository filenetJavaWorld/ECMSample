public final class ReportRequestDocumentHelper {

	private static final Charset UTF8 = Charset.forName("UTF-8");

	private ReportRequestDocumentHelper() {
	}

	public static JSONObject createReportRequestDocument(ObjectStore os, JSONObject payloadJson) throws Exception {
		String reportName = trim(payloadJson.get("reportName"));
		String reportRequestId = trim(payloadJson.get("reportRequestId"));
		if (reportRequestId == null || reportRequestId.length() == 0) {
			reportRequestId = UUID.randomUUID().toString();
			payloadJson.put("reportRequestId", reportRequestId);
		}

		String jsonText = payloadJson.serialize(true);
		byte[] bytes = jsonText.getBytes(UTF8);

		String retrievalName = ReportPluginConstants.JSON_FILENAME_PREFIX + reportRequestId
				+ ReportPluginConstants.JSON_FILENAME_SUFFIX;

		Document doc = Factory.Document.createInstance(os, ReportPluginConstants.REPORT_REQUEST_CLASS);
		Properties props = doc.getProperties();
		props.putValue("DocumentTitle", reportName);
		applyReportRequestMetadata(props, payloadJson);

		ContentTransfer ct = Factory.ContentTransfer.createInstance();
		ct.setCaptureSource(new ByteArrayInputStream(bytes));
		ct.set_RetrievalName(retrievalName);
		ct.set_ContentType(ReportPluginConstants.JSON_MIME_TYPE);

		ContentElementList cel = Factory.ContentElement.createList();
		cel.add(ct);
		doc.set_ContentElements(cel);
		doc.set_MimeType(ReportPluginConstants.JSON_MIME_TYPE);

		saveAsMajorVersion(doc);

		JSONObject out = new JSONObject();
		out.put("documentId", doc.get_Id().toString());
		out.put("reportRequestId", reportRequestId);
		return out;
	}

	private static JSONArray queryMyReportRequests(ObjectStore os, PluginServiceCallbacks callbacks, int maxResults)
			throws Exception {
		if (callbacks == null) {
			throw new IllegalArgumentException("callbacks is required.");
		}
		if (maxResults < 1) {
			maxResults = 1;
		}

		String sql = com.cnb.reports.config.ReportPluginConfigUtil.buildReportRequestListSqlForCurrentUser(callbacks);

		PropertyFilter pf = newReportRequestListPropertyFilter();
		return fetchReportRequestRows(os, sql, maxResults, pf);
	}

	private static PropertyFilter newReportRequestListPropertyFilter() {
		PropertyFilter pf = new PropertyFilter();
		pf.addIncludeProperty(0, null, null, "This", null);
		pf.addIncludeProperty(0, null, null, PropertyNames.ID, null);
		pf.addIncludeProperty(0, null, null, "DocumentTitle", null);
		pf.addIncludeProperty(0, null, null, PropertyNames.CREATOR, null);
		pf.addIncludeProperty(0, null, null, "DateCreated", null);
		pf.addIncludeProperty(0, null, null, "DateLastModified", null);
		pf.addIncludeProperty(0, null, null, ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS, null);
		pf.addIncludeProperty(0, null, null, "MimeType", null);
		return pf;
	}

	private static JSONArray fetchReportRequestRows(ObjectStore os, String sql, int maxRows, PropertyFilter pf)
			throws Exception {
		SearchSQL searchSQL = new SearchSQL(sql);
		SearchScope scope = new SearchScope(os);
		IndependentObjectSet set = scope.fetchObjects(searchSQL, maxRows, pf, Boolean.TRUE);
		JSONArray rows = new JSONArray();
		PageIterator pi = set.pageIterator();
		while (pi.nextPage()) {
			Object[] page = pi.getCurrentPage();
			if (page == null) {
				continue;
			}
			for (Object o : page) {
				if (!(o instanceof Document)) {
					continue;
				}
				rows.add(toListRow((Document) o));
			}
		}
		return rows;
	}

	private static JSONObject toListRow(Document d) {
		Properties p = d.getProperties();
		JSONObject row = new JSONObject();
		row.put("documentId", d.get_Id().toString());
		row.put("documentTitle", P8PropertyValues.asString(p, "DocumentTitle"));
		row.put("creator", P8PropertyValues.asString(p, PropertyNames.CREATOR));
		row.put("dateCreated", P8PropertyValues.asDateTimeIsoUtc(p, "DateCreated"));
		row.put("dateLastModified", P8PropertyValues.asDateTimeIsoUtc(p, "DateLastModified"));
		row.put("status", P8PropertyValues.asString(p, ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS));
		row.put("contentType", ReportPluginConstants.JSON_MIME_TYPE);
		return row;
	}

	/**
	 * Updates a Pending report request via exclusive checkout, JSON/content replace, and checkin.
	 * Uses a minor version so the request stays on major 1.x; execution still creates major Version 2.
	 * Status remains Pending.
	 */
	public static JSONObject updateReportRequestDocument(ObjectStore os, String documentId, JSONObject payloadJson)
			throws Exception {
		if (documentId == null || documentId.trim().isEmpty()) {
			throw new IllegalArgumentException("documentId is required.");
		}

		String reportRequestId = trim(payloadJson.get("reportRequestId"));
		if (reportRequestId == null || reportRequestId.length() == 0) {
			throw new IllegalArgumentException("reportRequestId is required to update report request content.");
		}
		payloadJson.put("reportRequestId", reportRequestId);

		String reportName = trim(payloadJson.get("reportName"));
		if (reportName == null) {
			throw new IllegalArgumentException("reportName is required.");
		}

		payloadJson.put("status", ReportPluginConstants.REPORT_REQUEST_INITIAL_STATUS);

		Document reservation = checkoutExclusiveReservation(os, documentId);
		Properties reservationProps = reservation.getProperties();
		reservationProps.putValue("DocumentTitle", reportName);
		applyReportRequestMetadata(reservationProps, payloadJson);
		replaceDocumentJsonContent(reservation, payloadJson, reportRequestId);
		reservation.checkin(AutoClassify.DO_NOT_AUTO_CLASSIFY, CheckinType.MINOR_VERSION);
		reservation.save(RefreshMode.REFRESH);

		JSONObject out = new JSONObject();
		out.put("documentId", reservation.get_Id().toString());
		out.put("reportRequestId", reportRequestId);
		return out;
	}

	/**
	 * Resolves the current version of the report request and verifies Status is Pending. Call this before reading JSON
	 * content or checking out so Completed/InProgress requests fail with a clear status error.
	 *
	 * @return the current-version document id (may differ from the input when a non-current id was supplied)
	 */
	public static String assertCurrentVersionPending(ObjectStore os, String documentId) throws Exception {
		Document currentDoc = fetchCurrentVersionDocument(os, documentId);
		assertPendingStatus(currentDoc);
		return currentDoc.get_Id().toString();
	}

	/**
	 * Checks out the released document exclusively and returns its mutable reservation. Properties and content must
	 * only be updated on the reservation, not on the released document.
	 */
	private static Document checkoutExclusiveReservation(ObjectStore os, String documentId) throws Exception {
		Document existingDoc = fetchCurrentVersionDocument(os, documentId);
		assertPendingStatus(existingDoc);

		if (Boolean.TRUE.equals(existingDoc.get_IsReserved())) {
			throw new IllegalStateException(
					"Document is already checked out. Cannot update until it is checked in or checkout is cancelled.");
		}

		existingDoc.checkout(ReservationType.EXCLUSIVE, null, null, null);
		existingDoc.save(RefreshMode.REFRESH);

		Document reservation = (Document) existingDoc.get_Reservation();
		if (reservation == null) {
			throw new IllegalStateException(
					"Unable to obtain reservation after checkout for report request: " + documentId);
		}
		return reservation;
	}

	private static Document fetchCurrentVersionDocument(ObjectStore os, String documentId) throws Exception {
		Document doc = Factory.Document.fetchInstance(os, new Id(documentId), null);
		if (!Boolean.TRUE.equals(doc.get_IsCurrentVersion())) {
			Document current = (Document) doc.get_VersionSeries().get_CurrentVersion();
			if (current == null) {
				throw new IllegalStateException("Unable to resolve current version for report request: " + documentId);
			}
			return current;
		}
		return doc;
	}

	/**
	 * Updates Status on the current version only (no checkout). Validates the current status matches
	 * {@code expectedStatus} before applying {@code newStatus}.
	 */
	public static JSONObject updateReportRequestStatus(ObjectStore os, String documentId, String expectedStatus,
			String newStatus) throws Exception {
		if (documentId == null || documentId.trim().isEmpty()) {
			throw new IllegalArgumentException("documentId is required.");
		}
		if (expectedStatus == null || expectedStatus.trim().isEmpty()) {
			throw new IllegalArgumentException("expectedStatus is required.");
		}
		if (newStatus == null || newStatus.trim().isEmpty()) {
			throw new IllegalArgumentException("newStatus is required.");
		}

		Document currentDoc = fetchCurrentVersionDocument(os, documentId);
		if (Boolean.TRUE.equals(currentDoc.get_IsReserved())) {
			throw new IllegalStateException(
					"Document is already checked out. Cannot update status until it is checked in or checkout is cancelled.");
		}

		String currentStatus = P8PropertyValues.asString(currentDoc.getProperties(),
				ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS);
		if (currentStatus == null || !expectedStatus.equalsIgnoreCase(currentStatus.trim())) {
			throw new IllegalStateException("Cannot change status to " + newStatus + ". Expected current status "
					+ expectedStatus + ", but was: " + currentStatus);
		}

		currentDoc.getProperties().putValue(ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS, newStatus);
		currentDoc.save(RefreshMode.REFRESH);

		JSONObject out = new JSONObject();
		out.put("documentId", currentDoc.get_Id().toString());
		out.put("status", newStatus);
		return out;
	}

	/**
	 * Replaces document JSON content with a new single {@link ContentTransfer} element.
	 */
	private static void replaceDocumentJsonContent(Document document, JSONObject payloadJson, String reportRequestId)
			throws Exception {
		String jsonText = payloadJson.serialize(true);
		byte[] bytes = jsonText.getBytes(UTF8);
		String retrievalName = ReportPluginConstants.JSON_FILENAME_PREFIX + reportRequestId
				+ ReportPluginConstants.JSON_FILENAME_SUFFIX;

		ContentTransfer ct = Factory.ContentTransfer.createInstance();
		ct.setCaptureSource(new ByteArrayInputStream(bytes));
		ct.set_RetrievalName(retrievalName);
		ct.set_ContentType(ReportPluginConstants.JSON_MIME_TYPE);

		ContentElementList contentList = Factory.ContentElement.createList();
		contentList.add(ct);
		document.set_ContentElements(contentList);
		document.set_MimeType(ReportPluginConstants.JSON_MIME_TYPE);
	}

	private static void assertPendingStatus(Document doc) {
		String status = P8PropertyValues.asString(doc.getProperties(),
				ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS);
		if (!isPendingStatus(status)) {
			throw new IllegalStateException(
					"Only report requests in Pending status can be edited. Current status: " + status);
		}
	}

	private static boolean isPendingStatus(String status) {
		return status != null
				&& ReportPluginConstants.REPORT_REQUEST_INITIAL_STATUS.equalsIgnoreCase(status.trim());
	}

	public static JSONObject loadDocumentJson(ObjectStore os, String documentId) throws Exception {
		return loadDocumentJson(os, documentId, false);
	}

	/**
	 * Loads report request details. When {@code versionOneOnly} is true, reads JSON from Version 1.0 (request
	 * payload), not the current execution Version 2.
	 */
	public static JSONObject loadDocumentJson(ObjectStore os, String documentId, boolean versionOneOnly)
			throws Exception {
		PropertyFilter pf = detailPropertyFilter();
		Document doc;
		if (versionOneOnly) {
			doc = fetchVersionOneDocument(os, documentId);
			doc = Factory.Document.fetchInstance(os, doc.get_Id(), pf);
		} else {
			String currentDocId = fetchCurrentVersionDocument(os, documentId).get_Id().toString();
			doc = Factory.Document.fetchInstance(os, new Id(currentDocId), pf);
		}

		JSONObject meta = new JSONObject();
		Properties mp = doc.getProperties();
		meta.put("documentId", doc.get_Id().toString());
		meta.put("documentTitle", P8PropertyValues.asString(mp, "DocumentTitle"));
		meta.put("creator", P8PropertyValues.asString(mp, PropertyNames.CREATOR));
		meta.put("dateCreated", P8PropertyValues.asDateTimeIsoUtc(mp, "DateCreated"));
		meta.put("dateLastModified", P8PropertyValues.asDateTimeIsoUtc(mp, "DateLastModified"));
		meta.put("status", P8PropertyValues.asString(mp, ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS));
		meta.put("majorVersionNumber", doc.get_MajorVersionNumber());
		meta.put("minorVersionNumber", doc.get_MinorVersionNumber());
		meta.put("isCurrentVersion", Boolean.TRUE.equals(doc.get_IsCurrentVersion()));

		JSONObject content = readFirstContentJson(doc);

		JSONObject out = new JSONObject();
		out.put("metadata", meta);
		out.put("reportRequest", content);
		return out;
	}

	private static PropertyFilter detailPropertyFilter() {
		PropertyFilter pf = new PropertyFilter();
		pf.addIncludeProperty(0, null, null, PropertyNames.ID, null);
		pf.addIncludeProperty(0, null, null, "DocumentTitle", null);
		pf.addIncludeProperty(0, null, null, PropertyNames.CREATOR, null);
		pf.addIncludeProperty(0, null, null, "DateCreated", null);
		pf.addIncludeProperty(0, null, null, "DateLastModified", null);
		pf.addIncludeProperty(0, null, null, ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS, null);
		pf.addIncludeProperty(0, null, null, PropertyNames.CONTENT_ELEMENTS, null);
		pf.addIncludeProperty(0, null, null, PropertyNames.MAJOR_VERSION_NUMBER, null);
		pf.addIncludeProperty(0, null, null, PropertyNames.MINOR_VERSION_NUMBER, null);
		pf.addIncludeProperty(0, null, null, PropertyNames.IS_CURRENT_VERSION, null);
		pf.addIncludeProperty(0, null, null, PropertyNames.VERSION_SERIES, null);
		return pf;
	}

	/**
	 * Resolves the request JSON version for Copy/Reinitiate:
	 * <ul>
	 * <li>If current major version is still 1 (Pending / not yet executed), return current (latest edited JSON).</li>
	 * <li>If current is Version 2+ (Completed/Failed), return the latest major=1 version (request JSON).</li>
	 * </ul>
	 */
	public static Document fetchVersionOneDocument(ObjectStore os, String documentId) throws Exception {
		PropertyFilter seedFilter = new PropertyFilter();
		seedFilter.addIncludeProperty(0, null, null, PropertyNames.ID, null);
		seedFilter.addIncludeProperty(0, null, null, PropertyNames.VERSION_SERIES, null);
		seedFilter.addIncludeProperty(0, null, null, PropertyNames.MAJOR_VERSION_NUMBER, null);
		seedFilter.addIncludeProperty(0, null, null, PropertyNames.MINOR_VERSION_NUMBER, null);
		seedFilter.addIncludeProperty(0, null, null, PropertyNames.IS_CURRENT_VERSION, null);

		Document current = fetchCurrentVersionDocument(os, documentId);
		current = Factory.Document.fetchInstance(os, current.get_Id(), seedFilter);
		Integer currentMajor = current.get_MajorVersionNumber();
		if (currentMajor == null || currentMajor.intValue() <= 1) {
			// Still on request version(s); current holds the latest Pending JSON.
			return current;
		}

		VersionSeries versionSeries = current.get_VersionSeries();
		if (versionSeries == null) {
			return current;
		}

		PropertyFilter vsFilter = new PropertyFilter();
		vsFilter.addIncludeProperty(0, null, null, PropertyNames.VERSIONS, null);
		versionSeries.fetchProperties(vsFilter);

		Document latestMajorOne = null;
		int latestMinor = -1;
		Document earliest = null;
		int earliestMajor = Integer.MAX_VALUE;
		int earliestMinor = Integer.MAX_VALUE;

		IndependentObjectSet versions = versionSeries.get_Versions();
		if (versions != null) {
			java.util.Iterator<?> it = versions.iterator();
			while (it.hasNext()) {
				Object next = it.next();
				if (!(next instanceof Document)) {
					continue;
				}
				Document version = (Document) next;
				Integer major = version.get_MajorVersionNumber();
				Integer minor = version.get_MinorVersionNumber();
				int majorVal = major != null ? major.intValue() : 0;
				int minorVal = minor != null ? minor.intValue() : 0;
				if (majorVal == 1 && minorVal >= latestMinor) {
					latestMinor = minorVal;
					latestMajorOne = version;
				}
				if (majorVal < earliestMajor || (majorVal == earliestMajor && minorVal < earliestMinor)) {
					earliestMajor = majorVal;
					earliestMinor = minorVal;
					earliest = version;
				}
			}
		}

		Document resolved = latestMajorOne != null ? latestMajorOne : (earliest != null ? earliest : current);
		return Factory.Document.fetchInstance(os, resolved.get_Id(), seedFilter);
	}

	public static JSONObject loadDocumentJsonByReportRequestId(ObjectStore os, PluginServiceCallbacks callbacks,
			String reportRequestId, int maxCandidates) throws Exception {
		JSONArray candidates = queryMyReportRequests(os, callbacks, maxCandidates);
		for (int i = 0; i < candidates.size(); i++) {
			JSONObject row = (JSONObject) candidates.get(i);
			String docId = trim(row.get("documentId"));
			if (docId == null) {
				continue;
			}
			try {
				JSONObject details = loadDocumentJson(os, docId);
				JSONObject rr = (JSONObject) details.get("reportRequest");
				if (rr != null && reportRequestId.equals(trim(rr.get("reportRequestId")))) {
					return details;
				}
			} catch (Exception e) {
