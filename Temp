define([
	"dojo/_base/lang",
	"ecm/model/Request"
], function(lang, Request) {

	var PLUGIN_ID = "CNBRepoMetadataExportPlugin";
	var SERVICE_ID = "listChoiceLists";

	/**
	 * Loads choice lists for an object store (Phase 1 UI support).
	 */
	var ChoiceListService = {

		/**
		 * @param {String} repositoryId
		 * @param {Function} onSuccess function(choiceLists)
		 * @param {Function} onError function(message)
		 */
		listChoiceLists: function(repositoryId, onSuccess, onError) {
			if (!repositoryId) {
				if (lang.isFunction(onError)) {
					onError("Please select an object store.");
				}
				return;
			}

			Request.invokePluginService(PLUGIN_ID, SERVICE_ID, {
				requestParams: {
					repositoryId: repositoryId
				},
				requestCompleteCallback: function(response) {
					if (response && response.success) {
						if (lang.isFunction(onSuccess)) {
							onSuccess(response.choiceLists || []);
						}
					} else if (lang.isFunction(onError)) {
						onError((response && response.message) || "Unable to retrieve choice-list metadata.");
					}
				},
				requestFailedCallback: function(response) {
					if (lang.isFunction(onError)) {
						onError((response && response.errors && response.errors[0] && response.errors[0].text)
							|| (response && response.message)
							|| "Unable to retrieve choice-list metadata.");
					}
				}
			});
		}
	};

	return ChoiceListService;
});
