package com.cnb.reports.config;

import java.util.Collections;
import java.util.HashSet;
import java.util.Locale;
import java.util.Set;

import com.cnb.reports.constants.ReportPluginConstants;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.json.java.JSONObject;

/**
 * Reads plug-in configuration and builds the dashboard list SQL with optional Creator scoping.
 */
public final class ReportPluginConfigUtil {

	private ReportPluginConfigUtil() {
	}

	/**
	 * Loads the plug-in configuration JSON from ICN ({@link PluginServiceCallbacks#loadConfiguration()}).
	 */
	public static JSONObject loadConfigObject(PluginServiceCallbacks callbacks) {
		if (callbacks == null) {
			return new JSONObject();
		}
		try {
			String raw = callbacks.loadConfiguration();
			if (raw == null || raw.trim().isEmpty()) {
				return new JSONObject();
			}
			Object parsed = com.ibm.json.java.JSON.parse(raw.trim());
			if (parsed instanceof JSONObject) {
				return (JSONObject) parsed;
			}
		} catch (Exception e) {
			// Fall through to empty config
		}
		return new JSONObject();
	}

	/**
	 * Parses {@link ReportPluginConstants#CONFIG_KEY_ADMIN_USERS} as a comma-separated list of short names.
	 */
	public static Set<String> parseAdminUsers(JSONObject config) {
		if (config == null) {
			return Collections.emptySet();
		}
		Object value = config.get(ReportPluginConstants.CONFIG_KEY_ADMIN_USERS);
		if (value == null) {
			return Collections.emptySet();
		}
		String raw = String.valueOf(value).trim();
		if (raw.length() == 0) {
			return Collections.emptySet();
		}
		Set<String> admins = new HashSet<String>();
		String[] parts = raw.split(",");
		for (int i = 0; i < parts.length; i++) {
			String part = parts[i] != null ? parts[i].trim() : "";
			if (part.length() > 0) {
				admins.add(part.toLowerCase(Locale.ENGLISH));
			}
		}
		return admins;
	}

	public static boolean isReportAdmin(PluginServiceCallbacks callbacks, String userId) {
		if (userId == null || userId.trim().isEmpty()) {
			return false;
		}
		Set<String> admins = parseAdminUsers(loadConfigObject(callbacks));
		return admins.contains(userId.trim().toLowerCase(Locale.ENGLISH));
	}

	/**
	 * Builds the CE SQL for the report-request list.
	 *
	 * @param viewAll
	 *            when true (admin), no Creator filter; otherwise restricts to {@code creatorUserId}
	 * @param creatorUserId
	 *            signed-in user short name (required when {@code viewAll} is false)
	 */
	public static String buildReportRequestListSql(boolean viewAll, String creatorUserId) {
		StringBuilder sql = new StringBuilder(ReportPluginConstants.REPORT_REQUEST_LIST_SELECT);
		sql.append(" WHERE IsCurrentVersion = true");
		if (!viewAll) {
			String user = creatorUserId != null ? creatorUserId.trim() : "";
			if (user.length() == 0) {
				// No user context — return no rows rather than exposing all requests.
				sql.append(" AND 1 = 0");
			} else {
				sql.append(" AND ").append(ReportPluginConstants.REPORT_REQUEST_PROPERTY_CREATOR).append(" = '")
						.append(escapeCeStringLiteral(user)).append("'");
			}
		}
		sql.append(" ORDER BY ").append(ReportPluginConstants.REPORT_REQUEST_PROPERTY_DATE_CREATED).append(" DESC");
		return sql.toString();
	}

	/**
	 * Resolves list SQL for the current plug-in user (admin → all; otherwise Creator = current user).
	 */
	public static String buildReportRequestListSqlForCurrentUser(PluginServiceCallbacks callbacks) {
		String userId = callbacks != null ? callbacks.getUserId() : null;
		boolean viewAll = isReportAdmin(callbacks, userId);
		return buildReportRequestListSql(viewAll, userId);
	}

	private static String escapeCeStringLiteral(String value) {
		if (value == null) {
			return "";
		}
		return value.replace("'", "''");
	}
