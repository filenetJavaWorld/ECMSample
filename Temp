			var self = this;
			aspect.after(tab.searchDefinition, "_prepareSearchTemplateForExecution", function(prepared) {
				var def = tab.searchDefinition;
				var mode = def._metlifeCurrentSearchMode ||
					(self._isDocumentSearchActive(def, prepared) ? "document" :
						(self._isFolderSearchActive(def, prepared) ? "folder" : null));
				self._debugLog("_prepareSearchTemplateForExecution ENTER", {
					mode: mode,
					snapshot: self._snapshotTemplateForDebug(prepared, def)
				});
				// Every search uses Text Options "All of the terms".
				self._applyTextSearchOperatorAll(def);
				prepared = self._forceTextSearchCriteriaOperatorAll(prepared);
				if (mode === "document") {
					prepared = self._alignDocumentSearchTemplateWithOotb(prepared, def);
					prepared = self._restrictSearchCriteriaToNameOnly(prepared, def, "document");
					def._metlifeFolderSearchToken = null;
				} else if (mode === "folder") {
					prepared = self._alignFolderSearchTemplateWithOotb(prepared, def);
					prepared = self._restrictSearchCriteriaToNameOnly(prepared, def, "folder");
				}
				prepared = self._forceTextSearchCriteriaOperatorAll(prepared);
				self._debugLog("_prepareSearchTemplateForExecution EXIT", self._snapshotTemplateForDebug(prepared, def));
