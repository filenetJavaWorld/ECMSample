/**
 * Updates ReportRequest Status for Hold / Release Hold (Pending &lt;-&gt; Hold) without creating a new version.
 */
public class UpdateReportRequestStatusService extends PluginService {

	public static final String SERVICE_ID = ReportPluginConstants.SERVICE_UPDATE_REPORT_REQUEST_STATUS;

	@Override
	public String getId() {
		return SERVICE_ID;
	}

	@Override
	public void execute(final PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response)
			throws Exception {
		final String method = "execute";
		callbacks.getLogger().logEntry(this, method, request);
		try {
			String body = readBody(request);
			if (body == null || body.trim().isEmpty()) {
				writeFailure(response, request, callbacks, "Request body is empty.");
				return;
			}

			Object parsed;
			try {
				parsed = com.ibm.json.java.JSON.parse(body);
			} catch (Exception e) {
				writeFailure(response, request, callbacks, "Invalid JSON: " + safeMsg(e));
				return;
			}
			if (!(parsed instanceof JSONObject)) {
				writeFailure(response, request, callbacks, "Request body must be a JSON object.");
				return;
			}
			final JSONObject payload = (JSONObject) parsed;

			final String repositoryId = trimString(payload.get("repositoryId"));
			if (repositoryId == null) {
				writeFailure(response, request, callbacks, "repositoryId is required.");
				return;
			}
			final String documentId = trimString(payload.get("documentId"));
			if (documentId == null) {
				writeFailure(response, request, callbacks, "documentId is required.");
				return;
			}
			final String action = trimString(payload.get("action"));
			if (action == null) {
				writeFailure(response, request, callbacks, "action is required (hold or releaseHold).");
				return;
			}

			final String expectedStatus;
			final String newStatus;
			final String successMessage;
			if ("hold".equalsIgnoreCase(action)) {
				expectedStatus = ReportPluginConstants.REPORT_REQUEST_INITIAL_STATUS;
				newStatus = ReportPluginConstants.REPORT_REQUEST_STATUS_HOLD;
				successMessage = "Report request placed on Hold.";
			} else if ("releaseHold".equalsIgnoreCase(action)) {
				expectedStatus = ReportPluginConstants.REPORT_REQUEST_STATUS_HOLD;
				newStatus = ReportPluginConstants.REPORT_REQUEST_INITIAL_STATUS;
				successMessage = "Report request released from Hold (Pending).";
			} else {
				writeFailure(response, request, callbacks, "Unsupported action: " + action);
				return;
			}

			JSONObject updated;
			try {
				updated = P8ContextUtil.runWithP8Context(callbacks, repositoryId,
						new P8ContextUtil.P8Callback<JSONObject>() {
							@Override
							public JSONObject run(com.filenet.api.core.ObjectStore objectStore) throws Exception {
								return ReportRequestDocumentHelper.updateReportRequestStatus(objectStore, documentId,
										expectedStatus, newStatus);
							}
						});
			} catch (Exception e) {
				callbacks.getLogger().logError(this, method, request, e);
				writeFailure(response, request, callbacks,
						e.getMessage() != null ? e.getMessage() : "Unable to update report request status.");
				return;
			}

			JSONResponse ok = new JSONResponse();
			ok.put("success", true);
			ok.put("documentId", updated.get("documentId"));
			ok.put("status", updated.get("status"));
			ok.put("message", successMessage);
			PluginResponseUtil.writeJSONResponse(request, response, ok, callbacks, SERVICE_ID);
		} finally {
			callbacks.getLogger().logExit(this, method, request);
		}
	}

