define([
	"dojo/_base/lang",
	"ecm/model/Request",
	"ecm/Messages"
], function(lang, Request, Messages) {

	var PLUGIN_ID = "CNBRepoMetadataExportPlugin";

	function postJson(serviceId, repositoryId, payload, onSuccess, onError) {
		var params = {
			repositoryId: repositoryId,
			desktop: ecm.model.desktop && ecm.model.desktop.id ? ecm.model.desktop.id : null,
			plugin: PLUGIN_ID,
			action: serviceId
		};
		var requestUrl = Request.getServiceRequestUrl("plugin", "", params);
		var body = lang.isObject(payload) ? JSON.stringify(payload) : String(payload || "{}");
		var pluginParams = {
			requestUrl: requestUrl,
			requestMethod: "POST",
			requestBody: body,
			synchronous: false,
			progressMessage: Messages.progress_message_general,
			cancelMessage: Messages.cancel_message_general,
			requestHeaders: {
				"Cache-Control": "no-cache",
				"Content-Type": "application/json; charset=UTF-8"
			},
			requestCompleteCallback: function(response) {
				if (response && response.success) {
					if (lang.isFunction(onSuccess)) {
						onSuccess(response);
					}
				} else if (lang.isFunction(onError)) {
					onError((response && response.message) || "The Excel report could not be generated.");
				}
			},
			requestFailedCallback: function(response) {
				if (lang.isFunction(onError)) {
					onError((response && response.errors && response.errors[0] && response.errors[0].text)
						|| (response && response.message)
						|| "The report download could not be completed.");
				}
			}
		};
		if (Request.enableSecureService) {
			pluginParams.requestHeaders.security_token = Request._security_token;
		}
		var req = new Request(pluginParams);
		if (repositoryId && ecm.model.desktop) {
			req.repository = ecm.model.desktop.getRepository(repositoryId);
		}
		req.send();
	}

	function downloadBase64File(base64Content, fileName, contentType) {
		if (!base64Content) {
			throw new Error("The report download could not be completed.");
		}
		var binary = atob(base64Content);
		var len = binary.length;
		var bytes = new Uint8Array(len);
		for (var i = 0; i < len; i++) {
			bytes[i] = binary.charCodeAt(i);
		}
		var blob = new Blob([
			bytes
		], {
			type: contentType || "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
		});
		if (window.navigator && window.navigator.msSaveOrOpenBlob) {
			window.navigator.msSaveOrOpenBlob(blob, fileName || "export.xlsx");
			return;
		}
		var url = (window.URL || window.webkitURL).createObjectURL(blob);
		var anchor = document.createElement("a");
		anchor.href = url;
		anchor.download = fileName || "export.xlsx";
		document.body.appendChild(anchor);
		anchor.click();
		document.body.removeChild(anchor);
		(window.URL || window.webkitURL).revokeObjectURL(url);
	}

	return {
		exportDocumentClassMetadata: function(repositoryId, payload, onSuccess, onError) {
			postJson("exportDocumentClassMetadata", repositoryId, payload, onSuccess, onError);
		},

		exportChoiceLists: function(repositoryId, payload, onSuccess, onError) {
			postJson("exportChoiceLists", repositoryId, payload, onSuccess, onError);
		},

		downloadBase64File: downloadBase64File
	};
});
