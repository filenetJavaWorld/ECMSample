	}

	function hasResultsDisplayColumns(resultsDisplay) {
		return !!(resultsDisplay && lang.isArray(resultsDisplay.columns) && resultsDisplay.columns.length);
	}

	function forceResultsDisplay(searchDefinition, resultsDisplay) {
		if (!searchDefinition || !hasResultsDisplayColumns(resultsDisplay)) {
			return;
		}
		var clone = lang.clone(resultsDisplay);
		if (searchDefinition.searchTemplate) {
			searchDefinition.searchTemplate.resultsDisplay = lang.clone(clone);
		}
		if (searchDefinition.resultsDisplayOptions && lang.isFunction(searchDefinition.resultsDisplayOptions.setResultsDisplay)) {
			// Keep dialog available-items in sync with current class, then restore saved columns/sort.
			searchDefinition.resultsDisplayOptions.setResultsDisplay(clone, false);
			if (searchDefinition.resultsDisplayOptions._isLoaded !== undefined) {
				// Force Results Display dialog to rebuild selected items from _resultsDisplay next open.
				searchDefinition.resultsDisplayOptions._isLoaded = false;
			}
		}
	}

	/**
	 * BasicSearchDefinition has no setSearchTemplate API. Assign an existing (non-new) SearchTemplate and re-init so
	 * class, criteria, and results display are applied from the report request JSON.
	 */
	function applyPayloadToSearchDefinition(searchDefinition, repository, payload, onReady) {
		if (!searchDefinition || !repository || !payload) {
			if (onReady) {
				onReady();
			}
			return;
		}
		if (!payload.targetClassSymbolicName && !(payload.criteria && payload.criteria.length)) {
			if (onReady) {
				onReady();
			}
			return;
		}

		var template = buildSearchTemplateFromPayload(searchDefinition, repository, payload);
		var desiredResultsDisplay = hasResultsDisplayColumns(template.resultsDisplay)
			? lang.clone(template.resultsDisplay)
			: null;
		var finished = false;
		var originalOnAttributeDefinitionsChange = searchDefinition._onAttributeDefinitionsChange;
		var patched = lang.isFunction(originalOnAttributeDefinitionsChange);

		var restoreAttributeHook = function() {
			if (patched) {
				searchDefinition._onAttributeDefinitionsChange = originalOnAttributeDefinitionsChange;
				patched = false;
			}
		};

		var complete = function() {
			if (finished) {
				return;
			}
			finished = true;
			forceResultsDisplay(searchDefinition, desiredResultsDisplay);
			// Late attribute-definition callbacks can still reset to defaults after first load.
			setTimeout(function() {
				forceResultsDisplay(searchDefinition, desiredResultsDisplay);
			}, 150);
			setTimeout(function() {
				forceResultsDisplay(searchDefinition, desiredResultsDisplay);
				restoreAttributeHook();
			}, 600);
			if (onReady) {
				onReady();
			}
		};

		// IBM resets Results Display to defaults on later _onAttributeDefinitionsChange calls once _loaded=true.
		// Keep re-applying the saved JSON columns/sort while edit populate settles.
		if (patched && desiredResultsDisplay) {
			searchDefinition._onAttributeDefinitionsChange = function() {
				var prevLoaded = searchDefinition._loaded;
				// Prefer IBM's "existing search" branch that reads searchTemplate.resultsDisplay.
				searchDefinition.searchTemplate.resultsDisplay = lang.clone(desiredResultsDisplay);
				searchDefinition._loaded = false;
				originalOnAttributeDefinitionsChange.apply(searchDefinition, arguments);
				forceResultsDisplay(searchDefinition, desiredResultsDisplay);
				if (prevLoaded) {
					searchDefinition._loaded = true;
				}
			};
		}

		searchDefinition.searchTemplate = template;
		searchDefinition._loaded = false;

		var handle = null;
		if (lang.isFunction(searchDefinition.connect)) {
			handle = searchDefinition.connect(searchDefinition, "onChange", function() {
				if (!searchDefinition._loaded || searchDefinition.searchTemplate !== template) {
					return;
				}
				forceResultsDisplay(searchDefinition, desiredResultsDisplay);
				if (handle && lang.isFunction(searchDefinition.disconnect)) {
					searchDefinition.disconnect(handle);
					handle = null;
				}
				complete();
			});
		}

		searchDefinition.setRepository(repository);

		var contentClass = null;
		if (lang.isFunction(template.getSearchContentClass)) {
			try {
				contentClass = template.getSearchContentClass();
			} catch (e) {
				contentClass = null;
			}
		}
		if (contentClass) {
			var selected = searchDefinition.contentClass;
			var selectedId = selected && selected.id;
			// Re-select class for UI; if already the same class, force form rebuild so criteria apply.
			searchDefinition._loaded = false;
			if (selectedId === contentClass.id && lang.isFunction(searchDefinition._onContentClassSelected)) {
				searchDefinition._onContentClassSelected(contentClass, !!template.includeSubclasses);
			} else if (lang.isFunction(searchDefinition._setSelectedContentClass)) {
				searchDefinition._setSelectedContentClass(contentClass);
			} else if (lang.isFunction(searchDefinition._onContentClassSelected)) {
				searchDefinition._onContentClassSelected(contentClass, !!template.includeSubclasses);
			}
		}

		setTimeout(complete, 5000);
	}

	function populateBasicFieldsFromPayload(dialog, payload, metadata) {
		var meta = metadata || {};
		var reportName = payload.reportName || meta.documentTitle || "";
		dialog.reportNameField.set("value", reportName);

		var sendEmails = resolveSendEmailsFromPayload(payload);
		dialog.sendEmailYesRadio.set("checked", sendEmails);
		dialog.sendEmailNoRadio.set("checked", !sendEmails);
		if (dialog._updateEmailFieldsState) {
			dialog._updateEmailFieldsState();
		}
		if (sendEmails) {
			dialog.sendEmailToField.set("value", formatEmailsForField(payload.sendEmailTo));
			dialog.sendEmailCcField.set("value", formatEmailsForField(payload.sendEmailCC || payload.sendEmailCc));
		}
	}

	return {
		EMAIL_SEPARATOR: EMAIL_SEPARATOR,
		parseSemicolonEmails: parseSemicolonEmails,
		formatEmailsForField: formatEmailsForField,
		resolveSendEmailsFromPayload: resolveSendEmailsFromPayload,
		isValidEmailAddress: isValidEmailAddress,
		findInvalidEmail: findInvalidEmail,
		buildInvalidEmailMessage: buildInvalidEmailMessage,
		buildPayload: buildPayload,
		applyPayloadToSearchDefinition: applyPayloadToSearchDefinition,
		populateBasicFieldsFromPayload: populateBasicFieldsFromPayload
	};
});
