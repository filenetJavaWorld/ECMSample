			}
			state.controlsRestored = true;
			state._savedTemplateRestoreAttempted = true;
			console.log(LOG, "Saved custom controls restored without changing ICN criteria", {
				tabKey: tabKey,
				searchType: savedType,
				sliceFolderId: matchedSlice ? matchedSlice.folderId : null,
				sliceLabel: matchedSlice ? matchedSlice.label : null
			});
		},
		
		
		
		
		
		
		
		
		
		_installAdvancedSearchPersistenceHooks: function(tab, state) {
			var def = tab.searchDefinition;

			if (!def || def._metlifeAdvancedPersistHook) {
				return;
			}

			def._metlifeAdvancedPersistHook = true;

			var self = this;

			/*
			 * Persist the custom Slice/Search Options values before ICN prepares
			 * the template for saving.
			 */
			aspect.before(def, "_updateSearchTemplate", function() {
				self._persistAdvancedState(state);
			});

			/*
			 * ICN may update or replace fields inside _updateSearchTemplate.
			 * Reapply the custom values to the exact returned template.
			 */
			aspect.after(def, "_updateSearchTemplate", function(searchTemplate) {
				self._persistAdvancedState(
					state,
					searchTemplate || def.searchTemplate
				);
				var persistedTemplate = searchTemplate || def.searchTemplate;
				if (persistedTemplate) {
					console.log(LOG, "Serialized custom advanced state", {
						searchType: persistedTemplate._metlifeAdvancedSearchType ||
							(state.controlsWidget && state.controlsWidget.getSearchType()),
						application: persistedTemplate.application,
						moreOptionsSearchType: persistedTemplate.moreOptions &&
							persistedTemplate.moreOptions.metlifeSearchType
					});
				}

				return searchTemplate;
			});
		},

		_installAdvancedSearchRestoreHooks: function(tab, state, tabKey) {
			var def = tab.searchDefinition;
			if (!def || def._metlifeAdvancedRestoreHook) {
				return;
			}
			def._metlifeAdvancedRestoreHook = true;
			def._metlifeAdvancedTabKey = tabKey;
			var self = this;
			var restoreSavedControls = function() {
				if (self._isNewSearchTemplate(def)) {
					return;
				}
				self._restoreSavedCustomControls(tabKey);
			};
			if (def.onLoad) {
				aspect.after(def, "onLoad", function() {
					restoreSavedControls();
				});
			}
			if (!this._isNewSearchTemplate(def) && def._loaded) {
				restoreSavedControls();
			}
			aspect.after(def, "onSearchSaved", function(savedTemplate) {
				if (savedTemplate) {
					state.restoredTemplateId =
						self._getTemplateIdentity(savedTemplate);

					/*
					 * Keep the custom search type on the SearchTemplate object
					 * returned by ICN.
					 */
					if (state.controlsWidget) {
						var searchType =
							state.controlsWidget.getSearchType();

						savedTemplate._metlifeAdvancedSearchType =
							searchType;

						if (!savedTemplate.moreOptions) {
							savedTemplate.moreOptions = {};
						}

						savedTemplate.moreOptions.metlifeSearchType =
							searchType;
					}
				}

				state.controlsRestored = true;

				self._persistAdvancedState(
					state,
					savedTemplate || def.searchTemplate
				);

				return savedTemplate;
			});
		}
