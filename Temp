										.assertCurrentVersionPending(objectStore, requestedDocId);
								mergeExistingPayload(objectStore, currentDocId, payload, callbacks);
								return ReportRequestDocumentHelper.updateReportRequestDocument(objectStore,
										currentDocId, payload);
							}
						});
