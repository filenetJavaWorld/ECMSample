				callbacks.getLogger().logError(this, method, request, e);
				writeFailure(response, request, callbacks, friendlyUpdateError(e));
				return;
			}

			JSONResponse ok = new JSONResponse();
			ok.put("success", true);
			ok.put("reportRequestId", updated.get("reportRequestId"));
			ok.put("documentId", updated.get("documentId"));
			ok.put("message", "Report request updated successfully.");
			PluginResponseUtil.writeJSONResponse(request, response, ok, callbacks, SERVICE_ID);
		} finally {
			callbacks.getLogger().logExit(this, method, request);
		}
	}

	private static void mergeExistingPayload(com.filenet.api.core.ObjectStore objectStore, String documentId,
			JSONObject payload, PluginServiceCallbacks callbacks) throws Exception {
		JSONObject existing = ReportRequestDocumentHelper.loadDocumentJson(objectStore, documentId);
		JSONObject existingRequest = existing.get("reportRequest") instanceof JSONObject
				? (JSONObject) existing.get("reportRequest")
				: new JSONObject();

		if (trimString(payload.get("reportRequestId")) == null) {
			Object rrId = existingRequest.get("reportRequestId");
			if (rrId != null) {
				payload.put("reportRequestId", rrId);
			}
		}
		if (trimString(payload.get("submittedBy")) == null && existingRequest.get("submittedBy") != null) {
			payload.put("submittedBy", existingRequest.get("submittedBy"));
		}
		if (trimString(payload.get("submittedOn")) == null && existingRequest.get("submittedOn") != null) {
			payload.put("submittedOn", existingRequest.get("submittedOn"));
		}

		String userId = callbacks.getUserId() != null ? callbacks.getUserId() : "";
		payload.put("lastUpdatedBy", userId);
		payload.put("lastUpdatedOn", nowIsoUtc());
		payload.put("status", ReportPluginConstants.REPORT_REQUEST_INITIAL_STATUS);
		payload.put("documentId", documentId);
	}

