define([
	"dojo/_base/declare",
	"dojo/_base/array",
	"dojo/_base/lang",
	"dojo/dom-class",
	"ecm/widget/layout/FavoritesPane",
	"ecm/widget/listView/modules/FilterData",
	"dojo/text!./templates/CustomFavoritesFeature.html"
], function(declare, array, lang, domClass, FavoritesPane, FilterData, template) {

	/**
	 * Injects FilterData beside breadcrumb in the Bar module (same pattern as CustomBrowseFeature).
	 */
	function _injectFilterIntoBarModules(modules) {
		if (!modules) {
			return;
		}

		var injected = false;

		array.forEach(modules, function(mod) {
			if (injected || !mod || !mod.top || !mod.moduleClass || !mod.moduleClass.prototype) {
				return;
			}

			if (mod.moduleClass.prototype.name !== "bar") {
				return;
			}

			for (var r = 0; r < mod.top.length; r++) {
				var row = mod.top[r];

				if (!row || !row[0]) {
					continue;
				}

				var breadcrumbIdx = -1;

				for (var c = 0; c < row[0].length; c++) {
					var cell = row[0][c];

					if (cell && cell.moduleClass && cell.moduleClass.prototype &&
						cell.moduleClass.prototype.name === "breadcrumb") {
						breadcrumbIdx = c;
						break;
					}
				}

				if (breadcrumbIdx < 0) {
					continue;
				}

				for (var f = 0; f < row[0].length; f++) {
					var existing = row[0][f];

					if (existing && ((existing.className && existing.className.indexOf("BarFilterData") >= 0) ||
						existing.moduleClass === FilterData)) {
						injected = true;
						return;
					}
				}

				var breadcrumbCell = row[0][breadcrumbIdx];

				if (!breadcrumbCell.className) {
					breadcrumbCell.className = "BarBreadcrumb";
				} else if (breadcrumbCell.className.indexOf("BarBreadcrumb") < 0) {
					breadcrumbCell.className += " BarBreadcrumb";
				}

				row[0].push({
					moduleClass: FilterData,
					"className": "BarFilterData",
					showFilterButton: false,
					isCaseSensitive: false
				});

				injected = true;
				return;
			}
		});
	}

	return declare("searchPluginDojo.CustomFavoritesFeature", [ FavoritesPane ], {

		templateString: template,
		widgetsInTemplate: true,

		postCreate: function() {
			this.inherited(arguments);
			if (this.domNode) {
				domClass.add(this.domNode, "metlifeCustomFavoritesPane");
			}
		},

		/**
		 * Adds client-side FilterData beside the breadcrumb (same UX as Custom Browse).
		 */
		getContentListModules: function() {
			var modules = this.inherited(arguments);
			_injectFilterIntoBarModules(modules);
			return modules;
		},

		/**
		 * Keep the Browse-style client filter visible. OOTB hides FilterDataServer when the
		 * repository does not support server filtering; our FilterData is client-side.
		 */
		_showHideFilter: function() {
			var filterData = this.favoritesContent && this.favoritesContent.getContentListModule("filterData");
			if (filterData && filterData.domNode) {
				domClass.remove(filterData.domNode, "dijitHidden");
			}
		}
	});
});






<div class="ecmCenterPane metlifeCustomFavoritesPane" style="margin-top: 5px;">
	<div data-dojo-type="idx.layout.BorderContainer" data-dojo-attach-point="container" class="contentPane" gutters="false">
		<div data-dojo-type="dijit.layout.ContentPane" region="center" data-dojo-attach-point="contentPane">
			<div data-dojo-attach-point="favoritesContent" data-dojo-type="ecm.widget.listView.ContentList"
				showCheckboxes=true emptyMessage="${messages.folder_is_empty}">
			</div>
			<div data-dojo-attach-point="favoritesContentEmpty" data-dojo-type="dijit.layout.ContentPane">
				<div class="gridxBodyEmpty">${messages.favorites_empty}</div>
			</div>
		</div>
	</div>
</div>





package met.kms.ecm.favorites.feature;

import java.util.Locale;

import com.ibm.ecm.extension.PluginFeature;

/**
 * Custom Favorites feature with Browse-style client-side content list filter.
 */
public class CustomFavoritesFeature extends PluginFeature {

	@Override
	public String getId() {
		return "CustomFavoritesFeature";
	}

	@Override
	public String getName(Locale locale) {
		return "CustomFavoritesFeature";
	}

	@Override
	public String getDescription(Locale locale) {
		return "Favorites with content list filter";
	}

	@Override
	public String getIconUrl() {
		return "favoritesLaunchIcon";
	}

	@Override
	public String getSvgFilePath() {
		return "WebContent/images/BasicSearchIcon.svg";
	}

	@Override
	public String getHelpContext() {
		return null;
	}

	@Override
	public String getFeatureIconTooltipText(Locale locale) {
		return "Favorites";
	}

	@Override
	public String getPopupWindowTooltipText(Locale locale) {
		return "";
	}

	@Override
	public String getContentClass() {
		return "searchPluginDojo.CustomFavoritesFeature";
	}

	@Override
	public boolean isSeparator() {
		return false;
	}

	@Override
	public String getPopupWindowClass() {
		return "";
	}

	@Override
	public boolean isPreLoad() {
		return false;
	}

	@Override
	public String getConfigurationDijitClass() {
		return "searchPluginDojo.FeatureConfigurationPane";
	}
}





.metlifeCustomBrowsePane .ecmContentList .Bar td.BarFilterData .filterData .dijitButton.filterButton {
	display: none;
}

/* Custom Favorites — breadcrumb left, client-side filter right (same bar layout as Custom Browse) */
.metlifeCustomFavoritesPane .ecmContentList table.Bar {
	table-layout: auto;
	width: 100%;
}

.metlifeCustomFavoritesPane .ecmContentList table.Bar td.BarBreadcrumb {
	width: auto;
	vertical-align: middle;
}

.metlifeCustomFavoritesPane .ecmContentList table.Bar td.BarFilterData {
	width: 240px;
	min-width: 240px;
	max-width: 240px;
	white-space: nowrap;
	vertical-align: middle;
	text-align: right;
	padding: 2px 8px 2px 16px;
}

.metlifeCustomFavoritesPane .ecmContentList .Bar .breadcrumbContainer {
	display: block;
	width: auto;
	max-width: none;
	clear: none;
	float: none;
	overflow: hidden;
	visibility: visible;
	min-height: 16px;
}

.metlifeCustomFavoritesPane .ecmContentList .Bar .breadcrumbContainer .breadcrumb {
	display: block;
	visibility: visible;
}

.metlifeCustomFavoritesPane .ecmContentList .Bar td.BarFilterData .filterData {
	display: block;
	width: 220px;
	min-width: 220px;
}

.metlifeCustomFavoritesPane .ecmContentList .Bar td.BarFilterData .ecmFilterTextBox.dijitTextBox {
	float: none;
	display: inline-block;
	width: 210px;
	min-width: 210px;
	max-width: 210px;
	margin: 0;
	box-sizing: border-box;
}

.metlifeCustomFavoritesPane .ecmContentList .Bar td.BarFilterData .filterData .dijitButton.filterButton {
	display: none;
}

