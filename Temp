import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import javax.security.auth.Subject;

import com.filenet.api.admin.IndexJob;
import com.filenet.api.admin.IndexJobSingleItem;
import com.filenet.api.collection.IndexJobItemList;
import com.filenet.api.collection.RepositoryRowSet;
import com.filenet.api.constants.RefreshMode;
import com.filenet.api.core.Connection;
import com.filenet.api.core.Document;
import com.filenet.api.core.Domain;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.property.Properties;
import com.filenet.api.query.RepositoryRow;
import com.filenet.api.query.SearchSQL;
import com.filenet.api.query.SearchScope;
import com.filenet.api.util.Id;
import com.filenet.api.util.UserContext;

/**
 * Java 8 / IBM FileNet CE API utility for IBM Content Search Services (CSS).
 *
 * Supported modes:
 *   REPORT_FAILURES  - export current BaseDocument objects whose propagated
 *                      CmIndexingFailureCode is greater than zero.
 *   REINDEX_FAILURES - find those objects and submit supported single-item
 *                      CSS reindex jobs in controlled batches.
 *   REINDEX_ID_FILE  - reindex GUIDs supplied in a text file (one GUID/line).
 *
 * Important: FileNet has no persisted IsPresentInCss boolean. This utility can
 * report recorded failures and reindex known/suspected documents, but a zero
 * failure code is not proof that an object exists in CSS. Final proof requires
 * a successful CBR CONTAINS query after the asynchronous job finishes.
 */
public final class FileNetCssIndexUtility {

    private enum Mode {
        REPORT_FAILURES,
        REINDEX_FAILURES,
        REINDEX_ID_FILE
    }

    // ---------------------------------------------------------------------
    // Update these values for your environment.
    // Keep production credentials outside source control.
    // ---------------------------------------------------------------------
    private static final String CE_URI =
            "http://your-cpe-host:9080/wsi/FNCEWS40MTOM/";
    private static final String USER_NAME = "your-service-account";
    private static final String PASSWORD = "your-password";
    private static final String STANZA = "FileNetP8WSI";
    private static final String OBJECT_STORE_NAME = "YOUR_OBJECT_STORE";

    private static final String BASE_DOCUMENT_CLASS = "BaseDocument";
    private static final Mode MODE = Mode.REPORT_FAILURES;

    private static final int QUERY_PAGE_SIZE = 500;
    private static final int REINDEX_JOB_BATCH_SIZE = 250;

    private static final String FAILURE_REPORT_FILE =
            "css_indexing_failures.csv";
    private static final String DOCUMENT_ID_FILE =
            "document_ids.txt";

    private FileNetCssIndexUtility() {
    }

    public static void main(String[] args) {
        UserContext userContext = UserContext.get();

        try {
            Connection connection = Factory.Connection.getConnection(CE_URI);
            Subject subject = UserContext.createSubject(
                    connection, USER_NAME, PASSWORD, STANZA);
            userContext.pushSubject(subject);

            Domain domain = Factory.Domain.fetchInstance(connection, null, null);
            ObjectStore objectStore = Factory.ObjectStore.fetchInstance(
                    domain, OBJECT_STORE_NAME, null);

            System.out.println("Connected to object store: "
                    + objectStore.get_DisplayName());
            System.out.println("Mode: " + MODE);

            switch (MODE) {
            case REPORT_FAILURES:
                reportRecordedFailures(objectStore);
                break;

            case REINDEX_FAILURES:
                reindexRecordedFailures(objectStore);
                break;

            case REINDEX_ID_FILE:
                reindexIdsFromFile(objectStore, DOCUMENT_ID_FILE);
                break;

            default:
                throw new IllegalStateException("Unsupported mode: " + MODE);
            }

            System.out.println("Utility completed successfully.");
        } catch (Exception e) {
            System.err.println("Utility failed: " + e.getMessage());
            e.printStackTrace(System.err);
            System.exit(1);
        } finally {
            if (userContext.getSubject() != null) {
                userContext.popSubject();
            }
        }
    }

    /**
     * Reports failures recorded on current document versions. Failure
     * propagation must be enabled on the object store for this query to be
     * useful.
     */
    private static void reportRecordedFailures(ObjectStore objectStore)
            throws Exception {

        SearchSQL sql = buildFailureQuery();
        SearchScope scope = new SearchScope(objectStore);
        RepositoryRowSet rows = scope.fetchRows(
                sql, Integer.valueOf(QUERY_PAGE_SIZE), null, Boolean.TRUE);

        long count = 0;

        try (PrintWriter writer = new PrintWriter(new BufferedWriter(
                new FileWriter(FAILURE_REPORT_FILE)))) {

            writer.println("DocumentId,DocumentTitle,ClassDescription,"
                    + "DateLastModified,CmIndexingFailureCode");

            Iterator<?> iterator = rows.iterator();
            while (iterator.hasNext()) {
                RepositoryRow row = (RepositoryRow) iterator.next();
                Properties properties = row.getProperties();

                String id = value(properties, "Id");
                String title = value(properties, "DocumentTitle");
                String classDescription = value(properties, "ClassDescription");
                String modified = value(properties, "DateLastModified");
                String failureCode = value(properties, "CmIndexingFailureCode");

                writer.println(csv(id) + "," + csv(title) + ","
                        + csv(classDescription) + "," + csv(modified) + ","
                        + csv(failureCode));

                count++;
                if (count % 1000 == 0) {
                    System.out.println("Reported failures: " + count);
                }
            }
        }

        System.out.println("Total recorded failures: " + count);
        System.out.println("Report: " + FAILURE_REPORT_FILE);
    }

    /**
     * Locates documents having propagated failure codes and submits them for
     * reindexing. A failed document can have a permanent problem such as an
     * encrypted/corrupt file, so review the report before using this in PROD.
     */
    private static void reindexRecordedFailures(ObjectStore objectStore)
            throws Exception {

        SearchScope scope = new SearchScope(objectStore);
        RepositoryRowSet rows = scope.fetchRows(
                buildFailureQuery(),
                Integer.valueOf(QUERY_PAGE_SIZE),
                null,
                Boolean.TRUE);

        List<String> batch = new ArrayList<String>(REINDEX_JOB_BATCH_SIZE);
        long candidates = 0;
        long submitted = 0;
        int jobs = 0;

        Iterator<?> iterator = rows.iterator();
        while (iterator.hasNext()) {
            RepositoryRow row = (RepositoryRow) iterator.next();
            String id = value(row.getProperties(), "Id");
            candidates++;

            if (id != null && id.length() > 0) {
                batch.add(id);
            }

            if (batch.size() >= REINDEX_JOB_BATCH_SIZE) {
                IndexJob job = submitReindexJob(objectStore, batch);
                submitted += batch.size();
                jobs++;
                printSubmittedJob(job, jobs, batch.size());
                batch.clear();
            }
        }

        if (!batch.isEmpty()) {
            IndexJob job = submitReindexJob(objectStore, batch);
            submitted += batch.size();
            jobs++;
            printSubmittedJob(job, jobs, batch.size());
            batch.clear();
        }

        System.out.println("Failure candidates found: " + candidates);
        System.out.println("Documents submitted: " + submitted);
        System.out.println("Index jobs created: " + jobs);
        System.out.println("Jobs are asynchronous. Monitor them in ACCE and "
                + "verify completion with a CBR query.");
    }

    /** Reads one FileNet document GUID per line and submits batch jobs. */
    private static void reindexIdsFromFile(
            ObjectStore objectStore, String inputFile) throws Exception {

        List<String> batch = new ArrayList<String>(REINDEX_JOB_BATCH_SIZE);
        long submitted = 0;
        long invalid = 0;
        int jobs = 0;

        try (BufferedReader reader = new BufferedReader(
                new FileReader(inputFile))) {

            String line;
            while ((line = reader.readLine()) != null) {
                String id = normalizeId(line);

                if (id == null) {
                    if (line.trim().length() > 0
                            && !line.trim().startsWith("#")) {
                        invalid++;
                        System.err.println("Skipping invalid GUID: " + line);
                    }
                    continue;
                }

                batch.add(id);

                if (batch.size() >= REINDEX_JOB_BATCH_SIZE) {
                    IndexJob job = submitReindexJob(objectStore, batch);
                    submitted += batch.size();
                    jobs++;
                    printSubmittedJob(job, jobs, batch.size());
                    batch.clear();
                }
            }
        }

        if (!batch.isEmpty()) {
            IndexJob job = submitReindexJob(objectStore, batch);
            submitted += batch.size();
            jobs++;
            printSubmittedJob(job, jobs, batch.size());
        }

        System.out.println("Documents submitted: " + submitted);
        System.out.println("Invalid lines skipped: " + invalid);
        System.out.println("Index jobs created: " + jobs);
    }

    /**
     * Creates one supported FileNet IndexJob containing single-item requests.
     * Saving the job queues work; it does not synchronously update CSS.
     */
    private static IndexJob submitReindexJob(
            ObjectStore objectStore, List<String> documentIds) {

        IndexJob indexJob = Factory.IndexJob.createInstance(objectStore);
        IndexJobItemList items = Factory.IndexJobItem.createList();

        for (String documentId : documentIds) {
            Document document = Factory.Document.getInstance(
                    objectStore, null, new Id(documentId));

            IndexJobSingleItem item =
                    Factory.IndexJobSingleItem.createInstance(objectStore);
            item.set_SingleItem(document);
            items.add(item);
        }

        indexJob.set_IndexItems(items);
        indexJob.save(RefreshMode.REFRESH);
        return indexJob;
    }

    private static SearchSQL buildFailureQuery() {
        String query =
                "SELECT d.Id, d.DocumentTitle, d.ClassDescription, "
              + "d.DateLastModified, d.CmIndexingFailureCode "
              + "FROM " + BASE_DOCUMENT_CLASS + " d "
              + "WHERE d.IsCurrentVersion = TRUE "
              + "AND d.CmIndexingFailureCode > 0 "
              + "ORDER BY d.Id";

        SearchSQL sql = new SearchSQL();
        sql.setQueryString(query);
        return sql;
    }

    private static void printSubmittedJob(
            IndexJob job, int jobNumber, int itemCount) {
        System.out.println("Submitted job " + jobNumber
                + ", ID=" + job.get_Id()
                + ", items=" + itemCount
                + ", initial status=" + job.get_JobStatus());
    }

    private static String value(Properties properties, String name) {
        if (properties == null || !properties.isPropertyPresent(name)) {
            return "";
        }

        Object value = properties.getObjectValue(name);
        return value == null ? "" : String.valueOf(value);
    }

    private static String csv(String value) {
        if (value == null) {
            return "\"\"";
        }
        return "\"" + value.replace("\"", "\"\"") + "\"";
    }

    private static String normalizeId(String input) {
        if (input == null) {
            return null;
        }

        String value = input.trim();
        if (value.length() == 0 || value.startsWith("#")) {
            return null;
        }

        if (!value.startsWith("{")) {
            value = "{" + value;
        }
        if (!value.endsWith("}")) {
            value = value + "}";
        }

        try {
            new Id(value);
            return value;
        } catch (RuntimeException e) {
            return null;
        }
    }
}
