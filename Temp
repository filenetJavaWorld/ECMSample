package com.cnb.repo.export.excel;

import java.util.List;

import org.apache.poi.ss.usermodel.Cell;
import org.apache.poi.ss.usermodel.Row;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.util.CellRangeAddress;

import com.cnb.repo.export.model.ChoiceItemMetadata;
import com.cnb.repo.export.model.ChoiceListMetadata;

/**
 * Writes a single choice-list worksheet with optional back-link.
 */
public class ChoiceListSheetWriter {

	private static final String[] HEADERS = new String[] {
		"Choice List Display Name",
		"Choice List Symbolic Name",
		"Choice List Data Type",
		"Choice Item Label",
		"Choice Item Value",
		"Parent Choice Label",
		"Parent Choice Value",
		"Choice Level",
		"Choice Path",
		"Description"
	};

	public void write(Workbook workbook, WorkbookStyleFactory styles, String sheetName, ChoiceListMetadata choiceList,
			String backLinkSheetName, String backLinkText) {

		Sheet sheet = workbook.createSheet(sheetName);
		int colCount = HEADERS.length;

		Row titleRow = sheet.createRow(0);
		titleRow.setHeightInPoints(24);
		Cell titleCell = titleRow.createCell(0);
		String titleName = choiceList.getDisplayName() != null && choiceList.getDisplayName().length() > 0
				? choiceList.getDisplayName()
				: choiceList.getSymbolicName();
		titleCell.setCellValue("Choice List: " + (titleName != null ? titleName : ""));
		titleCell.setCellStyle(styles.getTitleStyle());
		for (int c = 1; c < colCount; c++) {
			Cell filler = titleRow.createCell(c);
			filler.setCellStyle(styles.getTitleStyle());
		}
		sheet.addMergedRegion(new CellRangeAddress(0, 0, 0, colCount - 1));

		int headerRowIndex = 1;
		if (backLinkSheetName != null && backLinkSheetName.length() > 0) {
			Row backRow = sheet.createRow(1);
			Cell backCell = backRow.createCell(0);
			HyperlinkUtil.setDocumentLink(workbook, backCell, backLinkSheetName,
					backLinkText != null ? backLinkText : "Back", styles.getHyperlinkStyle(false));
			for (int c = 1; c < colCount; c++) {
				Cell filler = backRow.createCell(c);
				filler.setCellStyle(styles.getDataStyle(false));
			}
			headerRowIndex = 2;
		}

		Row headerRow = sheet.createRow(headerRowIndex);
		headerRow.setHeightInPoints(30);
		for (int c = 0; c < colCount; c++) {
			Cell cell = headerRow.createCell(c);
			cell.setCellValue(HEADERS[c]);
			cell.setCellStyle(styles.getHeaderStyle());
		}

		List<ChoiceItemMetadata> items = choiceList.getItems();
		int rowIndex = headerRowIndex + 1;
		if (items != null) {
			for (int i = 0; i < items.size(); i++) {
				ChoiceItemMetadata item = items.get(i);
				boolean alt = (i % 2) == 1;
				Row row = sheet.createRow(rowIndex++);
				writeCell(row, 0, choiceList.getDisplayName(), styles, alt, false);
				writeCell(row, 1, choiceList.getSymbolicName(), styles, alt, false);
				writeCell(row, 2, choiceList.getDataType(), styles, alt, false);
				writeCell(row, 3, item.getLabel(), styles, alt, false);
				writeCell(row, 4, item.getValue(), styles, alt, false);
				writeCell(row, 5, item.getParentLabel(), styles, alt, false);
				writeCell(row, 6, item.getParentValue(), styles, alt, false);
				Cell levelCell = row.createCell(7);
				levelCell.setCellValue(item.getLevel());
				levelCell.setCellStyle(styles.getDataStyle(alt));
				writeCell(row, 8, item.getPath(), styles, alt, true);
				writeCell(row, 9, item.getDescription(), styles, alt, true);
			}
		}

		int lastDataRow = Math.max(headerRowIndex, rowIndex - 1);
		sheet.setAutoFilter(new CellRangeAddress(headerRowIndex, lastDataRow, 0, colCount - 1));
		sheet.createFreezePane(0, headerRowIndex + 1);
		autosize(sheet, colCount);
	}

	private static void writeCell(Row row, int col, String value, WorkbookStyleFactory styles, boolean alt,
			boolean wrap) {
		Cell cell = row.createCell(col);
		cell.setCellValue(value != null ? value : "");
		cell.setCellStyle(wrap ? styles.getWrapStyle(alt) : styles.getDataStyle(alt));
	}

	private static void autosize(Sheet sheet, int columnCount) {
		for (int c = 0; c < columnCount; c++) {
			sheet.autoSizeColumn(c);
			int width = sheet.getColumnWidth(c);
			int max = 80 * 256;
			if (width > max) {
				sheet.setColumnWidth(c, max);
			} else if (width < 12 * 256) {
				sheet.setColumnWidth(c, 12 * 256);
			}
		}
	}
}
