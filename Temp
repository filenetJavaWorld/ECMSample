			} else if (def._loaded) {
				// Saved search already loaded: restore now.
				this._applyInitialAdvancedControls(tabKey, { initialRestore: true });
			} else if (this._hasPersistedAdvancedSearchType(def.searchTemplate) ||
					(def.searchTemplate && def.searchTemplate.objectType === "folder")) {
				// Criteria still loading — apply radios early when metadata is already present.
				this._restoreSavedSearchTypeControls(tabKey, this._getSavedSearchType(def.searchTemplate));
