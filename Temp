import java.util.Iterator;

import com.filenet.api.admin.PropertyTemplate;
import com.filenet.api.collection.AccessPermissionList;
import com.filenet.api.constants.AccessRight;
import com.filenet.api.constants.AccessType;
import com.filenet.api.constants.RefreshMode;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.security.AccessPermission;

public class PropertyTemplateSecurityUpdater {

    private static final String GROUP_NAME =
            "G_FileNet_CNBObjectStore_Users";

    /*
     * Property Template SYMBOLIC names.
     * Replace these sample values with your actual symbolic names.
     */
    private static final String[] PROPERTY_TEMPLATE_SYMBOLIC_NAMES = {
            "AccountNumber",
            "CustomerNumber",
            "ClaimNumber",
            "PolicyNumber"
    };

    /*
     * ACCE permission group:
     * View properties <Default>
     *
     * Selected rights:
     * 1. View all properties
     * 2. Read permissions
     */
    private static final int VIEW_PROPERTIES_MASK =
            AccessRight.READ_AS_INT
                    | AccessRight.READ_ACL_AS_INT;

    public static void updateSecurity(ObjectStore objectStore) {

        int updated = 0;
        int skipped = 0;
        int failed = 0;

        for (String symbolicName :
                PROPERTY_TEMPLATE_SYMBOLIC_NAMES) {

            try {
                System.out.println(
                        "Processing: " + symbolicName
                );

                PropertyTemplate propertyTemplate =
                        Factory.PropertyTemplate.fetchInstance(
                                objectStore,
                                symbolicName,
                                null
                        );

                AccessPermissionList permissions =
                        propertyTemplate.get_Permissions();

                /*
                 * Check whether this group already has a direct
                 * ALLOW entry.
                 */
                if (groupAlreadyExists(
                        permissions,
                        GROUP_NAME)) {

                    System.out.println(
                            "SKIPPED - Group already exists: "
                                    + symbolicName
                    );

                    skipped++;
                    continue;
                }

                AccessPermission permission =
                        Factory.AccessPermission.createInstance();

                /*
                 * Exact AD group shown in ACCE.
                 */
                permission.set_GranteeName(GROUP_NAME);

                /*
                 * Permission type: Allow
                 */
                permission.set_AccessType(
                        AccessType.ALLOW
                );

                /*
                 * Apply to: This object only
                 */
                permission.set_InheritableDepth(
                        Integer.valueOf(0)
                );

                /*
                 * Permission group:
                 * View properties <Default>
                 *
                 * Includes:
                 * - View all properties
                 * - Read permissions
                 */
                permission.set_AccessMask(
                        VIEW_PROPERTIES_MASK
                );

                permissions.add(permission);

                propertyTemplate.set_Permissions(
                        permissions
                );

                propertyTemplate.save(
                        RefreshMode.REFRESH
                );

                /*
                 * Verify that the group and correct access mask
                 * were actually persisted.
                 */
                propertyTemplate.refresh();

                if (groupExistsWithCorrectPermission(
                        propertyTemplate.get_Permissions(),
                        GROUP_NAME)) {

                    System.out.println(
                            "UPDATED AND VERIFIED: "
                                    + symbolicName
                    );

                    updated++;

                } else {
                    System.err.println(
                            "VERIFICATION FAILED: "
                                    + symbolicName
                    );

                    failed++;
                }

            } catch (Exception exception) {
                failed++;

                System.err.println(
                        "FAILED: "
                                + symbolicName
                                + " - "
                                + exception.getMessage()
                );

                exception.printStackTrace();
            }
        }

        System.out.println();
        System.out.println("========== SUMMARY ==========");
        System.out.println(
                "Total   : "
                        + PROPERTY_TEMPLATE_SYMBOLIC_NAMES.length
        );
        System.out.println("Updated : " + updated);
        System.out.println("Skipped : " + skipped);
        System.out.println("Failed  : " + failed);
        System.out.println("=============================");
    }

    private static boolean groupAlreadyExists(
            AccessPermissionList permissions,
            String groupName) {

        Iterator<?> iterator = permissions.iterator();

        while (iterator.hasNext()) {
            AccessPermission permission =
                    (AccessPermission) iterator.next();

            if (isSameGroup(
                    permission.get_GranteeName(),
                    groupName)
                    && AccessType.ALLOW.equals(
                            permission.get_AccessType())) {

                return true;
            }
        }

        return false;
    }

    private static boolean groupExistsWithCorrectPermission(
            AccessPermissionList permissions,
            String groupName) {

        Iterator<?> iterator = permissions.iterator();

        while (iterator.hasNext()) {
            AccessPermission permission =
                    (AccessPermission) iterator.next();

            if (!isSameGroup(
                    permission.get_GranteeName(),
                    groupName)) {
                continue;
            }

            if (!AccessType.ALLOW.equals(
                    permission.get_AccessType())) {
                continue;
            }

            if (permission.get_InheritableDepth() != 0) {
                continue;
            }

            int actualMask =
                    permission.get_AccessMask();

            if ((actualMask & VIEW_PROPERTIES_MASK)
                    == VIEW_PROPERTIES_MASK) {

                return true;
            }
        }

        return false;
    }

    private static boolean isSameGroup(
            String existingGroup,
            String requiredGroup) {

        return existingGroup != null
                && requiredGroup != null
                && existingGroup.trim().equalsIgnoreCase(
                        requiredGroup.trim()
                );
    }
}
