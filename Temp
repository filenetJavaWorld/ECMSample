package com.cnb.repo.export.excel;

import java.io.ByteArrayOutputStream;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import com.cnb.repo.export.exception.MetadataExportException;
import com.cnb.repo.export.metadata.ChoiceListMetadataProvider;
import com.cnb.repo.export.model.ChoiceListExportRequest;
import com.cnb.repo.export.model.ChoiceListMetadata;
import com.filenet.api.core.ObjectStore;

/**
 * Builds the standalone Choice List Export workbook.
 */
public class ChoiceListWorkbookGenerator {

	public byte[] generate(ObjectStore objectStore, ChoiceListExportRequest request) throws MetadataExportException {
		ChoiceListMetadataProvider provider = new ChoiceListMetadataProvider();
		List<ChoiceListMetadata> choiceLists = new ArrayList<ChoiceListMetadata>();

		if (request.isExportAll()) {
			List<ChoiceListMetadata> all = provider.listAll(objectStore);
			for (ChoiceListMetadata summary : all) {
				choiceLists.add(provider.loadById(objectStore, summary.getId(), true));
			}
		} else {
			for (String id : request.getSelectedChoiceListIds()) {
				choiceLists.add(provider.loadById(objectStore, id, true));
			}
		}

		if (choiceLists.isEmpty()) {
			throw new MetadataExportException("No choice lists were found.");
		}

		XSSFWorkbook workbook = null;
		try {
			workbook = new XSSFWorkbook();
			WorkbookStyleFactory styles = new WorkbookStyleFactory(workbook);
			WorksheetNameUtil nameUtil = new WorksheetNameUtil();
			nameUtil.uniqueName(ChoiceListSummarySheetWriter.SHEET_NAME);

			Map<String, String> sheetById = new LinkedHashMap<String, String>();
			for (ChoiceListMetadata cl : choiceLists) {
				String preferred = cl.getDisplayName() != null && cl.getDisplayName().length() > 0
						? cl.getDisplayName()
						: cl.getSymbolicName();
				sheetById.put(cl.getId(), nameUtil.uniqueName(preferred));
			}

			new ChoiceListSummarySheetWriter().write(workbook, styles, choiceLists, sheetById);

			ChoiceListSheetWriter choiceWriter = new ChoiceListSheetWriter();
			for (ChoiceListMetadata cl : choiceLists) {
				String sheetName = sheetById.get(cl.getId());
				choiceWriter.write(workbook, styles, sheetName, cl, ChoiceListSummarySheetWriter.SHEET_NAME,
						"Back to Choice List Summary");
			}

			ByteArrayOutputStream out = new ByteArrayOutputStream();
			workbook.write(out);
			return out.toByteArray();
		} catch (Exception e) {
			throw new MetadataExportException("The Excel report could not be generated.", e);
		} finally {
			if (workbook != null) {
				try {
					workbook.close();
				} catch (Exception ignore) {
					// ignore
				}
			}
		}
	}
}
