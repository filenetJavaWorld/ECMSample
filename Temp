package com.cnb.reports;

import com.cnb.reports.config.AppConfig;
import com.filenet.api.core.Connection;
import com.filenet.api.core.Domain;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.util.UserContext;
import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;

import javax.security.auth.Subject;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

/**
 * Manages FileNet CE connection using configured service credentials.
 * <ul>
 * <li>Home ObjectStore ({@code filenet.reportRequestObjectStoreName}) — ReportRequest class/instances</li>
 * <li>Target ObjectStore (per request {@code RepositoryName}) — where report SQL runs</li>
 * </ul>
 */
public final class FileNetConnectionManager implements AutoCloseable {

    private static final Logger LOGGER = LogManager.getLogger(FileNetConnectionManager.class);

    private final AppConfig config;
    private final Connection connection;
    private final Subject subject;
    private final Domain domain;
    private final ObjectStore reportRequestObjectStore;
    private final Map<String, ObjectStore> objectStoreCache = new ConcurrentHashMap<>();
    private final ThreadLocal<Boolean> subjectPushed = ThreadLocal.withInitial(() -> Boolean.FALSE);

    public FileNetConnectionManager(AppConfig config) {
        this.config = config;
        LOGGER.info("Connecting to FileNet CE at {}", config.getFileNetUri());
        connection = Factory.Connection.getConnection(config.getFileNetUri());
        subject = UserContext.createSubject(
                connection,
                config.getFileNetUsername(),
                config.getFileNetPassword(),
                config.getFileNetStanza());
        UserContext.get().pushSubject(subject);
        subjectPushed.set(Boolean.TRUE);
        domain = Factory.Domain.fetchInstance(connection, null, null);
        reportRequestObjectStore = Factory.ObjectStore.fetchInstance(
                domain, config.getReportRequestObjectStoreName(), null);
        objectStoreCache.put(reportRequestObjectStore.get_Name(), reportRequestObjectStore);
        LOGGER.info("Connected to domain={} reportRequestHomeObjectStore={}",
                domain.get_Name(), reportRequestObjectStore.get_Name());
    }

    /**
     * Home ObjectStore where ReportRequest documents are stored.
     */
    public ObjectStore getReportRequestObjectStore() {
        return reportRequestObjectStore;
    }

    /**
     * Resolves any ObjectStore by symbolic name (cached), e.g. target store from RepositoryName.
     */
    public ObjectStore getObjectStore(String objectStoreName) {
        if (objectStoreName == null || objectStoreName.trim().isEmpty()) {
            throw new IllegalArgumentException("objectStoreName is required to resolve a FileNet ObjectStore.");
        }
        String key = objectStoreName.trim();
        return objectStoreCache.computeIfAbsent(key, name -> {
            LOGGER.debug("Fetching ObjectStore instance for {}", name);
            return Factory.ObjectStore.fetchInstance(domain, name, null);
        });
    }

    public Domain getDomain() {
        return domain;
    }

    public AppConfig getConfig() {
        return config;
    }

    public void ensureSubjectOnCurrentThread() {
        if (!Boolean.TRUE.equals(subjectPushed.get())) {
            UserContext.get().pushSubject(subject);
            subjectPushed.set(Boolean.TRUE);
        }
    }

    public void clearSubjectOnCurrentThread() {
        if (Boolean.TRUE.equals(subjectPushed.get())) {
            UserContext.get().popSubject();
            subjectPushed.set(Boolean.FALSE);
        }
    }

    public void testConnection() {
        ensureSubjectOnCurrentThread();
        ObjectStore home = getReportRequestObjectStore();
        LOGGER.info("FileNet connection test succeeded. domain={} reportRequestHomeObjectStore={}",
                domain.get_Name(), home.get_Name());
    }

    @Override
    public void close() {
        if (Boolean.TRUE.equals(subjectPushed.get())) {
            UserContext.get().popSubject();
            subjectPushed.set(Boolean.FALSE);
        }
        objectStoreCache.clear();
        LOGGER.info("FileNet connection closed.");
    }
}
