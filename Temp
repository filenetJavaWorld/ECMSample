public class DocumentClassExportRequest {

	private String repositoryId;
	private String objectStoreId;
	private String objectStoreDisplayName;
	private String documentClassSymbolicName;
	private String documentClassDisplayName;
	private boolean includeInheritedProperties = true;
	private boolean exportChoiceListDetails = true;
	private List<String> selectedColumns = new ArrayList<String>();

	public static DocumentClassExportRequest fromJson(JSONObject json) {
		DocumentClassExportRequest req = new DocumentClassExportRequest();
		if (json == null) {
