define([
	"dojo/_base/array",
	"dojo/_base/declare",
	"dojo/_base/lang",
	"dojo/dom-class",
	"dijit/_TemplatedMixin",
	"dijit/_WidgetBase",
	"dijit/_WidgetsInTemplateMixin",
	"dijit/form/Button",
	"dijit/form/CheckBox",
	"dijit/form/Select",
	"ecm/LoggerMixin",
	"ecm/widget/dialog/MessageDialog",
	"dojo/text!./templates/DocumentClassExportTab.html",
	"../model/DocumentClassExportRequest",
	"../services/RepositoryService",
	"../services/DocumentClassService",
	"../services/ExportService",
	"./PropertyOptionsPane",
	"./ExportSummaryPane"
], function(array, declare, lang, domClass, _TemplatedMixin, _WidgetBase, _WidgetsInTemplateMixin, Button, CheckBox,
	Select, LoggerMixin, MessageDialog, template, DocumentClassExportRequest, RepositoryService, DocumentClassService,
	ExportService, PropertyOptionsPane, ExportSummaryPane) {

	var EMPTY_OBJECT_STORE_VALUE = "";
	var EMPTY_DOCUMENT_CLASS_VALUE = "";

	return declare("cNBRepoMetadataExportPluginDojo.widgets.DocumentClassExportTab", [
		_WidgetBase,
		_TemplatedMixin,
		_WidgetsInTemplateMixin,
		LoggerMixin
	], {
		templateString: template,
		widgetsInTemplate: true,

		_objectStores: null,
		_documentClasses: null,
		_selectedObjectStore: null,
		_selectedDocumentClass: null,
		_loadingObjectStores: false,
		_loadingDocumentClasses: false,
		_exporting: false,
		_messageDialog: null,

		postCreate: function() {
			this.logEntry("postCreate");
			this.inherited(arguments);

			this._objectStores = [];
			this._documentClasses = [];

			this.own(this.objectStoreSelect.on("change", lang.hitch(this, "_onObjectStoreChange")));
			this.own(this.documentClassSelect.on("change", lang.hitch(this, "_onDocumentClassChange")));
			this.own(this.includeInheritedCheck.on("change", lang.hitch(this, "_refreshSummaryAndExportState")));
			this.own(this.exportChoiceListsCheck.on("change", lang.hitch(this, "_refreshSummaryAndExportState")));
			// PropertyOptionsPane exposes onSelectionChange; wire it for summary/Export state updates.
			this.propertyOptionsPane.onSelectionChange = lang.hitch(this, "_refreshSummaryAndExportState");
			this.own(this.exportButton.on("click", lang.hitch(this, "_onExportClick")));
			this.own(this.resetButton.on("click", lang.hitch(this, "reset")));

			this._clearDocumentClassOptions("Select an object store first");
			this.documentClassSelect.set("disabled", true);
			this._refreshSummaryAndExportState();

			this.logExit("postCreate");
		},

		destroy: function() {
			if (this._messageDialog) {
				this._messageDialog.destroyRecursive();
				this._messageDialog = null;
			}
			this.inherited(arguments);
		},

		/**
		 * Called when the feature pane loads / becomes visible.
		 */
		loadContent: function() {
			this.logEntry("loadContent");
			this._loadObjectStores();
			this.logExit("loadContent");
		},

		reset: function() {
			this.logEntry("reset");
			this._clearMessages();
			this._selectedObjectStore = null;
			this._selectedDocumentClass = null;
			this._documentClasses = [];

			this.objectStoreSelect.set("value", EMPTY_OBJECT_STORE_VALUE, false);
			this._clearDocumentClassOptions("Select an object store first");
			this.documentClassSelect.set("disabled", true);

			this.propertyOptionsPane.restoreDefaults();
			this.includeInheritedCheck.set("checked", true);
			this.exportChoiceListsCheck.set("checked", true);

			this.exportSummaryPane.reset();
			this._setObjectStoreStatus("");
			this._setDocumentClassStatus("");
			this._refreshSummaryAndExportState();
			this.logExit("reset");
		},

		_loadObjectStores: function() {
			this._loadingObjectStores = true;
			this._setBusy(true);
			this._setObjectStoreStatus("Loading object stores...");
			this._clearMessages();

			var previouslySelectedId = this._selectedObjectStore ? this._selectedObjectStore.repositoryId : null;

			try {
				// Always read live from the current ICN desktop session — never hardcode repositories.
				this._objectStores = RepositoryService.getObjectStores() || [];
			} catch (e) {
				this._objectStores = [];
				this._showError("Unable to retrieve repository information.");
			}

			var options = [
				{
					label: this._objectStores.length ? "— Select Object Store —" : "No object stores available",
					value: EMPTY_OBJECT_STORE_VALUE
				}
			];
			array.forEach(this._objectStores, function(os) {
				options.push(RepositoryService.getObjectStoreOption(os));
			});

			this.objectStoreSelect.set("options", options);

			var stillAvailable = previouslySelectedId && this._findObjectStore(previouslySelectedId);
			if (stillAvailable) {
				this.objectStoreSelect.set("value", previouslySelectedId, false);
				this._selectedObjectStore = stillAvailable;
			} else {
				this._selectedObjectStore = null;
				this._selectedDocumentClass = null;
				this._documentClasses = [];
				this.objectStoreSelect.set("value", EMPTY_OBJECT_STORE_VALUE, false);
				this._clearDocumentClassOptions("Select an object store first");
				this.documentClassSelect.set("disabled", true);
				this._setDocumentClassStatus("");
			}

			if (!this._objectStores.length) {
				this._setObjectStoreStatus("No object stores are available.");
				this._showError("No object stores are available for the current user.");
			} else {
				this._setObjectStoreStatus("");
			}

			this._loadingObjectStores = false;
			this._setBusy(false);
			this._refreshSummaryAndExportState();
		},

		_onObjectStoreChange: function(value) {
			if (this._loadingObjectStores) {
				return;
			}
			this._clearMessages();
			this._selectedDocumentClass = null;
			this._documentClasses = [];
			this._clearDocumentClassOptions("Loading...");

			this._selectedObjectStore = this._findObjectStore(value);
			if (!this._selectedObjectStore) {
				this.documentClassSelect.set("disabled", true);
				this._clearDocumentClassOptions("Select an object store first");
				this._setDocumentClassStatus("");
				this._refreshSummaryAndExportState();
				return;
			}

			this._loadDocumentClasses(this._selectedObjectStore);
		},

		_loadDocumentClasses: function(objectStore) {
			var repository = objectStore && objectStore.repository;
			if (!repository) {
				repository = RepositoryService.getRepositoryById(objectStore && objectStore.repositoryId);
			}
			if (!repository) {
				this._showError("Unable to retrieve repository information.");
				this.documentClassSelect.set("disabled", true);
				this._clearDocumentClassOptions("Unable to load classes");
				this._refreshSummaryAndExportState();
				return;
			}

			this._loadingDocumentClasses = true;
			this._setBusy(true);
			this.documentClassSelect.set("disabled", true);
			this._setDocumentClassStatus("Loading document classes...");

			DocumentClassService.loadCustomDocumentClasses(repository, lang.hitch(this, function(classes, errorMessage) {
				this._loadingDocumentClasses = false;
				this._setBusy(false);

				// Ignore stale responses if object store changed while loading.
				if (!this._selectedObjectStore || this._selectedObjectStore.repositoryId !== objectStore.repositoryId) {
					return;
				}

				if (errorMessage) {
					this._documentClasses = [];
					this._clearDocumentClassOptions("Unable to load classes");
					this.documentClassSelect.set("disabled", true);
					this._setDocumentClassStatus("");
					this._showError(errorMessage);
					this._refreshSummaryAndExportState();
					return;
				}

				this._documentClasses = classes || [];
				var options = [
					{
						label: this._documentClasses.length ? "— Select Document Class —" : "No custom document classes found",
						value: EMPTY_DOCUMENT_CLASS_VALUE
					}
				];
				array.forEach(this._documentClasses, function(dc) {
					options.push({
						label: dc.displayName,
						value: dc.symbolicName
					});
				});
				this.documentClassSelect.set("options", options);
				this.documentClassSelect.set("value", EMPTY_DOCUMENT_CLASS_VALUE, false);
				this.documentClassSelect.set("disabled", false);

				if (!this._documentClasses.length) {
					this._setDocumentClassStatus("No custom document classes were found.");
					this._showInfo("No custom document classes were found.");
				} else {
					this._setDocumentClassStatus("");
				}
				this._refreshSummaryAndExportState();
			}));
		},

		_onDocumentClassChange: function(value) {
			if (this._loadingDocumentClasses) {
				return;
			}
			this._clearMessages();
			this._selectedDocumentClass = this._findDocumentClass(value);
			this._refreshSummaryAndExportState();
		},

		_onExportClick: function() {
			if (this._exporting) {
				return;
			}
			this._clearMessages();

			var validationError = this._validateSelections();
			if (validationError) {
				this._showError(validationError);
				return;
			}

			this._exporting = true;
			this.exportButton.set("disabled", true);
			this._setBusy(true);
			this._showInfo("Generating Excel report...");

			var request = this._buildExportRequest();
			var payload = request.toJSON();
			var repositoryId = payload.repositoryId;

			if (typeof console !== "undefined" && console.log) {
				console.log("[Repository Metadata Export] Document Class Assets Export request:", payload);
			}

			ExportService.exportDocumentClassMetadata(repositoryId, payload, lang.hitch(this, function(response) {
				try {
					ExportService.downloadBase64File(response.base64Content, response.fileName, response.contentType);
					this._showInfo("Report downloaded successfully: " + (response.fileName || "export.xlsx"));
				} catch (e) {
					this._showError("The report download could not be completed.");
				}
				this._exporting = false;
				this._setBusy(false);
				this._refreshSummaryAndExportState();
			}), lang.hitch(this, function(message) {
				this._showError(message || "The Excel report could not be generated.");
				this._exporting = false;
				this._setBusy(false);
				this._refreshSummaryAndExportState();
			}));
		},

		_buildExportRequest: function() {
			var os = this._selectedObjectStore || {};
			var dc = this._selectedDocumentClass || {};
			return new DocumentClassExportRequest({
				repositoryId: os.repositoryId || "",
				objectStoreId: os.objectStoreId || "",
				objectStoreDisplayName: os.displayName || "",
				documentClassSymbolicName: dc.symbolicName || "",
				documentClassDisplayName: dc.displayName || "",
				includeInheritedProperties: !!this.includeInheritedCheck.get("checked"),
				exportChoiceListDetails: !!this.exportChoiceListsCheck.get("checked"),
				selectedColumns: this.propertyOptionsPane.getSelectedColumns()
			});
		},

		_validateSelections: function() {
			if (!this._selectedObjectStore) {
				return "Please select an object store.";
			}
			if (!this._selectedDocumentClass) {
				return "Please select a document class.";
			}
			if (!this.propertyOptionsPane.getSelectedCount()) {
				return "Please select at least one property field.";
			}
			return null;
		},

		_refreshSummaryAndExportState: function() {
			var os = this._selectedObjectStore;
			var dc = this._selectedDocumentClass;
			var fieldCount = this.propertyOptionsPane.getSelectedCount();
			var includeInherited = !!this.includeInheritedCheck.get("checked");
			var exportChoiceLists = !!this.exportChoiceListsCheck.get("checked");

			this.exportSummaryPane.updateSummary({
				objectStoreDisplayName: os ? os.displayName : "—",
				documentClassDisplayName: dc ? dc.displayName : "—",
				selectedFieldsCount: fieldCount,
				includeInheritedProperties: includeInherited,
				exportChoiceListDetails: exportChoiceLists
			});

			var canExport = !this._loadingObjectStores && !this._loadingDocumentClasses && !this._exporting
				&& !!os && !!dc && fieldCount > 0;
			this.exportButton.set("disabled", !canExport);
		},

		_setBusy: function(busy) {
			this.objectStoreSelect.set("disabled", !!busy || this._loadingDocumentClasses);
			if (!busy && !this._loadingDocumentClasses && this._selectedObjectStore) {
				this.documentClassSelect.set("disabled", false);
			}
			this.propertyOptionsPane.setDisabled(!!busy);
			this.includeInheritedCheck.set("disabled", !!busy);
			this.exportChoiceListsCheck.set("disabled", !!busy);
			this.resetButton.set("disabled", !!busy);
			if (busy) {
				this.exportButton.set("disabled", true);
			}
		},

		_findObjectStore: function(repositoryId) {
			if (!repositoryId) {
				return null;
			}
			var found = null;
			array.some(this._objectStores || [], function(os) {
				if (os.repositoryId === repositoryId) {
					found = os;
					return true;
				}
				return false;
			});
			return found;
		},

		_findDocumentClass: function(symbolicName) {
			if (!symbolicName) {
				return null;
			}
			var found = null;
			array.some(this._documentClasses || [], function(dc) {
				if (dc.symbolicName === symbolicName) {
					found = dc;
					return true;
				}
				return false;
			});
			return found;
		},

		_clearDocumentClassOptions: function(placeholderLabel) {
			this.documentClassSelect.set("options", [
				{
					label: placeholderLabel || "— Select Document Class —",
					value: EMPTY_DOCUMENT_CLASS_VALUE
				}
			]);
			this.documentClassSelect.set("value", EMPTY_DOCUMENT_CLASS_VALUE, false);
		},

		_setObjectStoreStatus: function(text) {
			this.objectStoreStatusNode.innerHTML = text || "";
		},

		_setDocumentClassStatus: function(text) {
			this.documentClassStatusNode.innerHTML = text || "";
		},

		_clearMessages: function() {
			this.messageNode.innerHTML = "";
			domClass.remove(this.messageNode, "cnbRmeMessageError cnbRmeMessageInfo");
		},

		_showError: function(message) {
			this.messageNode.innerHTML = message || "";
			domClass.remove(this.messageNode, "cnbRmeMessageInfo");
			domClass.add(this.messageNode, "cnbRmeMessageError");
		},

		_showInfo: function(message) {
			this.messageNode.innerHTML = message || "";
			domClass.remove(this.messageNode, "cnbRmeMessageError");
			domClass.add(this.messageNode, "cnbRmeMessageInfo");
		},

		_showMessageDialog: function(text) {
			if (this._messageDialog) {
				this._messageDialog.destroyRecursive();
				this._messageDialog = null;
			}
			this._messageDialog = new MessageDialog({
				text: text
			});
			this._messageDialog.show();
		}
	});
});
