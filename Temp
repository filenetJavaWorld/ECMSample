define([
	"dojo/_base/array",
	"dojo/_base/declare",
	"dojo/_base/lang",
	"dojo/dom-class",
	"dojo/dom-construct",
	"dojo/dom-style",
	"dojo/on",
	"dijit/_TemplatedMixin",
	"dijit/_WidgetBase",
	"dijit/_WidgetsInTemplateMixin",
	"dijit/form/Button",
	"dijit/form/CheckBox",
	"dijit/form/RadioButton",
	"dijit/form/Select",
	"dijit/form/TextBox",
	"ecm/LoggerMixin",
	"ecm/widget/dialog/MessageDialog",
	"dojo/text!./templates/ChoiceListExportTab.html",
	"../model/ChoiceListExportRequest",
	"../services/RepositoryService",
	"../services/ChoiceListService",
	"../services/ExportService"
], function(array, declare, lang, domClass, domConstruct, domStyle, on, _TemplatedMixin, _WidgetBase,
	_WidgetsInTemplateMixin, Button, CheckBox, RadioButton, Select, TextBox, LoggerMixin, MessageDialog, template,
	ChoiceListExportRequest, RepositoryService, ChoiceListService, ExportService) {

	var EMPTY_OBJECT_STORE_VALUE = "";
	var MODE_ALL = "ALL";
	var MODE_SELECTED = "SELECTED";

	return declare("cNBRepoMetadataExportPluginDojo.widgets.ChoiceListExportTab", [
		_WidgetBase,
		_TemplatedMixin,
		_WidgetsInTemplateMixin,
		LoggerMixin
	], {
		templateString: template,
		widgetsInTemplate: true,

		_objectStores: null,
		_selectedObjectStore: null,
		_choiceLists: null,
		_checkboxesById: null,
		_rowsById: null,
		_loadingObjectStores: false,
		_loadingChoiceLists: false,
		_exporting: false,
		_choiceListsLoadedForRepo: null,
		_messageDialog: null,

		postCreate: function() {
			this.logEntry("postCreate");
			this.inherited(arguments);

			this._objectStores = [];
			this._choiceLists = [];
			this._checkboxesById = {};
			this._rowsById = {};

			this.own(this.objectStoreSelect.on("change", lang.hitch(this, "_onObjectStoreChange")));
			this.own(this.exportAllRadio.on("change", lang.hitch(this, "_onExportModeChange")));
			this.own(this.exportSelectedRadio.on("change", lang.hitch(this, "_onExportModeChange")));
			this.own(this.selectAllButton.on("click", lang.hitch(this, "_selectAllChoiceLists")));
			this.own(this.clearAllButton.on("click", lang.hitch(this, "_clearAllChoiceLists")));
			this.own(this.choiceListFilter.on("change", lang.hitch(this, "_applyChoiceListFilter")));
			var filterNode = this.choiceListFilter.textbox || this.choiceListFilter.focusNode;
			if (filterNode) {
				this.own(on(filterNode, "keyup", lang.hitch(this, "_applyChoiceListFilter")));
				this.own(on(filterNode, "input", lang.hitch(this, "_applyChoiceListFilter")));
			}
			this.own(this.exportButton.on("click", lang.hitch(this, "_onExportClick")));
			this.own(this.resetButton.on("click", lang.hitch(this, "reset")));

			this._setChoiceListPanelVisible(false);
			this._refreshSummaryAndExportState();
			this.logExit("postCreate");
		},

		destroy: function() {
			this._destroyChoiceListCheckboxes();
			if (this._messageDialog) {
				this._messageDialog.destroyRecursive();
				this._messageDialog = null;
			}
			this.inherited(arguments);
		},

		loadContent: function() {
			this.logEntry("loadContent");
			this._loadObjectStores();
			this.logExit("loadContent");
		},

		reset: function() {
			this.logEntry("reset");
			this._clearMessages();
			this._selectedObjectStore = null;
			this._choiceLists = [];
			this._choiceListsLoadedForRepo = null;
			this._destroyChoiceListCheckboxes();
			this.choiceListFilter.set("value", "");

			this.objectStoreSelect.set("value", EMPTY_OBJECT_STORE_VALUE, false);
			this.exportAllRadio.set("checked", true);
			this.exportSelectedRadio.set("checked", false);
			this._setChoiceListPanelVisible(false);
			this._setObjectStoreStatus("");
			this._setChoiceListStatus("");
			this._refreshSummaryAndExportState();
			this.logExit("reset");
		},

		_loadObjectStores: function() {
			this._loadingObjectStores = true;
			this._setBusy(true);
			this._setObjectStoreStatus("Loading object stores...");
			this._clearMessages();

			var previouslySelectedId = this._selectedObjectStore ? this._selectedObjectStore.repositoryId : null;

			try {
				// Always read live from the current ICN desktop session — never hardcode repositories.
				this._objectStores = RepositoryService.getObjectStores() || [];
			} catch (e) {
				this._objectStores = [];
				this._showError("Unable to retrieve repository information.");
			}

			var options = [
				{
					label: this._objectStores.length ? "— Select Object Store —" : "No object stores available",
					value: EMPTY_OBJECT_STORE_VALUE
				}
			];
			array.forEach(this._objectStores, function(os) {
				options.push(RepositoryService.getObjectStoreOption(os));
			});
			this.objectStoreSelect.set("options", options);

			var stillAvailable = previouslySelectedId && this._findObjectStore(previouslySelectedId);
			if (stillAvailable) {
				this.objectStoreSelect.set("value", previouslySelectedId, false);
				this._selectedObjectStore = stillAvailable;
			} else {
				this._selectedObjectStore = null;
				this._choiceLists = [];
				this._choiceListsLoadedForRepo = null;
				this._destroyChoiceListCheckboxes();
				this.choiceListFilter.set("value", "");
				this.objectStoreSelect.set("value", EMPTY_OBJECT_STORE_VALUE, false);
				this._setChoiceListStatus("");
				if (this._getExportMode() === MODE_SELECTED) {
					this._setChoiceListPanelVisible(true);
				}
			}

			if (!this._objectStores.length) {
				this._setObjectStoreStatus("No object stores are available.");
				this._showError("No object stores are available for the current user.");
			} else {
				this._setObjectStoreStatus("");
			}

			this._loadingObjectStores = false;
			this._setBusy(false);
			this._refreshSummaryAndExportState();
		},

		_onObjectStoreChange: function(value) {
			if (this._loadingObjectStores) {
				return;
			}
			this._clearMessages();
			this._selectedObjectStore = this._findObjectStore(value);
			this._choiceLists = [];
			this._choiceListsLoadedForRepo = null;
			this._destroyChoiceListCheckboxes();
			this.choiceListFilter.set("value", "");
			this._setChoiceListStatus("");

			if (this._getExportMode() === MODE_SELECTED && this._selectedObjectStore) {
				this._setChoiceListPanelVisible(true);
				this._loadChoiceLists(this._selectedObjectStore);
			} else {
				this._setChoiceListPanelVisible(this._getExportMode() === MODE_SELECTED);
				this._refreshSummaryAndExportState();
			}
		},

		_onExportModeChange: function() {
			// RadioButton fires change for both checked and unchecked; act only on the checked one.
			if (!this.exportAllRadio.get("checked") && !this.exportSelectedRadio.get("checked")) {
				return;
			}
			this._clearMessages();
			var mode = this._getExportMode();
			if (mode === MODE_SELECTED) {
				this._setChoiceListPanelVisible(true);
				if (this._selectedObjectStore) {
					if (this._choiceListsLoadedForRepo !== this._selectedObjectStore.repositoryId) {
						this._loadChoiceLists(this._selectedObjectStore);
					} else {
						this._refreshSummaryAndExportState();
					}
				} else {
					this._setChoiceListStatus("Select an object store to load choice lists.");
					this._refreshSummaryAndExportState();
				}
			} else {
				this._setChoiceListPanelVisible(false);
				this._refreshSummaryAndExportState();
			}
		},

		_loadChoiceLists: function(objectStore) {
			if (!objectStore || !objectStore.repositoryId) {
				this._showError("Please select an object store.");
				return;
			}

			this._loadingChoiceLists = true;
			this._setBusy(true);
			this._setChoiceListStatus("Loading choice lists...");
			this._destroyChoiceListCheckboxes();

			ChoiceListService.listChoiceLists(objectStore.repositoryId, lang.hitch(this, function(choiceLists) {
				this._loadingChoiceLists = false;
				this._setBusy(false);

				if (!this._selectedObjectStore
					|| this._selectedObjectStore.repositoryId !== objectStore.repositoryId
					|| this._getExportMode() !== MODE_SELECTED) {
					return;
				}

				this._choiceLists = choiceLists || [];
				this._choiceListsLoadedForRepo = objectStore.repositoryId;
				this._renderChoiceListCheckboxes();

				if (!this._choiceLists.length) {
					this._setChoiceListStatus("No choice lists were found.");
					this._showInfo("No choice lists were found.");
				} else {
					this._setChoiceListStatus(this._choiceLists.length + " choice list(s) available.");
				}
				this._refreshSummaryAndExportState();
			}), lang.hitch(this, function(message) {
				this._loadingChoiceLists = false;
				this._setBusy(false);
				if (!this._selectedObjectStore
					|| this._selectedObjectStore.repositoryId !== objectStore.repositoryId) {
					return;
				}
				this._choiceLists = [];
				this._choiceListsLoadedForRepo = null;
				this._setChoiceListStatus("");
				this._showError(message || "Unable to retrieve choice-list metadata.");
				this._refreshSummaryAndExportState();
			}));
		},

		_renderChoiceListCheckboxes: function() {
			this._destroyChoiceListCheckboxes();
			domConstruct.empty(this.choiceListContainer);
			this.choiceListFilter.set("value", "");
			domStyle.set(this.filterEmptyNode, "display", "none");

			array.forEach(this._choiceLists, lang.hitch(this, function(cl) {
				if (!cl || !cl.id) {
					return;
				}
				var row = domConstruct.create("div", {
					"class": "cnbRmeCheckboxRow"
				}, this.choiceListContainer);
				var cb = new CheckBox({
					checked: false,
					value: cl.id
				});
				this.own(cb);
				cb.placeAt(row);
				this.own(cb.on("change", lang.hitch(this, "_refreshSummaryAndExportState")));

				var displayName = cl.displayName || "";
				var symbolicName = cl.symbolicName || "";
				var labelText = displayName || symbolicName || cl.id;
				if (symbolicName && displayName && symbolicName !== displayName) {
					labelText = displayName + " (" + symbolicName + ")";
				}
				domConstruct.create("label", {
					"for": cb.id,
					innerHTML: this._escape(labelText),
					"class": "cnbRmeCheckboxLabel"
				}, row);

				this._checkboxesById[cl.id] = cb;
				this._rowsById[cl.id] = {
					node: row,
					searchText: (displayName + " " + symbolicName + " " + cl.id).toLowerCase(),
					visible: true
				};
			}));
			this._updateFilterStatus();
		},

		_destroyChoiceListCheckboxes: function() {
			if (this._checkboxesById) {
				array.forEach(Object.keys(this._checkboxesById), lang.hitch(this, function(id) {
					var cb = this._checkboxesById[id];
					if (cb && !cb._destroyed) {
						cb.destroyRecursive();
					}
				}));
			}
			this._checkboxesById = {};
			this._rowsById = {};
			if (this.choiceListContainer) {
				domConstruct.empty(this.choiceListContainer);
			}
			if (this.filterEmptyNode) {
				domStyle.set(this.filterEmptyNode, "display", "none");
			}
		},

		_applyChoiceListFilter: function() {
			var filterText = "";
			if (this.choiceListFilter) {
				filterText = (this.choiceListFilter.get("value") || "").toString().toLowerCase().replace(/^\s+|\s+$/g, "");
			}
			var visibleCount = 0;
			array.forEach(Object.keys(this._rowsById || {}), lang.hitch(this, function(id) {
				var rowInfo = this._rowsById[id];
				if (!rowInfo || !rowInfo.node) {
					return;
				}
				var matches = !filterText || rowInfo.searchText.indexOf(filterText) !== -1;
				rowInfo.visible = matches;
				if (matches) {
					domClass.remove(rowInfo.node, "cnbRmeChoiceListRowHidden");
					visibleCount++;
				} else {
					domClass.add(rowInfo.node, "cnbRmeChoiceListRowHidden");
				}
			}));

			var hasRows = Object.keys(this._rowsById || {}).length > 0;
			domStyle.set(this.filterEmptyNode, "display", (hasRows && visibleCount === 0) ? "" : "none");
			this._updateFilterStatus(visibleCount, filterText);
		},

		_updateFilterStatus: function(visibleCount, filterText) {
			if (!this._choiceLists || !this._choiceLists.length) {
				return;
			}
			if (visibleCount == null) {
				visibleCount = Object.keys(this._rowsById || {}).length;
			}
			if (filterText == null && this.choiceListFilter) {
				filterText = (this.choiceListFilter.get("value") || "").toString().replace(/^\s+|\s+$/g, "");
			}
			var total = this._choiceLists.length;
			if (filterText) {
				this._setChoiceListStatus("Showing " + visibleCount + " of " + total + " choice list(s).");
			} else {
				this._setChoiceListStatus(total + " choice list(s) available.");
			}
		},

		_getVisibleChoiceListIds: function() {
			var ids = [];
			array.forEach(Object.keys(this._rowsById || {}), lang.hitch(this, function(id) {
				if (this._rowsById[id] && this._rowsById[id].visible) {
					ids.push(id);
				}
			}));
			return ids;
		},

		_selectAllChoiceLists: function() {
			// Select currently visible (filtered) items only.
			array.forEach(this._getVisibleChoiceListIds(), lang.hitch(this, function(id) {
				if (this._checkboxesById[id]) {
					this._checkboxesById[id].set("checked", true);
				}
			}));
			this._refreshSummaryAndExportState();
		},

		_clearAllChoiceLists: function() {
			// Clear currently visible (filtered) items only.
			array.forEach(this._getVisibleChoiceListIds(), lang.hitch(this, function(id) {
				if (this._checkboxesById[id]) {
					this._checkboxesById[id].set("checked", false);
				}
			}));
			this._refreshSummaryAndExportState();
		},

		_getSelectedChoiceListIds: function() {
			var ids = [];
			array.forEach(Object.keys(this._checkboxesById || {}), lang.hitch(this, function(id) {
				if (this._checkboxesById[id].get("checked")) {
					ids.push(id);
				}
			}));
			return ids;
		},

		_onExportClick: function() {
			if (this._exporting) {
				return;
			}
			this._clearMessages();

			var validationError = this._validateSelections();
			if (validationError) {
				this._showError(validationError);
				return;
			}

			this._exporting = true;
			this.exportButton.set("disabled", true);
			this._setBusy(true);
			this._showInfo("Generating Excel report...");

			var request = this._buildExportRequest();
			var payload = request.toJSON();

			if (typeof console !== "undefined" && console.log) {
				console.log("[Repository Metadata Export] Choice List Export request:", payload);
			}

			ExportService.exportChoiceLists(payload.repositoryId, payload, lang.hitch(this, function(response) {
				try {
					ExportService.downloadBase64File(response.base64Content, response.fileName, response.contentType);
					this._showInfo("Report downloaded successfully: " + (response.fileName || "export.xlsx"));
				} catch (e) {
					this._showError("The report download could not be completed.");
				}
				this._exporting = false;
				this._setBusy(false);
				this._refreshSummaryAndExportState();
			}), lang.hitch(this, function(message) {
				this._showError(message || "The Excel report could not be generated.");
				this._exporting = false;
				this._setBusy(false);
				this._refreshSummaryAndExportState();
			}));
		},

		_buildExportRequest: function() {
			var os = this._selectedObjectStore || {};
			var mode = this._getExportMode();
			return new ChoiceListExportRequest({
				repositoryId: os.repositoryId || "",
				objectStoreId: os.objectStoreId || "",
				objectStoreDisplayName: os.displayName || "",
				exportMode: mode,
				selectedChoiceListIds: mode === MODE_SELECTED ? this._getSelectedChoiceListIds() : []
			});
		},

		_validateSelections: function() {
			if (!this._selectedObjectStore) {
				return "Please select an object store.";
			}
			if (this._getExportMode() === MODE_SELECTED) {
				if (!this._getSelectedChoiceListIds().length) {
					return "Please select at least one choice list.";
				}
			}
			return null;
		},

		_refreshSummaryAndExportState: function() {
			var os = this._selectedObjectStore;
			var mode = this._getExportMode();
			var selectedCount = this._getSelectedChoiceListIds().length;

			this.summaryObjectStoreNode.innerHTML = this._escape(os ? os.displayName : "—");
			this.summaryModeNode.innerHTML = mode === MODE_SELECTED ? "Select Specific Choice Lists" : "Export All Choice Lists";
			this.summaryCountNode.innerHTML = mode === MODE_ALL ? "All" : String(selectedCount);

			var canExport = !this._loadingObjectStores && !this._loadingChoiceLists && !this._exporting && !!os
				&& (mode === MODE_ALL || selectedCount > 0);
			this.exportButton.set("disabled", !canExport);
		},

		_getExportMode: function() {
			return this.exportSelectedRadio.get("checked") ? MODE_SELECTED : MODE_ALL;
		},

		_setChoiceListPanelVisible: function(visible) {
			domStyle.set(this.choiceListPanelNode, "display", visible ? "" : "none");
			if (this.mainRowNode) {
				domClass.toggle(this.mainRowNode, "cnbRmeClMainAllMode", !visible);
			}
		},

		_setBusy: function(busy) {
			this.objectStoreSelect.set("disabled", !!busy);
			this.exportAllRadio.set("disabled", !!busy);
			this.exportSelectedRadio.set("disabled", !!busy);
			this.choiceListFilter.set("disabled", !!busy);
			this.selectAllButton.set("disabled", !!busy);
			this.clearAllButton.set("disabled", !!busy);
			this.resetButton.set("disabled", !!busy);
			array.forEach(Object.keys(this._checkboxesById || {}), lang.hitch(this, function(id) {
				this._checkboxesById[id].set("disabled", !!busy);
			}));
			if (busy) {
				this.exportButton.set("disabled", true);
			}
		},

		_findObjectStore: function(repositoryId) {
			if (!repositoryId) {
				return null;
			}
			var found = null;
			array.some(this._objectStores || [], function(os) {
				if (os.repositoryId === repositoryId) {
					found = os;
					return true;
				}
				return false;
			});
			return found;
		},

		_setObjectStoreStatus: function(text) {
			this.objectStoreStatusNode.innerHTML = text || "";
		},

		_setChoiceListStatus: function(text) {
			this.choiceListStatusNode.innerHTML = text || "";
		},

		_clearMessages: function() {
			this.messageNode.innerHTML = "";
			domClass.remove(this.messageNode, "cnbRmeMessageError cnbRmeMessageInfo");
		},

		_showError: function(message) {
			this.messageNode.innerHTML = message || "";
			domClass.remove(this.messageNode, "cnbRmeMessageInfo");
			domClass.add(this.messageNode, "cnbRmeMessageError");
		},

		_showInfo: function(message) {
			this.messageNode.innerHTML = message || "";
			domClass.remove(this.messageNode, "cnbRmeMessageError");
			domClass.add(this.messageNode, "cnbRmeMessageInfo");
		},

		_showMessageDialog: function(text) {
			if (this._messageDialog) {
				this._messageDialog.destroyRecursive();
				this._messageDialog = null;
			}
			this._messageDialog = new MessageDialog({
				text: text
			});
			this._messageDialog.show();
		},

		_escape: function(value) {
			if (value == null) {
				return "";
			}
			return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
		}
	});
});
