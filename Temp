		_applyInitialAdvancedControls: function(tabKey, refreshOptions) {
			refreshOptions = refreshOptions || {};
			var state = this._tabStateByKey[tabKey];
			if (!state || !state.controlsWidget) {
				return;
			}
			if (state.userControlsActive && !refreshOptions.templateChanged) {
				return;
			}
			if (state.controlsRestored && !refreshOptions.templateChanged) {
				return;
			}
			var def = state.def;
			var template = def && def.searchTemplate;
			var isNew = this._isNewSearchTemplate(def);
			var slices = this._getOrderedSlices();
			var setupOptions = {
				searchType: "both",
				syncOnly: false,
				skipAutoSelect: false
			};

			if (isNew) {
				// New / unsaved search: default Search Options to Both.
				var defaultSlice = this._getDefaultNewSearchSlice();
				if (defaultSlice && defaultSlice.folderId) {
					setupOptions.selectedValue = defaultSlice.folderId;
				} else {
					setupOptions.defaultLabel = "Enterprise";
				}
			} else {
				// Saved search: restore previously saved Documents / Folders / Both.
				setupOptions.searchType = this._getSavedSearchType(template);
				var matchedSlice = this._findSliceMatchingSearchInFolder(template, def);
				if (matchedSlice && matchedSlice.folderId) {
					setupOptions.selectedValue = matchedSlice.folderId;
					setupOptions.syncOnly = true;
				} else {
					// Slice may not match config yet (criteria still loading). Still restore
					// search type radios so saved Documents/Folders do not flash as Both.
					this._restoreSavedSearchTypeControls(tabKey, setupOptions.searchType);
					return;
				}
			}

			var applySearchTypeUi = !isNew && setupOptions.searchType !== "both";
			setupOptions.onSelectComplete = lang.hitch(this, function(success) {
				if (success) {
					var value = state.controlsWidget.getSelectedSliceValue();
					if (setupOptions.syncOnly) {
						state.sliceValue = value;
						state.selectedSlice = this._getSliceByValue(value);
						state._lastSliceResolveValue = value ? String(value).trim() : "";
					} else {
						this._onAdvancedSliceSelected(tabKey, value, true);
					}
				}
				if (applySearchTypeUi) {
					var restoredType = setupOptions.searchType;
					var self = this;
					setTimeout(function() {
						self._applyAdvancedSearchTypeUi(tabKey, restoredType);
					}, 500);
				}
			});

			console.log(LOG, "Applying initial advanced controls", {
				tabKey: tabKey,
				isNew: isNew,
				templateChanged: !!refreshOptions.templateChanged,
				searchType: setupOptions.searchType,
				selectedSliceFolderId: setupOptions.selectedValue || null
			});
			state.controlsWidget.setSlices(slices, setupOptions);
			state.controlsRestored = true;
		},
		
		/**
		 * Restores only the custom Search Options radios + OOTB object-type UI for a saved search.
		 * Used when slice restore cannot run yet (or Search In folder is not in slice config).
