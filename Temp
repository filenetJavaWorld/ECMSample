package com.cnb.reports.mail;

import com.cnb.reports.constants.ReportPluginConstants;
import com.ibm.json.java.JSONArray;
import com.ibm.json.java.JSONObject;

/**
 * Validates and normalizes email fields on report request payloads.
 */
public final class ReportEmailPayloadUtil {

	private ReportEmailPayloadUtil() {
	}

	public static boolean isSendEmailEnabled(JSONObject payload) {
		return resolveSendEmails(payload);
	}

	public static String validatePayloadEmails(JSONObject payload) {
		if (!resolveSendEmails(payload)) {
			return null;
		}
		String invalid = firstInvalidField(payload, ReportPluginConstants.JSON_SEND_EMAIL_TO);
		if (invalid != null) {
			return invalid;
		}
		invalid = firstInvalidField(payload, ReportPluginConstants.JSON_SEND_EMAIL_CC);
		if (invalid != null) {
			return invalid;
		}
		return firstInvalidField(payload, "sendEmailCc");
	}

	public static void normalizePayloadEmails(JSONObject payload) {
		boolean sendEmails = resolveSendEmails(payload);
		payload.put(ReportPluginConstants.JSON_SEND_EMAILS, sendEmails ? Boolean.TRUE : Boolean.FALSE);
		payload.remove("sendEmail");
		if (!sendEmails) {
			payload.put(ReportPluginConstants.JSON_SEND_EMAIL_TO, new JSONArray());
			payload.put(ReportPluginConstants.JSON_SEND_EMAIL_CC, new JSONArray());
			payload.remove("sendEmailCc");
			return;
		}
		putNormalizedArray(payload, ReportPluginConstants.JSON_SEND_EMAIL_TO,
				readRawEmails(payload, ReportPluginConstants.JSON_SEND_EMAIL_TO));
		java.util.List<String> cc = readRawEmails(payload, ReportPluginConstants.JSON_SEND_EMAIL_CC);
		if (cc.isEmpty()) {
			cc = readRawEmails(payload, "sendEmailCc");
		}
		putNormalizedArray(payload, ReportPluginConstants.JSON_SEND_EMAIL_CC, cc);
		payload.remove("sendEmailCc");
	}

	private static boolean resolveSendEmails(JSONObject payload) {
		if (payload == null) {
			return true;
		}
		Object raw = payload.get(ReportPluginConstants.JSON_SEND_EMAILS);
		if (raw == null) {
			raw = payload.get("sendEmail");
		}
		if (raw == null) {
			return true;
		}
		if (raw instanceof Boolean) {
			return ((Boolean) raw).booleanValue();
		}
		String text = String.valueOf(raw).trim();
		if (text.length() == 0) {
			return true;
		}
		return "true".equalsIgnoreCase(text) || "yes".equalsIgnoreCase(text) || "1".equals(text);
	}

	private static String firstInvalidField(JSONObject payload, String key) {
		java.util.List<String> emails = readRawEmails(payload, key);
		return EmailValidator.firstInvalid(emails);
	}

	private static java.util.List<String> readRawEmails(JSONObject payload, String key) {
		java.util.List<String> emails = new java.util.ArrayList<String>();
		Object raw = payload.get(key);
		if (raw instanceof JSONArray) {
			JSONArray arr = (JSONArray) raw;
			for (int i = 0; i < arr.size(); i++) {
				Object value = arr.get(i);
				if (value != null) {
					emails.add(String.valueOf(value));
				}
			}
		} else if (raw instanceof String) {
			emails.addAll(EmailValidator.parseSemicolonSeparated((String) raw));
		}
		return emails;
	}

	private static void putNormalizedArray(JSONObject payload, String key, java.util.List<String> rawEmails) {
		java.util.List<String> normalized = EmailValidator.normalizeList(rawEmails);
		JSONArray arr = new JSONArray();
		for (int i = 0; i < normalized.size(); i++) {
			arr.add(normalized.get(i));
		}
		payload.put(key, arr);
	}
}
