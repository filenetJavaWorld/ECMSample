			// Ensure download icon clicks work in this feature's search results grid.
			if (lang.isFunction(tab._getContentListGridModules)) {
				var originalGridModules = lang.hitch(tab, tab._getContentListGridModules);
				tab._getContentListGridModules = function() {
					var modules = originalGridModules() || [];
					var alreadyAdded = false;
					for (var i = 0; i < modules.length; i++) {
						if (modules[i] === ReportRequestDownloadGridModule) {
							alreadyAdded = true;
							break;
						}
					}
					if (!alreadyAdded) {
						modules.push(ReportRequestDownloadGridModule);
					}
					return modules;
				};
			}

			// Same FilterData bar used by ReportsFeatureMainPane ("Filter by report name").
			if (lang.isFunction(tab._getContentListModules)) {
				var originalListModules = lang.hitch(tab, tab._getContentListModules);
				tab._getContentListModules = lang.hitch(this, function() {
					return this._injectFilterDataModule(originalListModules() || []);
				});
			}

			if (tab.searchResults) {
				this.own(this.connect(tab.searchResults, "onBeforeSetResultSet",
					lang.hitch(this, "_configureResultSetFilterColumns")));
				this.own(this.connect(tab.searchResults, "onModulesLoaded",
					lang.hitch(this, "_onSearchFilterModulesLoaded", tab)));
				// Ensure ReportsItemContextMenu is used even if the response filter is skipped.
				this.own(aspect.after(tab.searchResults, "setResultSet", lang.hitch(this, function() {
					this._applyReportsContextMenu(tab.searchResults.getResultSet
						? tab.searchResults.getResultSet()
						: null);
				})));
				this.own(aspect.after(tab.searchResults, "appendResultSet", lang.hitch(this, function() {
					this._applyReportsContextMenu(tab.searchResults.getResultSet
						? tab.searchResults.getResultSet()
						: null);
				})));
			}

			if (!tab.searchForm) {
				return;
			}
			var self = this;
			this.own(aspect.after(tab.searchForm, "onSearchCriteriaLoad", lang.hitch(this, function() {
				self._runInitialSearchAfterCriteriaLoad(tab);
			})));
		},

		_injectFilterDataModule: function(modules) {
			if (!modules || !modules.length) {
				return [ {
					moduleClass: Bar,
					top: [ [ [ {
						moduleClass: FilterData,
						"className": "BarFilterData",
						showFilterButton: false,
						isCaseSensitive: false
					} ] ] ]
				} ];
			}
			array.forEach(modules, function(module) {
				if (!module || !module.top || module._cnbFilterAdded) {
					return;
				}
				module.top.push([ [ {
					moduleClass: FilterData,
					"className": "BarFilterData",
					showFilterButton: false,
					isCaseSensitive: false
				} ] ]);
				module._cnbFilterAdded = true;
			});
			return modules;
		},

