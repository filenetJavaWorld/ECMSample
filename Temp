		_writePersistedSearchType: function(template, searchType, sliceFolderId, sliceLabel) {
			if (!template) {
				return;
			}
			template._metlifeAdvancedSearchType = searchType;
			template._metlifeAdvancedSliceFolderId = sliceFolderId;
			if (sliceLabel) {
				template._metlifeAdvancedSliceLabel = sliceLabel;
