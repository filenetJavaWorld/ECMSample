_applyAdvancedSearchTypeUi: function(tabKey, searchType) {
	var state = this._tabStateByKey[tabKey];

	if (!state || !state.def) {
		return;
	}

	var def = state.def;

	searchType =
		this._normalizeAdvancedSearchType(searchType);

	if (searchType === "folders") {

		/*
		 * IMPORTANT:
		 *
		 * When opening a saved Folder search, ICN has already restored:
		 *   - Folder object type
		 *   - Folder class
		 *   - CBR text
		 *   - Property criteria
		 *   - Operators and values
		 *
		 * Do not select the folder object type or class again.
		 * Re-selecting the class causes ICN to rebuild the criteria
		 * form and clears the restored criteria.
		 */
		if (this._isDefinitionInFolderUiMode(def)) {
			console.log(
				LOG,
				"Folder UI already restored by ICN — preserving saved class and criteria",
				{
					tabKey: tabKey,
					searchType: searchType,
					className:
						def.searchTemplate &&
						def.searchTemplate.className,
					criteriaCount:
						def.searchTemplate &&
						def.searchTemplate.searchCriteria ?
							def.searchTemplate.searchCriteria.length :
							0
				}
			);

			return;
		}

		/*
		 * This section runs only when the user manually changes
		 * Search Options from Documents/Both to Folders.
		 */
		state._cachedDocumentClass =
			this._getSelectedDocumentClass(def) ||
			state._cachedDocumentClass;

		var mappedFolderClassId =
			this._mapDocumentClassToFolderClassId(
				state._cachedDocumentClass
			);

		console.log(LOG, "Applying folders UI mode", {
			documentClass:
				state._cachedDocumentClass &&
				(
					state._cachedDocumentClass.name ||
					state._cachedDocumentClass.id
				),
			mappedFolderClass: mappedFolderClassId
		});

		this._syncOotbSearchType(
			def,
			"folders",
			true
		);

		this._selectContentClassAfterObjectTypeChange(
			def,
			mappedFolderClassId,
			"folder"
		);

		return;
	}

	/*
	 * Documents or Both mode.
	 */
	var restoreClass =
		state._cachedDocumentClass ||
		this._resolveDefaultDocumentClass(def.repository);

	var classId = restoreClass ?
		(restoreClass.id || restoreClass.name) :
		"BaseDocument";

	if (this._isDefinitionInFolderUiMode(def)) {
		console.log(LOG, "Restoring documents UI mode", {
			searchType: searchType,
			classId: classId
		});

		this._syncOotbSearchType(
			def,
			"documents",
			true
		);

		this._selectContentClassAfterObjectTypeChange(
			def,
			classId,
			"document"
		);
	} else {
		/*
		 * ICN has already restored the document class and criteria.
		 * Synchronize the hidden object type without selecting the
		 * document class again.
		 */
		console.log(
			LOG,
			"Keeping documents UI mode and preserving restored criteria",
			{
				searchType: searchType,
				classId: classId
			}
		);

		this._syncOotbSearchType(
			def,
			"documents",
			false
		);
	}
},
