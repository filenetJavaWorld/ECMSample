				// Fill FolderName from DocumentTitle or CBR text when mapping left it empty.
				folderTemplate = self._ensureFolderNameCriterionForBothFolderPhase(def, folderTemplate, documentTemplate);
				if (folderTemplate.setSearchContentClass) {
					folderTemplate.setSearchContentClass(folderClass);
				} else {
					folderTemplate.classes = [ folderClass.id ];
