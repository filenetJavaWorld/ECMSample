package com.cnb.repo.export.metadata;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import com.cnb.repo.export.exception.MetadataExportException;
import com.cnb.repo.export.model.ChoiceItemMetadata;
import com.cnb.repo.export.model.ChoiceListMetadata;
import com.filenet.api.admin.Choice;
import com.filenet.api.admin.ChoiceList;
import com.filenet.api.collection.ChoiceListSet;
import com.filenet.api.constants.PropertyNames;
import com.filenet.api.constants.TypeID;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.util.Id;

/**
 * Loads choice-list metadata from FileNet CE.
 */
public class ChoiceListMetadataProvider {

	public List<ChoiceListMetadata> listAll(ObjectStore objectStore) throws MetadataExportException {
		try {
			objectStore.fetchProperties(new String[] {
				PropertyNames.CHOICE_LISTS
			});
			ChoiceListSet set = objectStore.get_ChoiceLists();
			List<ChoiceListMetadata> results = new ArrayList<ChoiceListMetadata>();
			if (set == null) {
				return results;
			}
			@SuppressWarnings("unchecked")
			Iterator<ChoiceList> it = set.iterator();
			while (it.hasNext()) {
				ChoiceList cl = it.next();
				if (cl != null) {
					results.add(toMetadata(cl, false));
				}
			}
			return results;
		} catch (MetadataExportException e) {
			throw e;
		} catch (Exception e) {
			throw new MetadataExportException("Unable to retrieve choice-list metadata.", e);
		}
	}

	public ChoiceListMetadata loadById(ObjectStore objectStore, String choiceListId, boolean includeItems)
			throws MetadataExportException {
		try {
			if (choiceListId == null || choiceListId.trim().isEmpty()) {
				throw new MetadataExportException("Unable to retrieve choice-list metadata.");
			}
			ChoiceList cl = Factory.ChoiceList.fetchInstance(objectStore, new Id(choiceListId), null);
			return toMetadata(cl, includeItems);
		} catch (MetadataExportException e) {
			throw e;
		} catch (Exception e) {
			throw new MetadataExportException("Unable to retrieve choice-list metadata.", e);
		}
	}

	private ChoiceListMetadata toMetadata(ChoiceList choiceList, boolean includeItems) throws Exception {
		choiceList.fetchProperties(new String[] {
			PropertyNames.ID,
			PropertyNames.DISPLAY_NAME,
			PropertyNames.NAME,
			PropertyNames.DATA_TYPE,
			PropertyNames.HAS_HIERARCHY,
			PropertyNames.CHOICE_VALUES
		});

		ChoiceListMetadata meta = new ChoiceListMetadata();
		meta.setId(choiceList.get_Id() != null ? choiceList.get_Id().toString() : "");
		meta.setDisplayName(safe(choiceList.get_DisplayName()));
		meta.setSymbolicName(safe(choiceList.get_Name()));
		meta.setDataType(formatDataType(choiceList.get_DataType()));
		meta.setHierarchical(Boolean.TRUE.equals(choiceList.get_HasHierarchy()));

		if (includeItems) {
			List<ChoiceItemMetadata> items = new ArrayList<ChoiceItemMetadata>();
			com.filenet.api.collection.ChoiceList values = choiceList.get_ChoiceValues();
			if (values != null) {
				@SuppressWarnings("unchecked")
				Iterator<Choice> it = values.iterator();
				while (it.hasNext()) {
					walkChoice(it.next(), choiceList.get_DataType(), null, null, "", 1, items);
				}
			}
			meta.setItems(items);
		}
		return meta;
	}

	private void walkChoice(Choice choice, TypeID dataType, String parentLabel, String parentValue, String parentPath,
			int level, List<ChoiceItemMetadata> out) {
		if (choice == null) {
			return;
		}

		String label = safe(choice.get_DisplayName());
		String value = extractValue(choice, dataType);
		String path = parentPath == null || parentPath.length() == 0 ? label : parentPath + " > " + label;

		ChoiceItemMetadata item = new ChoiceItemMetadata();
		item.setLabel(label);
		item.setValue(value);
		item.setParentLabel(parentLabel);
		item.setParentValue(parentValue);
		item.setLevel(level);
		item.setPath(path);
		item.setDescription("");
		out.add(item);

		com.filenet.api.collection.ChoiceList children = null;
		try {
			children = choice.get_ChoiceValues();
		} catch (Exception ignore) {
			children = null;
		}
		if (children != null) {
			@SuppressWarnings("unchecked")
			Iterator<Choice> childIt = children.iterator();
			while (childIt.hasNext()) {
				walkChoice(childIt.next(), dataType, label, value, path, level + 1, out);
			}
		}
	}

	private static String extractValue(Choice choice, TypeID dataType) {
		try {
			if (dataType == TypeID.LONG) {
				Integer v = choice.get_ChoiceIntegerValue();
				return v != null ? String.valueOf(v) : "";
			}
		} catch (Exception ignore) {
			// fall through to string
		}
		try {
			String s = choice.get_ChoiceStringValue();
			return s != null ? s : "";
		} catch (Exception e) {
			return "";
		}
	}

	private static String formatDataType(TypeID typeId) {
		if (typeId == null) {
			return "";
		}
		if (typeId == TypeID.STRING) {
			return "String";
		}
		if (typeId == TypeID.LONG) {
			return "Integer";
		}
		return typeId.toString();
	}

	private static String safe(String value) {
		return value != null ? value : "";
	}
}
