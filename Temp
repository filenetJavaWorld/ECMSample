		 * @param {ecm.model.Repository} repository
		 * @param {Function} callback function(classes, errorMessage)
		 *   classes: [{ id, symbolicName, displayName, contentClass }]
		 */
		loadCustomDocumentClasses: function(repository, callback) {
			callback = callback || function() {
			};

			if (!repository) {
				callback([], "Unable to retrieve repository information.");
				return;
			}
			if (repository.type !== "p8") {
				callback([], "Only FileNet P8 repositories are supported.");
				return;
			}
			if (!repository.connected) {
				callback([], "The selected object store is not connected. Please sign in to the repository.");
				return;
			}

			var documentClass;
			try {
				documentClass = repository.getContentClass("Document");
			} catch (e) {
				callback([], "Unable to retrieve repository information.");
				return;
			}
			if (!documentClass) {
				callback([], "Unable to retrieve repository information.");
				return;
			}

			this._collectSubClasses(documentClass, lang.hitch(this, function(allClasses, errorMessage) {
				if (errorMessage) {
					callback([], errorMessage);
					return;
				}
				var custom = [];
				var seen = {};
				array.forEach(allClasses || [], function(cc) {
					if (!cc || !cc.id || seen[cc.id]) {
						return;
					}
					seen[cc.id] = true;
					if (OOTB_DOCUMENT_CLASS_IDS[cc.id]) {
						return;
					}
					custom.push({
						id: cc.id,
						symbolicName: cc.id,
						displayName: cc.name || cc.id,
						contentClass: cc
					});
				});
				custom.sort(function(a, b) {
					return (a.displayName || "").localeCompare(b.displayName || "", undefined, {
						sensitivity: "base"
					});
				});
				callback(custom, null);
			}));
		},

		/**
		 * Recursively collects subclasses under the given root content class.
		 */
		_collectSubClasses: function(rootClass, callback) {
			var collected = [];
			var pending = 1;
			var failed = false;
			var self = this;

			function doneOne() {
				pending--;
				if (pending <= 0 && !failed) {
					callback(collected, null);
				}
			}

			function fail(message) {
				if (failed) {
					return;
				}
				failed = true;
				callback([], message || "Unable to retrieve repository information.");
			}

			function walk(contentClass) {
				try {
					contentClass.retrieveSubClasses(function(subClasses) {
						if (failed) {
							return;
						}
						array.forEach(subClasses || [], function(sub) {
							if (!sub || !sub.id) {
								return;
							}
							collected.push(sub);
							pending++;
							walk(sub);
						});
						doneOne();
					});
				} catch (e) {
					fail("Unable to retrieve repository information.");
				}
			}

			walk(rootClass);
		}
	};

	return DocumentClassService;
});
