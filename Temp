		}
		req.repositoryId = asString(json.get("repositoryId"));
		req.objectStoreId = asString(json.get("objectStoreId"));
		req.objectStoreDisplayName = asString(json.get("objectStoreDisplayName"));
		req.documentClassSymbolicName = asString(json.get("documentClassSymbolicName"));
		req.documentClassDisplayName = asString(json.get("documentClassDisplayName"));
		req.includeInheritedProperties = asBoolean(json.get("includeInheritedProperties"), true);
		req.exportChoiceListDetails = asBoolean(json.get("exportChoiceListDetails"), true);
		Object cols = json.get("selectedColumns");
		if (cols instanceof JSONArray) {
			JSONArray arr = (JSONArray) cols;
			for (int i = 0; i < arr.size(); i++) {
				String col = asString(arr.get(i));
				if (col != null && col.length() > 0) {
					req.selectedColumns.add(col);
				}
			}
		}
		return req;
	}

	public void validate() throws IllegalArgumentException {
		if (isBlank(repositoryId)) {
			throw new IllegalArgumentException("Please select an object store.");
		}
		if (isBlank(documentClassSymbolicName)) {
			throw new IllegalArgumentException("Please select a document class.");
		}
		if (selectedColumns == null || selectedColumns.isEmpty()) {
			throw new IllegalArgumentException("Please select at least one property field.");
		}
	}

	private static String asString(Object o) {
		if (o == null) {
			return null;
		}
		String s = String.valueOf(o).trim();
		return s.length() == 0 ? null : s;
	}

	private static boolean asBoolean(Object o, boolean defaultValue) {
		if (o == null) {
			return defaultValue;
		}
		if (o instanceof Boolean) {
			return ((Boolean) o).booleanValue();
		}
		String s = String.valueOf(o).trim();
		if ("true".equalsIgnoreCase(s) || "1".equals(s) || "yes".equalsIgnoreCase(s)) {
			return true;
		}
		if ("false".equalsIgnoreCase(s) || "0".equals(s) || "no".equalsIgnoreCase(s)) {
			return false;
		}
		return defaultValue;
	}

	private static boolean isBlank(String s) {
		return s == null || s.trim().isEmpty();
	}

