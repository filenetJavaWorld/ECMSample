package met.kms.ecm.base.filters;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Iterator;
import java.util.Locale;
import java.util.TimeZone;

import javax.servlet.http.HttpServletRequest;

import com.filenet.api.collection.VersionableSet;
import com.filenet.api.constants.PropertyNames;
import com.filenet.api.core.Document;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.core.VersionSeries;
import com.filenet.api.property.PropertyFilter;
import com.filenet.api.util.Id;
import com.ibm.ecm.extension.PluginResponseFilter;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.json.java.JSONArray;
import com.ibm.json.java.JSONObject;

public class OpenItemResponseFilter extends PluginResponseFilter {

	private static final String TARGET_DESKTOP_ID = "MSR";
	private static final String TARGET_CLASS_NAME = "BaseDocument";

	private static final String SYS_CREATOR = "Creator";
	private static final String SYS_DATE_CREATED = "DateCreated";

	@Override
	public String[] getFilteredServices() {
		return new String[] { "/p8/openItem" };
	}

	@Override
	public void filter(String serverType, PluginServiceCallbacks callbacks, HttpServletRequest request,
			JSONObject jsonResponse) throws Exception {

		try {
			System.out.println("OpenItemResponseFilter started");

			if (jsonResponse == null) {
				return;
			}

			String desktopId = request.getParameter("desktop");
			if (!TARGET_DESKTOP_ID.equalsIgnoreCase(desktopId)) {
				return;
			}

			String templateName = getStringValue(jsonResponse, "template_name");
			if (isEmpty(templateName)) {
				templateName = request.getParameter("template_name");
			}
			if (!TARGET_CLASS_NAME.equalsIgnoreCase(templateName)) {
				return;
			}

			Object systemPropsObj = jsonResponse.get("systemProperties");
			if (!(systemPropsObj instanceof JSONArray)) {
				System.out.println("systemProperties is missing or not a JSONArray.");
				return;
			}

			JSONArray systemProperties = (JSONArray) systemPropsObj;
			ObjectStore os = callbacks.getP8ObjectStore(callbacks.getRepositoryId());

			updateSystemPropertiesFromVersionOne(os, request, jsonResponse, systemProperties);

			System.out.println("OpenItemResponseFilter completed");
		} catch (Exception e) {
			System.out.println("OpenItemResponseFilter failed.");
			e.printStackTrace();
		}
	}

	/**
	 * Retrieves FileNet version 1.0 and copies Creator and DateCreated onto the
	 * ICN systemProperties response.
	 */
	private void updateSystemPropertiesFromVersionOne(ObjectStore os, HttpServletRequest request,
			JSONObject jsonResponse, JSONArray systemProperties) {

		try {
			String itemId = resolveItemId(request, jsonResponse);
			if (isEmpty(itemId)) {
				System.out.println("Document id is not present. Unable to retrieve version 1.0.");
				return;
			}

			String documentGuid = parseDocumentGuid(itemId);
			System.out.println("OpenItem itemId: " + itemId);
			System.out.println("OpenItem document GUID: " + documentGuid);

			PropertyFilter documentFilter = new PropertyFilter();
			documentFilter.addIncludeProperty(0, null, null, PropertyNames.ID, null);
			documentFilter.addIncludeProperty(0, null, null, PropertyNames.VERSION_SERIES, null);

			Document currentDocument = Factory.Document.fetchInstance(os, new Id(documentGuid), documentFilter);
			VersionSeries versionSeries = currentDocument.get_VersionSeries();
			if (versionSeries == null) {
				System.out.println("VersionSeries is not available for document: " + documentGuid);
				return;
			}

			PropertyFilter versionsFilter = new PropertyFilter();
			versionsFilter.addIncludeProperty(0, null, null, PropertyNames.VERSIONS, null);
			versionsFilter.addIncludeProperty(1, null, null, PropertyNames.ID, null);
			versionsFilter.addIncludeProperty(1, null, null, PropertyNames.MAJOR_VERSION_NUMBER, null);
			versionsFilter.addIncludeProperty(1, null, null, PropertyNames.MINOR_VERSION_NUMBER, null);
			versionsFilter.addIncludeProperty(1, null, null, PropertyNames.CREATOR, null);
			versionsFilter.addIncludeProperty(1, null, null, PropertyNames.DATE_CREATED, null);
			versionSeries.fetchProperties(versionsFilter);

			Document versionOne = findVersionOneDocument(versionSeries);
			if (versionOne == null) {
				System.out.println("Version 1.0 was not found in the VersionSeries.");
				return;
			}

			PropertyFilter versionOneFilter = new PropertyFilter();
			versionOneFilter.addIncludeProperty(0, null, null, PropertyNames.ID, null);
			versionOneFilter.addIncludeProperty(0, null, null, PropertyNames.CREATOR, null);
			versionOneFilter.addIncludeProperty(0, null, null, PropertyNames.DATE_CREATED, null);
			versionOneFilter.addIncludeProperty(0, null, null, PropertyNames.MAJOR_VERSION_NUMBER, null);
			versionOneFilter.addIncludeProperty(0, null, null, PropertyNames.MINOR_VERSION_NUMBER, null);
			versionOne = Factory.Document.fetchInstance(os, versionOne.get_Id(), versionOneFilter);

			String versionOneCreator = versionOne.get_Creator();
			Date versionOneDateCreated = versionOne.get_DateCreated();

			System.out.println("Version 1.0 Creator: " + versionOneCreator);
			System.out.println("Version 1.0 DateCreated: " + versionOneDateCreated);

			if (!isEmpty(versionOneCreator)) {
				setSystemPropertyValue(systemProperties, SYS_CREATOR, versionOneCreator, false);
			} else {
				System.out.println("Skipping Creator update because version 1.0 Creator is empty.");
			}

			if (versionOneDateCreated != null) {
				setSystemPropertyValue(systemProperties, SYS_DATE_CREATED, formatDateForICN(versionOneDateCreated),
						true);
			} else {
				System.out.println("Skipping DateCreated update because version 1.0 DateCreated is null.");
			}

		} catch (Exception e) {
			System.out.println("Error while retrieving version 1.0 information.");
			e.printStackTrace();
		}
	}

	/**
	 * ICN openItem uses request parameter docid, while the JSON body usually
	 * exposes id. Accept either, plus a response docid if present.
	 */
	private String resolveItemId(HttpServletRequest request, JSONObject jsonResponse) {
		String itemId = request != null ? request.getParameter("docid") : null;
		if (isEmpty(itemId)) {
			itemId = getStringValue(jsonResponse, "id");
		}
		if (isEmpty(itemId)) {
			itemId = getStringValue(jsonResponse, "docid");
		}
		return itemId;
	}

	/**
	 * Parses the FileNet GUID from an ICN item id
	 * ({@code ClassName,ObjectStoreId,DocumentId}).
	 */
	private String parseDocumentGuid(String itemId) {
		String trimmed = itemId.trim();
		String[] parts = trimmed.split(",");
		if (parts.length >= 3) {
			return parts[2].trim();
		}
		return trimmed;
	}

	/**
	 * Formats the FileNet date in UTC for the ICN JSON response.
	 */
	private String formatDateForICN(Date date) {
		SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US);
		dateFormat.setTimeZone(TimeZone.getTimeZone("UTC"));
		return dateFormat.format(date);
	}

	/**
	 * Finds document version 1.0 from the supplied VersionSeries.
	 */
	private Document findVersionOneDocument(VersionSeries versionSeries) {
		VersionableSet versions = versionSeries.get_Versions();
		if (versions == null) {
			return null;
		}

		@SuppressWarnings("unchecked")
		Iterator<Object> iterator = versions.iterator();
		while (iterator.hasNext()) {
			Object next = iterator.next();
			if (!(next instanceof Document)) {
				continue;
			}

			Document versionDocument = (Document) next;
			Integer majorVersion = versionDocument.get_MajorVersionNumber();
			Integer minorVersion = versionDocument.get_MinorVersionNumber();
			System.out.println("Found Version: " + majorVersion + "." + minorVersion);

			if (majorVersion != null && minorVersion != null && majorVersion.intValue() == 1
					&& minorVersion.intValue() == 0) {
				System.out.println("Version 1.0 located.");
				return versionDocument;
			}
		}

		return null;
	}

	/**
	 * Updates an existing ICN system property in the systemProperties array.
	 */
	@SuppressWarnings("unchecked")
	private void setSystemPropertyValue(JSONArray systemProperties, String systemPropertyName, Object newValue,
			boolean isDate) {

		if (systemProperties == null || systemPropertyName == null || newValue == null) {
			return;
		}

		for (Object object : systemProperties) {
			if (!(object instanceof JSONObject)) {
				continue;
			}

			JSONObject property = (JSONObject) object;
			String propertyName = getStringValue(property, "name");
			if (!systemPropertyName.equalsIgnoreCase(propertyName)) {
				continue;
			}

			Object existingValues = property.get("values");
			if (existingValues instanceof JSONArray) {
				JSONArray values = (JSONArray) existingValues;
				if (values.isEmpty()) {
					values.add(newValue);
				} else {
					values.set(0, newValue);
				}
			} else {
				JSONArray values = new JSONArray();
				values.add(newValue);
				property.put("values", values);
			}

			if (isDate) {
				property.remove("displayValue");
				property.put("valueTimeZoneOffset", Integer.valueOf(0));
			} else {
				property.put("displayValue", newValue);
			}

			if (property.containsKey("userInfo")) {
				property.remove("userInfo");
			}

			System.out.println("System property [" + systemPropertyName + "] updated to: " + newValue);
			return;
		}

		System.out.println("System property [" + systemPropertyName + "] was not found in systemProperties.");
	}

	private String getStringValue(JSONObject jsonObject, String key) {
		if (jsonObject == null || key == null) {
			return null;
		}
		Object value = jsonObject.get(key);
		return value == null ? null : value.toString();
	}

	private boolean isEmpty(String value) {
		return value == null || value.trim().length() == 0 || "null".equalsIgnoreCase(value.trim());
	}

}
