import java.util.Iterator;

import com.filenet.api.collection.AccessPermissionList;
import com.filenet.api.collection.IndependentObjectSet;
import com.filenet.api.constants.AccessType;
import com.filenet.api.constants.PropertyNames;
import com.filenet.api.core.Document;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.property.FilterElement;
import com.filenet.api.property.PropertyFilter;
import com.filenet.api.query.SearchSQL;
import com.filenet.api.query.SearchScope;
import com.filenet.api.security.AccessPermission;

public class EntryTemplateSecuritySearch {

    private static final int PAGE_SIZE = 100;

    public static void displayAllEntryTemplateSecurity(
            ObjectStore objectStore) {

        /*
         * EntryTemplate is the standard FileNet symbolic class name.
         * Change it if your environment uses a custom Entry Template subclass.
         */
        String query =
                "SELECT * "
              + "FROM [EntryTemplate] "
              + "WHERE [IsCurrentVersion] = TRUE "
              + "ORDER BY [DocumentTitle]";

        System.out.println("Executing query:");
        System.out.println(query);
        System.out.println();

        SearchSQL searchSQL = new SearchSQL();
        searchSQL.setQueryString(query);

        SearchScope searchScope = new SearchScope(objectStore);

        /*
         * Retrieve only the properties needed by this utility.
         */
        PropertyFilter propertyFilter = new PropertyFilter();

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.ID,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.DOCUMENT_TITLE,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.CLASS_DESCRIPTION,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.MAJOR_VERSION_NUMBER,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.MINOR_VERSION_NUMBER,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        0,
                        null,
                        null,
                        PropertyNames.IS_CURRENT_VERSION,
                        null));

        propertyFilter.addIncludeProperty(
                new FilterElement(
                        1,
                        null,
                        null,
                        PropertyNames.PERMISSIONS,
                        null));

        /*
         * continuable = true allows Content Engine to continue the search
         * across multiple pages.
         */
        IndependentObjectSet results =
                searchScope.fetchObjects(
                        searchSQL,
                        PAGE_SIZE,
                        propertyFilter,
                        true);

        Iterator<?> iterator = results.iterator();

        int entryTemplateCount = 0;

        while (iterator.hasNext()) {

            Object result = iterator.next();

            if (!(result instanceof Document)) {
                continue;
            }

            Document entryTemplate = (Document) result;
            entryTemplateCount++;

            displayEntryTemplate(entryTemplate, entryTemplateCount);
        }

        System.out.println();
        System.out.println("========================================");
        System.out.println(
                "Total current Entry Templates found: "
                        + entryTemplateCount);
        System.out.println("========================================");
    }

    private static void displayEntryTemplate(
            Document entryTemplate,
            int sequenceNumber) {

        String documentTitle =
                entryTemplate.getProperties().getStringValue(
                        PropertyNames.DOCUMENT_TITLE);

        String className =
                entryTemplate.get_ClassDescription().get_SymbolicName();

        System.out.println();
        System.out.println("========================================");
        System.out.println(
                "Entry Template #" + sequenceNumber);
        System.out.println("========================================");
        System.out.println(
                "Name               : " + documentTitle);
        System.out.println(
                "ID                 : " + entryTemplate.get_Id());
        System.out.println(
                "Class              : " + className);
        System.out.println(
                "Is current version : "
                        + entryTemplate.get_IsCurrentVersion());
        System.out.println(
                "Version            : "
                        + entryTemplate.get_MajorVersionNumber()
                        + "."
                        + entryTemplate.get_MinorVersionNumber());

        System.out.println();
        System.out.println("Security:");
        System.out.println("----------------------------------------");

        AccessPermissionList permissions =
                entryTemplate.get_Permissions();

        displayPermissions(permissions);
    }

    @SuppressWarnings("unchecked")
    private static void displayPermissions(
            AccessPermissionList permissions) {

        if (permissions == null || permissions.isEmpty()) {
            System.out.println("No security permissions found.");
            return;
        }

        Iterator<AccessPermission> permissionIterator =
                permissions.iterator();

        int aceNumber = 0;

        while (permissionIterator.hasNext()) {

            AccessPermission permission =
                    permissionIterator.next();

            aceNumber++;

            String accessType =
                    AccessType.ALLOW.equals(
                            permission.get_AccessType())
                            ? "ALLOW"
                            : "DENY";

            System.out.println("ACE #" + aceNumber);
            System.out.println(
                    "  Grantee            : "
                            + permission.get_GranteeName());
            System.out.println(
                    "  Access type        : "
                            + accessType);
            System.out.println(
                    "  Access mask        : "
                            + permission.get_AccessMask());
            System.out.println(
                    "  Inheritable depth  : "
                            + permission.get_InheritableDepth());
            System.out.println(
                    "  Permission source  : "
                            + permission.get_PermissionSource());
            System.out.println("----------------------------------------");
        }
    }
}
