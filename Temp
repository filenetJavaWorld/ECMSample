package com.cnb.repo.export.metadata;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import com.cnb.repo.export.exception.MetadataExportException;
import com.cnb.repo.export.model.PropertyMetadata;
import com.filenet.api.admin.ChoiceList;
import com.filenet.api.collection.PropertyDescriptionList;
import com.filenet.api.constants.Cardinality;
import com.filenet.api.constants.PropertyNames;
import com.filenet.api.constants.TypeID;
import com.filenet.api.core.Factory;
import com.filenet.api.core.ObjectStore;
import com.filenet.api.meta.ClassDescription;
import com.filenet.api.meta.PropertyDescription;
import com.filenet.api.meta.PropertyDescriptionBoolean;
import com.filenet.api.meta.PropertyDescriptionDateTime;
import com.filenet.api.meta.PropertyDescriptionFloat64;
import com.filenet.api.meta.PropertyDescriptionId;
import com.filenet.api.meta.PropertyDescriptionInteger32;
import com.filenet.api.meta.PropertyDescriptionString;
import com.filenet.api.property.FilterElement;
import com.filenet.api.property.PropertyFilter;

/**
 * Loads document-class property metadata from FileNet CE.
 */
public class DocumentClassMetadataProvider {

	public List<PropertyMetadata> loadProperties(ObjectStore objectStore, String classSymbolicName,
			String classDisplayName, boolean includeInherited) throws MetadataExportException {
		try {
			PropertyFilter pf = new PropertyFilter();
			pf.addIncludeProperty(new FilterElement(null, null, null, PropertyNames.PROPERTY_DESCRIPTIONS, null));
			pf.addIncludeProperty(new FilterElement(null, null, null, PropertyNames.PROPER_SUBCLASS_PROPERTY_DESCRIPTIONS,
					null));
			pf.addIncludeProperty(new FilterElement(null, null, null, PropertyNames.DISPLAY_NAME, null));
			pf.addIncludeProperty(new FilterElement(null, null, null, PropertyNames.SYMBOLIC_NAME, null));

			ClassDescription classDesc = Factory.ClassDescription.fetchInstance(objectStore, classSymbolicName, pf);
			if (classDesc == null) {
				throw new MetadataExportException("The selected document class no longer exists.");
			}

			String resolvedDisplayName = classDisplayName;
			try {
				if (resolvedDisplayName == null || resolvedDisplayName.trim().isEmpty()) {
					resolvedDisplayName = classDesc.get_DisplayName();
				}
			} catch (Exception ignore) {
				resolvedDisplayName = classSymbolicName;
			}
			if (resolvedDisplayName == null || resolvedDisplayName.trim().isEmpty()) {
				resolvedDisplayName = classSymbolicName;
			}

			PropertyDescriptionList defs = null;
			boolean usingProperSubclassOnly = false;
			if (!includeInherited) {
				defs = classDesc.get_ProperSubclassPropertyDescriptions();
				if (defs != null) {
					usingProperSubclassOnly = true;
				}
			}
			if (defs == null) {
				defs = classDesc.get_PropertyDescriptions();
			}

			List<PropertyMetadata> rows = new ArrayList<PropertyMetadata>();
			if (defs == null) {
				return rows;
			}

			Integer superclassCount = null;
			try {
				superclassCount = classDesc.get_SuperclassPropertyCount();
			} catch (Exception ignore) {
				superclassCount = null;
			}

			int index = 0;
			@SuppressWarnings("unchecked")
			Iterator<PropertyDescription> it = defs.iterator();
			while (it.hasNext()) {
				PropertyDescription pd = it.next();
				if (pd == null) {
					continue;
				}
				boolean inherited;
				if (usingProperSubclassOnly) {
					inherited = false;
				} else if (superclassCount != null) {
					inherited = index < superclassCount.intValue();
				} else {
					inherited = false;
				}
				if (!includeInherited && inherited) {
					index++;
					continue;
				}
				rows.add(toPropertyMetadata(pd, resolvedDisplayName, classSymbolicName, inherited));
				index++;
			}
			return rows;
		} catch (MetadataExportException e) {
			throw e;
		} catch (Exception e) {
			String msg = e.getMessage() != null ? e.getMessage().toLowerCase() : "";
			if (msg.contains("not found") || msg.contains("does not exist")) {
				throw new MetadataExportException("The selected document class no longer exists.", e);
			}
			if (msg.contains("access") || msg.contains("permission") || msg.contains("security")) {
				throw new MetadataExportException("Permission denied while reading repository metadata.", e);
			}
			throw new MetadataExportException("Unable to retrieve document-class metadata.", e);
		}
	}

	private PropertyMetadata toPropertyMetadata(PropertyDescription pd, String classDisplayName,
			String classSymbolicName, boolean inherited) {
		PropertyMetadata row = new PropertyMetadata();
		row.setDocumentClassDisplayName(classDisplayName);
		row.setDocumentClassSymbolicName(classSymbolicName);
		row.setPropertyDisplayName(safe(pd.get_DisplayName()));
		row.setPropertySymbolicName(safe(pd.get_SymbolicName()));
		row.setPropertyDescription(safe(pd.get_DescriptiveText()));
		row.setDataType(formatType(pd.get_DataType()));
		row.setCardinality(formatCardinality(pd.get_Cardinality()));
		row.setRequired(Boolean.valueOf(Boolean.TRUE.equals(pd.get_IsValueRequired())));
		row.setSearchable(Boolean.valueOf(Boolean.TRUE.equals(pd.get_IsSearchable())));
		row.setHidden(Boolean.valueOf(Boolean.TRUE.equals(pd.get_IsHidden())));
		row.setInherited(Boolean.valueOf(inherited));
		row.setSettability(pd.get_Settability() != null ? pd.get_Settability().toString() : "");

		applyTypeSpecific(pd, row);

		ChoiceList choiceList = null;
		try {
			choiceList = pd.get_ChoiceList();
		} catch (Exception ignore) {
			choiceList = null;
		}
		if (choiceList != null) {
			try {
				choiceList.fetchProperties(new String[] {
					PropertyNames.ID, PropertyNames.DISPLAY_NAME, PropertyNames.NAME
				});
				row.setChoiceListAssigned(Boolean.TRUE);
				row.setChoiceListId(choiceList.get_Id() != null ? choiceList.get_Id().toString() : "");
				row.setChoiceListName(safe(choiceList.get_DisplayName()));
				row.setChoiceListSymbolicName(safe(choiceList.get_Name()));
			} catch (Exception e) {
				row.setChoiceListAssigned(Boolean.TRUE);
			}
		} else {
			row.setChoiceListAssigned(Boolean.FALSE);
		}
		return row;
	}

	private void applyTypeSpecific(PropertyDescription pd, PropertyMetadata row) {
		try {
			if (pd instanceof PropertyDescriptionString) {
				PropertyDescriptionString s = (PropertyDescriptionString) pd;
				row.setMaximumLength(s.get_MaximumLengthString());
				row.setDefaultValue(s.get_PropertyDefaultString());
			} else if (pd instanceof PropertyDescriptionInteger32) {
				PropertyDescriptionInteger32 i = (PropertyDescriptionInteger32) pd;
				row.setMinimumValue(i.get_PropertyMinimumInteger32());
				row.setMaximumValue(i.get_PropertyMaximumInteger32());
				row.setDefaultValue(i.get_PropertyDefaultInteger32());
			} else if (pd instanceof PropertyDescriptionFloat64) {
				PropertyDescriptionFloat64 f = (PropertyDescriptionFloat64) pd;
				row.setMinimumValue(f.get_PropertyMinimumFloat64());
				row.setMaximumValue(f.get_PropertyMaximumFloat64());
				row.setDefaultValue(f.get_PropertyDefaultFloat64());
			} else if (pd instanceof PropertyDescriptionBoolean) {
				row.setDefaultValue(((PropertyDescriptionBoolean) pd).get_PropertyDefaultBoolean());
			} else if (pd instanceof PropertyDescriptionDateTime) {
				row.setDefaultValue(((PropertyDescriptionDateTime) pd).get_PropertyDefaultDateTime());
			} else if (pd instanceof PropertyDescriptionId) {
				try {
					row.setDefaultValue(((PropertyDescriptionId) pd).get_PropertyDefaultId());
				} catch (Exception ignore) {
					// ignore
				}
			}
		} catch (Exception ignore) {
			// Keep base fields when type-specific getters fail.
		}
	}

	private static String formatType(TypeID typeId) {
		return typeId != null ? typeId.toString() : "";
	}

	private static String formatCardinality(Cardinality cardinality) {
		if (cardinality == null) {
			return "";
		}
		if (cardinality == Cardinality.SINGLE) {
			return "Single";
		}
		if (cardinality == Cardinality.LIST || cardinality == Cardinality.ENUM) {
			return "Multi";
		}
		return cardinality.toString();
	}

	private static String safe(String value) {
		return value != null ? value : "";
	}
}
