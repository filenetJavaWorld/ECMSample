		},

		_hideCriteriaHeaderSummary: function(searchTab) {
			if (!searchTab || this._reportAdmin) {
				return;
			}
			var widgets = [
				searchTab._class,
				searchTab._searchIn,
				searchTab._moreOptions,
				searchTab._propertyOptions
			];
			for (var i = 0; i < widgets.length; i++) {
				if (widgets[i] && widgets[i].domNode) {
					domClass.add(widgets[i].domNode, "dijitHidden");
				}
			}
		},

		_resolveHomeRepository: function() {
			var def = Desktop.getDefaultRepository ? Desktop.getDefaultRepository() : null;
			if (def && def.type === "p8") {
				return def;
			}
			if (Desktop.repositories && Desktop.repositories.length) {
				for (var i = 0; i < Desktop.repositories.length; i++) {
					var r = Desktop.repositories[i];
					if (r && r.type === "p8") {
						return r;
					}
				}
			}
			return null;
		},

		_openConfiguredSearchTemplate: function(repo) {
			if (this._openingTemplate) {
				return;
			}
			this._openingTemplate = true;
			var templateName = this.searchTemplateName || SEARCH_TEMPLATE_NAME;
			var self = this;

			console.log(LOG + ": Looking up search template [" + templateName + "] in repository " + repo.id);

			repo.retrieveSearchTemplates(function(searchTemplates) {
				var template = self._findTemplateByName(searchTemplates, templateName);
				if (!template) {
					self._openingTemplate = false;
					console.error(LOG + ": Search template not found: " + templateName);
					self._showError("Search template not found: " + templateName);
					return;
				}

				console.log(LOG + ": Template found id=" + template.id + " vsId=" + template.vsId);

				var openPrepared = function(fullTemplate) {
					self._openSearchTab(repo, fullTemplate || template);
					self.isLoaded = true;
					self.needReset = false;
					self._openingTemplate = false;
					if (self.borderContainer && self.borderContainer.resize) {
