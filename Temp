define([
	"dojo/_base/declare",
	"dojo/_base/lang",
	"dojo/_base/array",
	"dojo/aspect",
	"dojo/dom-class",
	"dijit/form/Button",
	"dijit/layout/ContentPane",
	"ecm/model/Desktop",
	"ecm/widget/dialog/MessageDialog",
	"ecm/widget/layout/SearchTabPane",
	"ecm/widget/listView/modules/Bar",
	"ecm/widget/listView/modules/FilterData",
	"dojo/text!./templates/ReportRequestFeature.html",
	"./ReportService",
	"./ReportRequestDownloadGridModule",
	"./ReportDownloadDecorator"
], function(declare, lang, array, aspect, domClass, Button, ContentPane, Desktop, MessageDialog, SearchTabPane, Bar, FilterData,
		template, reportService, ReportRequestDownloadGridModule, ReportDownloadDecorator) {

	var SEARCH_TEMPLATE_NAME = "Reports Request Search Template";
	var LOG = "[CNBReportsPlugin.ReportRequestFeature]";

	/**
	 * Report Request feature: hosts the ICN Search UI for the configured StoredSearch template.
	 * On open: adjust Action filter for admins, then auto-execute the search. Criteria stay available to expand/refine later.
	 */
	return declare("cNBReportsPluginDojo.ReportRequestFeature", [
		SearchTabPane
	], {
		templateString: template,
		widgetsInTemplate: true,

		searchTemplateName: SEARCH_TEMPLATE_NAME,
		_reportAdmin: false,
		_openingTemplate: false,
		_openedTemplateId: null,

		postCreate: function() {
			this.logEntry("postCreate");
			this.inherited(arguments);
			if (this.createButton) {
				this.createButton.set("label", "Create Report Request");
				this.own(this.createButton.on("click", lang.hitch(this, "_onCreateClicked")));
			}
			this.own(aspect.after(this.searchTabContainer, "onTabOpened", lang.hitch(this, "_onSearchTabOpened"), true));
			this.logExit("postCreate");
		},

		_onCreateClicked: function() {
			var repo = this.repository || this._resolveHomeRepository();
			var resultSet = this._getActiveSearchResultSet();
			var actionFn = lang.getObject("createReportRequestAction");
			if (lang.isFunction(actionFn)) {
				actionFn(repo, null, null, null, resultSet, {
					repository: repo,
					widget: this
				});
				return;
			}
			this._showError("Create Report Request action is not available.");
		},

		_getActiveSearchResultSet: function() {
			try {
				var tabs = this.searchTabContainer && this.searchTabContainer.getChildren
					? this.searchTabContainer.getChildren()
					: [];
				for (var i = 0; i < tabs.length; i++) {
					if (tabs[i] && tabs[i].searchResults && lang.isFunction(tabs[i].searchResults.getResultSet)) {
						var rs = tabs[i].searchResults.getResultSet();
						if (rs) {
							return rs;
						}
					}
				}
			} catch (ex) {
				console.warn(LOG + ": Unable to resolve active search result set", ex);
			}
			return null;
		},

		setParams: function(params) {
			this.logEntry("setParams", params);
			if (params && params.searchTemplateName) {
				this.searchTemplateName = params.searchTemplateName;
			}
			if (params && params.repository) {
				this.setRepository(params.repository);
			}
			if (!this.isLoaded && this.selected) {
				this.loadContent();
			}
			this.logExit("setParams");
		},

		loadContent: function() {
			this.logEntry("loadContent");
			if (this.isLoaded) {
				this.logExit("loadContent");
				return;
			}

			var repo = this.repository || this._resolveHomeRepository();
			if (!repo) {
				this._showError("No FileNet (P8) repository is available for Report Requests.");
				this.logExit("loadContent");
				return;
			}
			this.setRepository(repo);

			if (!repo.connected) {
				this.own(this.connect(repo, "onConnected", lang.hitch(this, function() {
					if (!this.isLoaded) {
						this.loadContent();
					}
				})));
				this.logExit("loadContent");
				return;
			}

			var self = this;
			reportService.getAdminUsers(function(response) {
				self._reportAdmin = self._isCurrentUserAdmin(response && response.adminUsers);
				console.log(LOG + ": desktop.userId=" + (Desktop.userId || "") + " isAdmin=" + self._reportAdmin);
				self._applyNonAdminCriteriaSummaryVisibility();
				self._openConfiguredSearchTemplate(repo);
			}, function() {
				self._reportAdmin = false;
				self._applyNonAdminCriteriaSummaryVisibility();
				self._openConfiguredSearchTemplate(repo);
			});

			this.logExit("loadContent");
		},

		/**
		 * True when ecm.model.desktop.userId is in the configured adminUsers list (case-insensitive).
		 */
		_isCurrentUserAdmin: function(adminUsers) {
			var userId = Desktop.userId ? String(Desktop.userId).trim().toLowerCase() : "";
			if (!userId || !adminUsers || !adminUsers.length) {
				return false;
			}
			for (var i = 0; i < adminUsers.length; i++) {
				var admin = adminUsers[i] != null ? String(adminUsers[i]).trim().toLowerCase() : "";
				if (admin && admin === userId) {
					return true;
				}
			}
			return false;
		},

		/**
		 * Non-admin: hide Class / Search in / Search options / Property options text on the
		 * Search Criteria title bar. Keep the Search Criteria section itself available.
