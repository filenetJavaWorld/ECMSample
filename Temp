import com.cnb.repo.export.model.ChoiceListMetadata;

/**
 * Writes the Choice List Summary worksheet for standalone choice-list export.
 */
public class ChoiceListSummarySheetWriter {

	public static final String SHEET_NAME = "Choice List Summary";

	private static final String[] HEADERS = new String[] {
		"Choice List Display Name",
		"Choice List Symbolic Name",
		"Data Type",
		"Item Count",
		"Hierarchical",
		"Choice List Details"
	};

	public void write(Workbook workbook, WorkbookStyleFactory styles, List<ChoiceListMetadata> choiceLists,
			Map<String, String> sheetNameById) {

		Sheet sheet = workbook.createSheet(SHEET_NAME);
		int colCount = HEADERS.length;

		Row titleRow = sheet.createRow(0);
		titleRow.setHeightInPoints(24);
		Cell titleCell = titleRow.createCell(0);
		titleCell.setCellValue("Choice List Export Summary");
		titleCell.setCellStyle(styles.getTitleStyle());
		for (int c = 1; c < colCount; c++) {
			Cell filler = titleRow.createCell(c);
			filler.setCellStyle(styles.getTitleStyle());
		}
		sheet.addMergedRegion(new CellRangeAddress(0, 0, 0, colCount - 1));

		Row headerRow = sheet.createRow(1);
		headerRow.setHeightInPoints(30);
		for (int c = 0; c < colCount; c++) {
			Cell cell = headerRow.createCell(c);
			cell.setCellValue(HEADERS[c]);
			cell.setCellStyle(styles.getHeaderStyle());
		}

		int rowIndex = 2;
		for (int i = 0; i < choiceLists.size(); i++) {
			ChoiceListMetadata cl = choiceLists.get(i);
			boolean alt = (i % 2) == 1;
			Row row = sheet.createRow(rowIndex++);

			writeText(row, 0, cl.getDisplayName(), styles, alt);
			writeText(row, 1, cl.getSymbolicName(), styles, alt);
			writeText(row, 2, cl.getDataType(), styles, alt);

			Cell countCell = row.createCell(3);
			countCell.setCellValue(cl.getItemCount());
			countCell.setCellStyle(styles.getDataStyle(alt));

			Cell hierCell = row.createCell(4);
			hierCell.setCellValue(cl.isHierarchical() ? "Yes" : "No");
			hierCell.setCellStyle(styles.getDataStyle(alt));

			Cell linkCell = row.createCell(5);
			String targetSheet = sheetNameById != null ? sheetNameById.get(cl.getId()) : null;
			if (targetSheet != null && targetSheet.length() > 0) {
				HyperlinkUtil.setDocumentLink(workbook, linkCell, targetSheet, "View Choice List",
						styles.getHyperlinkStyle(alt));
			} else {
				linkCell.setCellValue("");
				linkCell.setCellStyle(styles.getDataStyle(alt));
			}
		}

		int lastDataRow = Math.max(1, rowIndex - 1);
		sheet.setAutoFilter(new CellRangeAddress(1, lastDataRow, 0, colCount - 1));
		sheet.createFreezePane(0, 2);
		autosize(sheet, colCount);
	}

	private static void writeText(Row row, int col, String value, WorkbookStyleFactory styles, boolean alt) {
		Cell cell = row.createCell(col);
		cell.setCellValue(value != null ? value : "");
		cell.setCellStyle(styles.getDataStyle(alt));
	}

	private static void autosize(Sheet sheet, int columnCount) {
		for (int c = 0; c < columnCount; c++) {
			sheet.autoSizeColumn(c);
			int width = sheet.getColumnWidth(c);
			int max = 60 * 256;
			if (width > max) {
				sheet.setColumnWidth(c, max);
			} else if (width < 12 * 256) {
				sheet.setColumnWidth(c, 12 * 256);
			}
		}
	}
}
