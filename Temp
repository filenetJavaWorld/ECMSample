require([
	"dojo/_base/lang",
	"dojo/_base/array",
	"ecm/widget/dialog/MessageDialog",
	"cNBReportsPluginDojo/ReportStatusDecorator",
	"cNBReportsPluginDojo/ReportDownloadDecorator",
	"cNBReportsPluginDojo/ReportRequestDialog",
	"cNBReportsPluginDojo/ReportService"
], function(lang, array, MessageDialog, ReportStatusDecorator, ReportDownloadDecorator, ReportRequestDialog,
	reportService) {

	function resolveDocumentId(item) {
		if (!item) {
			return null;
		}
		var id = item.id;
		if (!id) {
			return null;
		}
		var parts = String(id).split(",");
		if (parts.length >= 3) {
			return parts[2];
		}
		return String(id);
	}

	function resolveItemStatus(item) {
		if (!item) {
			return "";
		}
		var status = null;
		if (item.getValue) {
			status = item.getValue("Status");
		}
		if (status == null && item.attributes) {
			status = item.attributes.Status;
		}
		if (status == null && item.getDisplayValue) {
			status = item.getDisplayValue("Status");
		}
		return status != null ? String(status).trim() : "";
	}

	function isPendingStatus(status) {
		return status != null && String(status).toLowerCase() === "pending";
	}

	function isFailedStatus(status) {
		return status != null && String(status).toLowerCase() === "failed";
	}

	function isHoldStatus(status) {
		return status != null && String(status).toLowerCase() === "hold";
	}

	function showError(message) {
		new MessageDialog({
			text: message
		}).show();
	}

	function showInfo(message) {
		new MessageDialog({
			text: message
		}).show();
	}

	function refreshAfterAction(resultSet, callback, items, parameterMap) {
		var rs = resultSet;
		if (!rs && items && items[0] && items[0].resultSet) {
			rs = items[0].resultSet;
		}
		if (!rs && parameterMap && parameterMap.widget && lang.isFunction(parameterMap.widget.getResultSet)) {
			rs = parameterMap.widget.getResultSet();
		}
		if (rs && lang.isFunction(rs.refresh)) {
			rs.refresh();
		} else if (rs && lang.isFunction(rs.refreshHandler)) {
			rs.refreshHandler(rs, function() {
			});
		}
		if (lang.isFunction(callback)) {
			callback({
				items: items
			});
		}
	}

	/**
	 * Opens Create Report Request dialog prefilled from Version 1.0 JSON (Copy / Reinitiate).
	 */
	function openCreateDialogFromVersionOne(repository, items, callback, resultSet, failureMessage, parameterMap) {
		if (!repository) {
			showError("Select a repository.");
			return;
		}
		if (!items || items.length !== 1) {
			showError("Select exactly one report request.");
			return;
		}
		var documentId = resolveDocumentId(items[0]);
		if (!documentId) {
			showError("Unable to determine the report request document id.");
			return;
		}

		reportService.getReportRequestDetails(repository.id, documentId, null, function(response) {
			var details = response.details || {};
			var reportRequest = details.reportRequest || {};
			if (!reportRequest.targetClassSymbolicName && !(reportRequest.criteria && reportRequest.criteria.length)) {
				showError(failureMessage || "Unable to load Version 1 request JSON for this report request.");
				return;
			}
			var dlg = new ReportRequestDialog({
				repository: repository,
				editMode: false,
				prefillDetails: details,
				style: "width: 90%; height: 90%;"
			});
			dlg.onSubmitted = function() {
				refreshAfterAction(resultSet, callback, items, parameterMap);
			};
			dlg.show();
		}, function(response) {
			var msg = failureMessage || "Unable to load Version 1 request JSON.";
			if (response && response.message) {
				msg = response.message;
			}
			showError(msg);
		}, {
			useVersion1: true
		});
	}

	lang.setObject("editReportRequest", function(repository, items, callback, teamspace, resultSet, parameterMap) {
		if (!repository) {
			showError("Select a repository.");
			return;
		}
		if (!items || items.length !== 1) {
			showError("Select exactly one report request to edit.");
			return;
		}

		var item = items[0];
		var status = resolveItemStatus(item);
		if (!isPendingStatus(status)) {
			showError("Only report requests in Pending status can be edited.");
			return;
		}

		var documentId = resolveDocumentId(item);
		if (!documentId) {
			showError("Unable to determine the report request document id.");
			return;
		}

		reportService.getReportRequestDetails(repository.id, documentId, null, function(response) {
			var details = response.details || {};
			var metadata = details.metadata || {};
			var metaStatus = metadata.status;
			if (metaStatus && !isPendingStatus(metaStatus)) {
				showError("Only report requests in Pending status can be edited.");
				return;
			}

			var editDocumentId = metadata.documentId || documentId;
			var dlg = new ReportRequestDialog({
				repository: repository,
				editMode: true,
				documentId: editDocumentId,
				details: details,
				style: "width: 90%; height: 90%;"
			});
			dlg.onSubmitted = function() {
				refreshAfterAction(resultSet, callback, items, parameterMap);
			};
			dlg.show();
		}, function(response) {
			var msg = "Unable to load report request details.";
			if (response && response.message) {
				msg = response.message;
			}
			showError(msg);
		});
	});

	lang.setObject("copyReportRequest", function(repository, items, callback, teamspace, resultSet, parameterMap) {
		openCreateDialogFromVersionOne(repository, items, callback, resultSet,
			"Unable to load Version 1 request JSON for Copy Request.", parameterMap);
	});

	lang.setObject("reinitiateReportRequest", function(repository, items, callback, teamspace, resultSet, parameterMap) {
		if (!items || items.length !== 1) {
			showError("Select exactly one failed report request to reinitiate.");
			return;
		}
		if (!isFailedStatus(resolveItemStatus(items[0]))) {
			showError("Only report requests in Failed status can be reinitiated.");
			return;
		}
		openCreateDialogFromVersionOne(repository, items, callback, resultSet,
			"Unable to load Version 1 request JSON for Reinitiate Request.", parameterMap);
	});

	lang.setObject("holdReportRequest", function(repository, items, callback, teamspace, resultSet, parameterMap) {
		if (!repository) {
			showError("Select a repository.");
			return;
		}
		if (!items || items.length !== 1) {
			showError("Select exactly one Pending report request to place on Hold.");
			return;
		}
		if (!isPendingStatus(resolveItemStatus(items[0]))) {
			showError("Only report requests in Pending status can be placed on Hold.");
			return;
		}
		var documentId = resolveDocumentId(items[0]);
		if (!documentId) {
			showError("Unable to determine the report request document id.");
			return;
		}
		reportService.updateReportRequestStatus(repository.id, documentId, "hold", function(response) {
			refreshAfterAction(resultSet, callback, items, parameterMap);
			showInfo((response && response.message) || "Report request placed on Hold.");
		}, function(response) {
			var msg = "Unable to place report request on Hold.";
			if (response && response.message) {
				msg = response.message;
			}
			showError(msg);
		});
	});

	lang.setObject("releaseHoldReportRequest", function(repository, items, callback, teamspace, resultSet, parameterMap) {
		if (!repository) {
			showError("Select a repository.");
			return;
		}
		if (!items || items.length !== 1) {
			showError("Select exactly one Hold report request to release.");
			return;
		}
		if (!isHoldStatus(resolveItemStatus(items[0]))) {
			showError("Only report requests in Hold status can be released.");
			return;
		}
		var documentId = resolveDocumentId(items[0]);
		if (!documentId) {
			showError("Unable to determine the report request document id.");
			return;
		}
		reportService.updateReportRequestStatus(repository.id, documentId, "releaseHold", function(response) {
			refreshAfterAction(resultSet, callback, items, parameterMap);
			showInfo((response && response.message) || "Report request released from Hold.");
		}, function(response) {
			var msg = "Unable to release Hold on report request.";
			if (response && response.message) {
				msg = response.message;
			}
			showError(msg);
		});
	});
});
