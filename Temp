package com.cnb.repo.export.excel;

import java.util.HashSet;
import java.util.Set;

/**
 * Sanitizes and uniquifies Excel worksheet names (max 31 chars).
 */
public class WorksheetNameUtil {

	private static final int MAX_LEN = 31;
	private final Set<String> usedNames = new HashSet<String>();

	public String uniqueName(String preferred) {
		String base = sanitize(preferred);
		if (base.isEmpty()) {
			base = "Sheet";
		}
		String candidate = base;
		int suffix = 2;
		while (usedNames.contains(candidate.toLowerCase())) {
			String suffixText = " (" + suffix + ")";
			int maxBase = MAX_LEN - suffixText.length();
			if (maxBase < 1) {
				maxBase = 1;
			}
			String trimmedBase = base.length() > maxBase ? base.substring(0, maxBase) : base;
			candidate = trimmedBase + suffixText;
			suffix++;
		}
		usedNames.add(candidate.toLowerCase());
		return candidate;
	}

	public static String sanitize(String name) {
		if (name == null) {
			return "";
		}
		String cleaned = name.replace('\\', ' ').replace('/', ' ').replace('?', ' ').replace('*', ' ')
				.replace('[', ' ').replace(']', ' ').replace(':', ' ').trim();
		cleaned = cleaned.replaceAll("\\s+", " ").trim();
		if (cleaned.length() > MAX_LEN) {
			cleaned = cleaned.substring(0, MAX_LEN).trim();
		}
		return cleaned;
	}

	public static String escapeForAddress(String sheetName) {
		if (sheetName == null) {
			return "";
		}
		return sheetName.replace("'", "''");
	}
}
