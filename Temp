package met.kms.ecm.home.feature;

import java.util.Locale;

import com.ibm.ecm.extension.PluginFeature;

/**
 * Custom Home feature (OOTB favorites / HomePane layout) with Browse-style
 * client-side filter on the Favorites tab.
 */
public class CustomHomeFeature extends PluginFeature {

	@Override
	public String getId() {
		return "CustomHomeFeature";
	}

	@Override
	public String getName(Locale locale) {
		return "CustomHomeFeature";
	}

	@Override
	public String getDescription(Locale locale) {
		return "Home (Favorites) with content list filter";
	}

	@Override
	public String getIconUrl() {
		return "favoritesLaunchIcon";
	}

	@Override
	public String getSvgFilePath() {
		return "WebContent/images/BasicSearchIcon.svg";
	}

	@Override
	public String getHelpContext() {
		return null;
	}

	@Override
	public String getFeatureIconTooltipText(Locale locale) {
		return "Home";
	}

	@Override
	public String getPopupWindowTooltipText(Locale locale) {
		return "";
	}

	@Override
	public String getContentClass() {
		return "searchPluginDojo.CustomHomeFeature";
	}

	@Override
	public boolean isSeparator() {
		return false;
	}

	@Override
	public String getPopupWindowClass() {
		return "";
	}

	@Override
	public boolean isPreLoad() {
		return false;
	}

	@Override
	public String getConfigurationDijitClass() {
		return "searchPluginDojo.FeatureConfigurationPane";
	}
}




/* Custom Home embeds CustomFavoritesFeature; keep filter bar layout when nested under Home tabs */
.metlifeCustomHomePane .metlifeCustomFavoritesPane .ecmContentList table.Bar {
	table-layout: auto;
	width: 100%;
}

.metlifeCustomHomePane .metlifeCustomFavoritesPane .ecmContentList table.Bar td.BarFilterData {
	width: 240px;
	min-width: 240px;
	max-width: 240px;
	white-space: nowrap;
	vertical-align: middle;
	text-align: right;
	padding: 2px 8px 2px 16px;
}




define([
	"dojo/_base/declare",
	"dojo/_base/lang",
	"dojo/_base/array",
	"dojo/aspect",
	"dojo/dom-class",
	"ecm/model/Desktop",
	"ecm/widget/layout/HomePane",
	"searchPluginDojo/CustomFavoritesFeature"
], function(declare, lang, array, aspect, domClass, Desktop, HomePane, CustomFavoritesFeature) {

	/**
	 * Custom Home (OOTB favorites feature / HomePane) that uses CustomFavoritesFeature
	 * so the Favorites tab has the Browse-style client-side filter.
	 */
	return declare("searchPluginDojo.CustomHomeFeature", [ HomePane ], {

		postCreate: function() {
			this.inherited(arguments);

			if (this.domNode) {
				domClass.add(this.domNode, "metlifeCustomHomePane");
			}

			this._replaceFavoritesPaneWithCustom();
		},

		/**
		 * Prefer this feature's config; fall back to OOTB Home ("favorites") so My Synced Files /
		 * My Checkouts keep working when the plugin feature has empty admin config.
		 */
		getFeatureConfiguration: function() {
			var config = lang.mixin({}, this.inherited(arguments) || {});
			var ootbHome = Desktop.getFeatureById && Desktop.getFeatureById("favorites");
			if (ootbHome && ootbHome.configurations) {
				config = lang.mixin({}, ootbHome.configurations, config);
			}
			if (!config.showRepositories && Desktop.repositories && Desktop.repositories.length) {
				config.showRepositories = array.map(Desktop.repositories, function(repo) {
					return repo.id;
				});
			}
			return config;
		},

		/**
		 * HomePane always constructs OOTB FavoritesPane; swap it for CustomFavoritesFeature.
		 */
		_replaceFavoritesPaneWithCustom: function() {
			if (!this._favoritesPane || !this._tabContainer) {
				return;
			}

			var index = this._tabContainer.getIndexOfChild(this._favoritesPane);
			var oldPane = this._favoritesPane;

			var customPane = new CustomFavoritesFeature({
				title: Desktop.getConfiguredLabelsvalue("favorites"),
				closable: false,
				selected: true,
				iconClass: "favoritesTab",
				feature: this.feature
			});

			this.own(aspect.after(customPane, "onOpenItem", lang.hitch(this, "onOpenItem"), true));
			this.own(aspect.after(customPane, "onEditItem", lang.hitch(this, "onEditItem"), true));

			this._tabContainer.removeChild(oldPane);
			oldPane.destroyRecursive();

			this._favoritesPane = customPane;
			this._tabContainer.addChild(customPane, index >= 0 ? index : 0);
			this._tabContainer.selectChild(customPane);
		}
	});
});
