import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.util.CellRangeAddress;

import com.cnb.repo.export.model.PropertyMetadata;

/**
 * Writes the Document Properties worksheet.
 */
public class DocumentPropertiesSheetWriter {

	public static final String SHEET_NAME = "Document Properties";

	private static final String COL_DOC_CLASS_DISPLAY = "documentClassDisplayName";
	private static final String COL_DOC_CLASS_SYMBOLIC = "documentClassSymbolicName";
	private static final String COL_PROP_DISPLAY = "propertyDisplayName";
	private static final String COL_PROP_SYMBOLIC = "propertySymbolicName";
	private static final String COL_PROP_DESC = "propertyDescription";
	private static final String COL_DATA_TYPE = "dataType";
	private static final String COL_CARDINALITY = "cardinality";
	private static final String COL_REQUIRED = "required";
	private static final String COL_SEARCHABLE = "searchable";
	private static final String COL_HIDDEN = "hidden";
	private static final String COL_INHERITED = "inherited";
	private static final String COL_SETTABILITY = "settability";
	private static final String COL_MAX_LENGTH = "maximumLength";
	private static final String COL_MIN_VALUE = "minimumValue";
	private static final String COL_MAX_VALUE = "maximumValue";
	private static final String COL_DEFAULT = "defaultValue";
	private static final String COL_CL_ASSIGNED = "choiceListAssigned";
	private static final String COL_CL_NAME = "choiceListName";
	private static final String COL_CL_SYMBOLIC = "choiceListSymbolicName";
	private static final String COL_CL_DETAILS = "choiceListDetails";

	public void write(Workbook workbook, WorkbookStyleFactory styles, List<String> selectedColumns,
			List<PropertyMetadata> properties, boolean exportChoiceListDetails,
			Map<String, String> choiceListSheetById) {

		List<Column> columns = resolveColumns(selectedColumns, exportChoiceListDetails);
		Sheet sheet = workbook.createSheet(SHEET_NAME);

		Row titleRow = sheet.createRow(0);
		titleRow.setHeightInPoints(24);
		Cell titleCell = titleRow.createCell(0);
		titleCell.setCellValue("Document Class Property Export");
		titleCell.setCellStyle(styles.getTitleStyle());
		if (columns.size() > 1) {
			sheet.addMergedRegion(new CellRangeAddress(0, 0, 0, columns.size() - 1));
			for (int c = 1; c < columns.size(); c++) {
				Cell filler = titleRow.createCell(c);
				filler.setCellStyle(styles.getTitleStyle());
			}
		}

		Row headerRow = sheet.createRow(1);
		headerRow.setHeightInPoints(30);
		for (int c = 0; c < columns.size(); c++) {
			Cell cell = headerRow.createCell(c);
			cell.setCellValue(columns.get(c).header);
			cell.setCellStyle(styles.getHeaderStyle());
		}

		int rowIndex = 2;
		for (int i = 0; i < properties.size(); i++) {
			PropertyMetadata prop = properties.get(i);
			boolean alt = (i % 2) == 1;
			Row row = sheet.createRow(rowIndex++);
			for (int c = 0; c < columns.size(); c++) {
				Column col = columns.get(c);
				Cell cell = row.createCell(c);
				if (COL_CL_DETAILS.equals(col.key)) {
					writeChoiceListDetails(workbook, styles, cell, prop, exportChoiceListDetails, choiceListSheetById,
							alt);
				} else {
					Object value = valueFor(prop, col.key);
					writeValue(cell, value, styles, alt, isWrapColumn(col.key));
				}
			}
		}

		int lastDataRow = Math.max(1, rowIndex - 1);
		sheet.setAutoFilter(new CellRangeAddress(1, lastDataRow, 0, columns.size() - 1));
		sheet.createFreezePane(0, 2);
		autosize(sheet, columns.size());
	}

	private void writeChoiceListDetails(Workbook workbook, WorkbookStyleFactory styles, Cell cell,
			PropertyMetadata prop, boolean exportChoiceListDetails, Map<String, String> choiceListSheetById,
			boolean alt) {
		boolean hasChoice = prop.getChoiceListAssigned() != null && prop.getChoiceListAssigned().booleanValue()
				&& prop.getChoiceListId() != null && prop.getChoiceListId().length() > 0;
		if (!hasChoice) {
			cell.setCellValue("");
			cell.setCellStyle(styles.getDataStyle(alt));
			return;
		}
		if (!exportChoiceListDetails) {
			cell.setCellValue("Not Exported");
			cell.setCellStyle(styles.getDataStyle(alt));
			return;
		}
		String sheetName = choiceListSheetById != null ? choiceListSheetById.get(prop.getChoiceListId()) : null;
		if (sheetName == null || sheetName.length() == 0) {
			cell.setCellValue("");
			cell.setCellStyle(styles.getDataStyle(alt));
			return;
		}
		HyperlinkUtil.setDocumentLink(workbook, cell, sheetName, "View Choice List", styles.getHyperlinkStyle(alt));
	}

	private static void writeValue(Cell cell, Object value, WorkbookStyleFactory styles, boolean alt, boolean wrap) {
		if (value == null) {
			cell.setCellValue("");
		} else if (value instanceof Boolean) {
			cell.setCellValue(((Boolean) value).booleanValue() ? "Yes" : "No");
		} else if (value instanceof Number) {
			cell.setCellValue(((Number) value).doubleValue());
		} else if (value instanceof Date) {
			cell.setCellValue((Date) value);
		} else {
			cell.setCellValue(String.valueOf(value));
		}
		cell.setCellStyle(wrap ? styles.getWrapStyle(alt) : styles.getDataStyle(alt));
	}

	private static Object valueFor(PropertyMetadata prop, String key) {
		if (COL_DOC_CLASS_DISPLAY.equals(key)) {
			return prop.getDocumentClassDisplayName();
		}
		if (COL_DOC_CLASS_SYMBOLIC.equals(key)) {
			return prop.getDocumentClassSymbolicName();
		}
		if (COL_PROP_DISPLAY.equals(key)) {
			return prop.getPropertyDisplayName();
		}
		if (COL_PROP_SYMBOLIC.equals(key)) {
			return prop.getPropertySymbolicName();
		}
		if (COL_PROP_DESC.equals(key)) {
			return prop.getPropertyDescription();
		}
		if (COL_DATA_TYPE.equals(key)) {
			return prop.getDataType();
		}
		if (COL_CARDINALITY.equals(key)) {
			return prop.getCardinality();
		}
		if (COL_REQUIRED.equals(key)) {
			return prop.getRequired();
		}
		if (COL_SEARCHABLE.equals(key)) {
			return prop.getSearchable();
		}
		if (COL_HIDDEN.equals(key)) {
			return prop.getHidden();
		}
		if (COL_INHERITED.equals(key)) {
			return prop.getInherited();
		}
		if (COL_SETTABILITY.equals(key)) {
			return prop.getSettability();
		}
		if (COL_MAX_LENGTH.equals(key)) {
			return prop.getMaximumLength();
		}
		if (COL_MIN_VALUE.equals(key)) {
			return prop.getMinimumValue();
		}
		if (COL_MAX_VALUE.equals(key)) {
			return prop.getMaximumValue();
		}
		if (COL_DEFAULT.equals(key)) {
			return prop.getDefaultValue();
		}
		if (COL_CL_ASSIGNED.equals(key)) {
			return prop.getChoiceListAssigned();
		}
		if (COL_CL_NAME.equals(key)) {
			return Boolean.TRUE.equals(prop.getChoiceListAssigned()) ? prop.getChoiceListName() : "";
		}
		if (COL_CL_SYMBOLIC.equals(key)) {
			return Boolean.TRUE.equals(prop.getChoiceListAssigned()) ? prop.getChoiceListSymbolicName() : "";
		}
		return "";
	}

	private static boolean isWrapColumn(String key) {
		return COL_PROP_DESC.equals(key) || COL_DEFAULT.equals(key);
	}

	private List<Column> resolveColumns(List<String> selectedColumns, boolean exportChoiceListDetails) {
		List<Column> columns = new ArrayList<Column>();
		if (selectedColumns != null) {
			for (String key : selectedColumns) {
				Column col = columnForKey(key);
				if (col != null) {
					columns.add(col);
				}
			}
		}
		// Always include Choice List Details when user selected related choice columns or export details.
		boolean hasDetails = false;
		for (Column c : columns) {
			if (COL_CL_DETAILS.equals(c.key)) {
				hasDetails = true;
				break;
			}
		}
		if (!hasDetails && (exportChoiceListDetails || containsChoiceColumn(selectedColumns))) {
			columns.add(new Column(COL_CL_DETAILS, "Choice List Details"));
		}
		if (columns.isEmpty()) {
			columns.add(new Column(COL_PROP_DISPLAY, "Property Display Name"));
			columns.add(new Column(COL_PROP_SYMBOLIC, "Property Symbolic Name"));
		}
		return columns;
	}

	private static boolean containsChoiceColumn(List<String> selectedColumns) {
		if (selectedColumns == null) {
			return false;
		}
		return selectedColumns.contains(COL_CL_ASSIGNED) || selectedColumns.contains(COL_CL_NAME)
				|| selectedColumns.contains(COL_CL_SYMBOLIC) || selectedColumns.contains(COL_CL_DETAILS);
	}

	private static Column columnForKey(String key) {
		if (key == null) {
			return null;
		}
		if (COL_DOC_CLASS_DISPLAY.equals(key)) {
			return new Column(key, "Document Class");
		}
		if (COL_DOC_CLASS_SYMBOLIC.equals(key)) {
			return new Column(key, "Document Class Symbolic Name");
		}
		if (COL_PROP_DISPLAY.equals(key)) {
			return new Column(key, "Property Display Name");
		}
		if (COL_PROP_SYMBOLIC.equals(key)) {
			return new Column(key, "Property Symbolic Name");
		}
		if (COL_PROP_DESC.equals(key)) {
			return new Column(key, "Property Description");
		}
		if (COL_DATA_TYPE.equals(key)) {
			return new Column(key, "Data Type");
		}
		if (COL_CARDINALITY.equals(key)) {
			return new Column(key, "Cardinality");
		}
		if (COL_REQUIRED.equals(key)) {
			return new Column(key, "Required");
		}
		if (COL_SEARCHABLE.equals(key)) {
			return new Column(key, "Searchable");
		}
		if (COL_HIDDEN.equals(key)) {
			return new Column(key, "Hidden");
		}
		if (COL_INHERITED.equals(key)) {
			return new Column(key, "Inherited");
		}
		if (COL_SETTABILITY.equals(key)) {
			return new Column(key, "Settability");
		}
		if (COL_MAX_LENGTH.equals(key)) {
			return new Column(key, "Maximum Length");
		}
		if (COL_MIN_VALUE.equals(key)) {
			return new Column(key, "Minimum Value");
		}
		if (COL_MAX_VALUE.equals(key)) {
			return new Column(key, "Maximum Value");
		}
		if (COL_DEFAULT.equals(key)) {
			return new Column(key, "Default Value");
		}
		if (COL_CL_ASSIGNED.equals(key)) {
			return new Column(key, "Choice List Assigned");
		}
		if (COL_CL_NAME.equals(key)) {
			return new Column(key, "Choice List Name");
		}
		if (COL_CL_SYMBOLIC.equals(key)) {
			return new Column(key, "Choice List Symbolic Name");
		}
		if (COL_CL_DETAILS.equals(key)) {
			return new Column(key, "Choice List Details");
		}
		return null;
	}

	private static void autosize(Sheet sheet, int columnCount) {
		for (int c = 0; c < columnCount; c++) {
			sheet.autoSizeColumn(c);
			int width = sheet.getColumnWidth(c);
			int max = 80 * 256;
			if (width > max) {
				sheet.setColumnWidth(c, max);
			} else if (width < 12 * 256) {
				sheet.setColumnWidth(c, 12 * 256);
			}
		}
	}

	private static final class Column {
		private final String key;
		private final String header;

		private Column(String key, String header) {
			this.key = key;
			this.header = header;
		}
	}
}
