<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cnb.repo.export</groupId>
    <artifactId>CNBRepoMetadataExportPlugin</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>CNB Repository Metadata Export Plugin</name>
    <description>IBM Content Navigator plugin to export FileNet document-class and choice-list metadata to Excel</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 8 required: java.util.Base64 + Apache POI 4.x. pom_reference also uses 1.8. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <poi.version>4.1.2</poi.version>
    </properties>

    <!--
      ICN / FileNet APIs are provided by the application server at runtime.
      Install once into the local .m2 from the former lib/ jars if Artifactory is unavailable:

        mvn install:install-file -DgroupId=com.ibm -DartifactId=navigatorAPI -Dversion=3.4.0 -Dpackaging=jar -Dfile=lib/navigatorAPI.jar
        mvn install:install-file -DgroupId=com.filenet -DartifactId=Jace -Dversion=5.6.0 -Dpackaging=jar -Dfile=lib/Jace.jar
        mvn install:install-file -DgroupId=com.ibm -DartifactId=j2ee -Dversion=v61 -Dpackaging=jar -Dfile=lib/j2ee.jar
    -->
    <dependencies>

        <!-- ICN Navigator API (provided by ICN runtime) -->
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>navigatorAPI</artifactId>
            <version>3.4.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- FileNet Jace (provided by CE / ICN runtime) -->
        <dependency>
            <groupId>com.filenet</groupId>
            <artifactId>Jace</artifactId>
            <version>5.6.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- J2EE servlet APIs (provided by app server) -->
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>j2ee</artifactId>
            <version>v61</version>
            <scope>provided</scope>
        </dependency>

        <!--
          JSON4J (com.ibm.json.java.*) is bundled inside navigatorAPI.jar,
          so a separate JSON4J dependency is not required for compile.
        -->

        <!-- Apache POI – shaded into the plugin JAR for Excel generation -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-schemas</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlbeans</groupId>
            <artifactId>xmlbeans</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.19</version>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.13</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.virtuald</groupId>
            <artifactId>curvesapi</artifactId>
            <version>1.06</version>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <build>
        <finalName>CNBRepoMetadataExportPlugin</finalName>
        <sourceDirectory>src</sourceDirectory>

        <resources>
            <resource>
                <directory>src</directory>
                <includes>
                    <include>**/WebContent/**</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- ICN plugin JAR manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Plugin-Class>com.cnb.repo.export.CNBRepoMetadataExportPlugin</Plugin-Class>
                            <Built-By>${user.name}</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!--
              Merge only required dependency *classes* into the plugin JAR.
              Do not nest whole .jar files. minimizeJar keeps referenced classes only.
              ICN/FileNet APIs stay provided (not packaged).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <!-- Keep only classes reachable from this plugin; do not dump entire dependency JARs -->
                            <minimizeJar>true</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                                <!--
                                  POI OOXML uses reflection for schema types; keep those packages
                                  even when static analysis cannot see them.
                                -->
                                <filter>
                                    <artifact>org.apache.poi:poi-ooxml-schemas</artifact>
                                    <includes>
                                        <include>org/openxmlformats/schemas/spreadsheetml/**</include>
                                        <include>org/openxmlformats/schemas/officeDocument/**</include>
                                        <include>schemaorg_apache_xmlbeans/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.xmlbeans:xmlbeans</artifact>
                                    <includes>
                                        <include>org/apache/xmlbeans/**</include>
                                        <include>schemaorg_apache_xmlbeans/**</include>
                                    </includes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Plugin-Class>com.cnb.repo.export.CNBRepoMetadataExportPlugin</Plugin-Class>
                                        <Built-By>${user.name}</Built-By>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
