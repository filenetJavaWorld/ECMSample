		_setupAdvancedSearchTab: function(tab, tabKey) {
			var def = tab.searchDefinition;
			var state = this._tabStateByKey[tabKey] || {};
			state.tab = tab;
			state.def = def;
			this._tabStateByKey[tabKey] = state;

			this._hideOotbSearchInAndOptions(def);
			this._injectAdvancedControls(tab, tabKey, state);
			this._installTextSearchOperatorAllHook(def);
			this._installAdvancedSearchExecutionHook(tab, state);
			this._installModifiedOnUiSortHook(def);
			this._installAdvancedSearchPersistenceHooks(tab, state);
			this._installAdvancedSearchRestoreHooks(tab, state, tabKey);
			state.restoredTemplateId = this._getTemplateIdentity(def.searchTemplate);
			this._installDocumentClassCacheHook(def, state);
			this._installExtraResultColumnSearchHook(tab);
			this._scheduleEnsureExtraResultColumn(tabKey);
			this._scheduleDocumentClassSelectorUi(def);
			state.initialized = true;
		},
		
		
		
		
		
		
