		/**
		 * Flow 1 — new unsaved search: default Slice, Both, and resolve Search In.
		 */
		_applyInitialNewSearchControls: function(tabKey) {
			var state = this._tabStateByKey[tabKey];
			if (!state || !state.controlsWidget) {
				return;
			}
			if (state.userControlsActive || state.controlsRestored) {
				return;
			}
			var slices = this._getOrderedSlices();
			var setupOptions = {
				searchType: "both",
				syncOnly: false,
				skipAutoSelect: false
			};
			var defaultSlice = this._getDefaultNewSearchSlice();
			if (defaultSlice && defaultSlice.folderId) {
				setupOptions.selectedValue = defaultSlice.folderId;
			} else {
				setupOptions.defaultLabel = "Enterprise";
			}
			setupOptions.onSelectComplete = lang.hitch(this, function(success) {
				if (success) {
					var value = state.controlsWidget.getSelectedSliceValue();
					this._onAdvancedSliceSelected(tabKey, value, true);
				}
			});
			console.log(LOG, "Applying new-search custom controls", {
				tabKey: tabKey,
				searchType: setupOptions.searchType,
				selectedSliceFolderId: setupOptions.selectedValue || null
			});
			state.controlsWidget.setSlices(slices, setupOptions);
			state.controlsRestored = true;
		},

		/**
		 * Flow 3 — saved template: restore Slice dropdown + Search Option radios only.
		 * ICN owns class, criteria, CBR, operators, values, and Search In.
		 */
		_restoreSavedCustomControls: function(tabKey) {
			var state = this._tabStateByKey[tabKey];
			if (!state || !state.def || !state.controlsWidget) {
				return;
			}
			if (state.userControlsActive) {
				return;
			}
			var def = state.def;
			var template = def.searchTemplate;
			if (!template || template.isNew()) {
				return;
			}
			if (state.controlsRestored) {
				return;
			}
			var savedType = this._getSavedSearchType(template);
			console.log(LOG, "Retrieved custom advanced state", {
				searchType: savedType,
				application: template.application,
				moreOptionsSearchType: template.moreOptions &&
					template.moreOptions.metlifeSearchType
			});
			var matchedSlice = this._findSliceMatchingSearchInFolder(template, def);
			var slices = this._getOrderedSlices();
			if (matchedSlice && matchedSlice.folderId) {
				state.controlsWidget.setSlices(slices, {
					searchType: savedType,
					selectedValue: matchedSlice.folderId,
					syncOnly: true,
					skipAutoSelect: false
				});
				state.sliceValue = matchedSlice.folderId;
				state.selectedSlice = matchedSlice;
				state._lastSliceResolveValue = String(matchedSlice.folderId).trim();
			} else {
				state.controlsWidget.updateSliceOptionsOnly(slices);
