		postCreate: function() {
			this.inherited(arguments);
			this._suppressSliceChangeEvents = false;
			this._suppressSearchTypeChangeEvents = false;
			if (this.sliceLabelNode && this.sliceSelect && this.sliceSelect.id) {
				this.sliceLabelNode.setAttribute("for", this.sliceSelect.id);
			}
			this.own(this.sliceSelect.on("change", lang.hitch(this, function(value) {
