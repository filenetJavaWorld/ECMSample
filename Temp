/**
 * Request model for Choice List Export (Phase 1/2 contract).
 */
public class ChoiceListExportRequest {

	public static final String MODE_ALL = "ALL";
	public static final String MODE_SELECTED = "SELECTED";

	private String repositoryId;
	private String objectStoreId;
	private String objectStoreDisplayName;
	private String exportMode = MODE_ALL;
	private List<String> selectedChoiceListIds = new ArrayList<String>();

	public static ChoiceListExportRequest fromJson(JSONObject json) {
		ChoiceListExportRequest req = new ChoiceListExportRequest();
		if (json == null) {
			return req;
		}
		req.repositoryId = asString(json.get("repositoryId"));
		req.objectStoreId = asString(json.get("objectStoreId"));
		req.objectStoreDisplayName = asString(json.get("objectStoreDisplayName"));
		String mode = asString(json.get("exportMode"));
		req.exportMode = MODE_SELECTED.equalsIgnoreCase(mode) ? MODE_SELECTED : MODE_ALL;
		Object ids = json.get("selectedChoiceListIds");
		if (ids instanceof JSONArray) {
			JSONArray arr = (JSONArray) ids;
			for (int i = 0; i < arr.size(); i++) {
				String id = asString(arr.get(i));
				if (id != null) {
					req.selectedChoiceListIds.add(id);
				}
			}
		}
		return req;
	}

	public void validate() throws IllegalArgumentException {
		if (isBlank(repositoryId)) {
			throw new IllegalArgumentException("Please select an object store.");
		}
		if (MODE_SELECTED.equals(exportMode) && (selectedChoiceListIds == null || selectedChoiceListIds.isEmpty())) {
			throw new IllegalArgumentException("Please select at least one choice list.");
		}
	}

	public boolean isExportAll() {
		return !MODE_SELECTED.equals(exportMode);
	}

	private static String asString(Object o) {
		if (o == null) {
			return null;
		}
		String s = String.valueOf(o).trim();
		return s.length() == 0 ? null : s;
	}

	private static boolean isBlank(String s) {
		return s == null || s.trim().isEmpty();
	}

	public String getRepositoryId() {
		return repositoryId;
	}

	public String getObjectStoreId() {
		return objectStoreId;
	}

	public String getObjectStoreDisplayName() {
		return objectStoreDisplayName;
	}

	public String getExportMode() {
		return exportMode;
	}

	public List<String> getSelectedChoiceListIds() {
		return selectedChoiceListIds;
	}
}
