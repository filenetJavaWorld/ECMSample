define([
	"dojo/_base/declare",
	"dojo/json",
	"ecm/LoggerMixin",
	"ecm/MessagesMixin",
	"ecm/widget/dialog/BaseDialog",
	"dojo/text!./templates/ReportRequestDetailsDialog.html"
], function(declare, json, LoggerMixin, MessagesMixin, BaseDialog, template) {

	return declare("cNBReportsPluginDojo.ReportRequestDetailsDialog", [
		BaseDialog,
		LoggerMixin,
		MessagesMixin
	], {
		contentString: template,
		widgetsInTemplate: true,
		cancelButtonLabel: "Close",

		postCreate: function() {
			this.inherited(arguments);
			this.setTitle("Report request details");
			this.setIntroText("");
		},

		setDetails: function(detailsPayload) {
			var meta = detailsPayload && detailsPayload.metadata ? detailsPayload.metadata : {};
			var rr = detailsPayload && detailsPayload.reportRequest ? detailsPayload.reportRequest : {};
			var lines = [];
			lines.push("<table class='propertyTable' role='presentation'>");
			lines.push("<tr><td class='propertyRowLabel'>Document Id</td><td class='propertyRowValue'>" + this._esc(meta.documentId || "") + "</td></tr>");
			lines.push("<tr><td class='propertyRowLabel'>Document title</td><td class='propertyRowValue'>" + this._esc(meta.documentTitle || "") + "</td></tr>");
			lines.push("<tr><td class='propertyRowLabel'>Creator</td><td class='propertyRowValue'>" + this._esc(meta.creator || "") + "</td></tr>");
			lines.push("<tr><td class='propertyRowLabel'>Date created</td><td class='propertyRowValue'>" + this._esc(meta.dateCreated || "") + "</td></tr>");
			lines.push("<tr><td class='propertyRowLabel'>Date last modified</td><td class='propertyRowValue'>" + this._esc(meta.dateLastModified || "") + "</td></tr>");
			lines.push("</table>");
			lines.push("<h3 class='cnbReportDetailsSection'>Saved request (JSON)</h3>");
			this.summaryNode.innerHTML = lines.join("");
			try {
				this.jsonNode.textContent = json.stringify(rr, null, 2);
			} catch (e) {
				this.jsonNode.textContent = String(rr);
			}
		},

		_esc: function(s) {
			return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
		}
	});
});
