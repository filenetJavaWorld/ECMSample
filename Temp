			var cells = this._getResultSetDetailCells(resultSet);
			if (!cells) {
				return;
			}
			array.forEach(cells, function(cell) {
				if (!cell || !cell.field) {
					return;
				}
				// Match ReportsFeature: filter on report name only.
				cell.filterable = cell.field === "DocumentTitle";
			});
		},

		_getResultSetDetailCells: function(resultSet) {
			if (!resultSet || !resultSet.structure) {
				return null;
			}
			if (resultSet.structure.cells && resultSet.structure.cells[0]) {
				return resultSet.structure.cells[0];
			}
			if (resultSet.structure instanceof Array) {
				return resultSet.structure;
			}
			return null;
		},

		_onSearchFilterModulesLoaded: function(tab) {
			var contentList = tab && tab.searchResults;
			var filterData = contentList && contentList.getContentListModule
				? contentList.getContentListModule("filterData")
				: null;
			if (!filterData || !filterData._filterTextBox) {
				return;
			}
			filterData._filterTextBox.set("placeholder", "Filter by report name");
		},

		_applyReportsContextMenu: function(resultSet) {
			if (!resultSet) {
				return;
			}
			resultSet.itemContextMenuDef = "ReportsItemContextMenu";
		},

		/**
		 * Admin: turn off Action filter, then run search.
		 * Non-admin: leave template filter as-is, then run search.
		 * Criteria remain available so the user can expand and refine later.
		 */
		_runInitialSearchAfterCriteriaLoad: function(searchTab) {
			if (!searchTab || searchTab._cnbInitialSearchStarted) {
				return;
			}
			searchTab._cnbInitialSearchStarted = true;

			if (this._reportAdmin) {
				console.log(LOG + ": Admin user — disabling Action filter before initial search");
				this._disableUserActionFilterOnTab(searchTab);
				// Allow radio/UI updates to settle, then strip macros again right before search.
				var self = this;
				setTimeout(function() {
					self._disableUserActionFilterOnTab(searchTab);
					self._executeSearch(searchTab);
				}, 0);
				return;
			}

			console.log(LOG + ": Non-admin user — keeping configured Action filter for initial search");
			this._hideCriteriaHeaderSummary(searchTab);
			this._executeSearch(searchTab);
		},

		_executeSearch: function(searchTab) {
			if (!searchTab) {
				return;
			}
			try {
				if (this._reportAdmin) {
					this._disableUserActionFilterOnTab(searchTab);
				}
				if (lang.isFunction(searchTab._search)) {
					searchTab._search();
					return;
				}
				if (searchTab.searchButton && lang.isFunction(searchTab.searchButton.onClick)) {
					searchTab.searchButton.onClick();
					return;
				}
				if (searchTab.searchForm && searchTab.searchForm.searchButton
						&& lang.isFunction(searchTab.searchForm.searchButton.onClick)) {
					searchTab.searchForm.searchButton.onClick();
				}
			} catch (ex) {
				console.error(LOG + ": Failed to execute initial search", ex);
				this._showError("Unable to execute the report request search.");
			}
		},

		_disableUserActionFilterOnTab: function(searchTab) {
			if (!searchTab) {
				return;
			}
			this._clearUserActionFilterOnTemplate(searchTab.searchTemplate);
			if (searchTab.searchForm) {
				if (lang.isFunction(searchTab.searchForm.getSearchTemplate)) {
					this._clearUserActionFilterOnTemplate(searchTab.searchForm.getSearchTemplate());
				}
				if (searchTab.searchForm._searchTemplate) {
					this._clearUserActionFilterOnTemplate(searchTab.searchForm._searchTemplate);
				}
				if (searchTab.searchForm._searchTemplateBackup) {
					this._clearUserActionFilterOnTemplate(searchTab.searchForm._searchTemplateBackup);
				}
			}

			var moreOptions = searchTab._moreOptions
				|| (searchTab.searchForm && searchTab.searchForm._moreOptions)
				|| null;
			if (!moreOptions) {
				return;
			}
			try {
				if (moreOptions._userActionOption && lang.isFunction(moreOptions._userActionOption.setOn)) {
					moreOptions._userActionOption.setOn(false);
				}
				// Keep internal flags consistent even if radio widgets lag.
				moreOptions._userActionOn = false;
				moreOptions._userAction = null;

				var options = lang.isFunction(moreOptions.getSelectedOptions)
					? moreOptions.getSelectedOptions()
					: (searchTab.searchTemplate ? lang.clone(searchTab.searchTemplate.moreOptions || {}) : {});
				if (!options) {
					options = {};
				}
				if (!options.macros) {
					options.macros = {};
				}
				options.macros.userActions = [];
				if (lang.isFunction(moreOptions.setSelectedOptions)) {
					moreOptions.setSelectedOptions(options);
				}

				if (searchTab.searchTemplate) {
					searchTab.searchTemplate.moreOptions = options;
					this._clearUserActionFilterOnTemplate(searchTab.searchTemplate);
				}
				if (searchTab.searchForm && lang.isFunction(searchTab.searchForm.getSearchTemplate)) {
					var liveTemplate = searchTab.searchForm.getSearchTemplate();
					if (liveTemplate) {
						liveTemplate.moreOptions = options;
						this._clearUserActionFilterOnTemplate(liveTemplate);
					}
				}
				if (searchTab.searchForm && searchTab.searchForm._searchTemplate) {
					searchTab.searchForm._searchTemplate.moreOptions = options;
					this._clearUserActionFilterOnTemplate(searchTab.searchForm._searchTemplate);
				}
			} catch (ex) {
				console.warn(LOG + ": Unable to disable Action filter for admin", ex);
			}
		},

		_showError: function(message) {
			new MessageDialog({
				text: message || "An unexpected error occurred."
			}).show();
		},

		reset: function() {
			this.logEntry("reset");
			this.inherited(arguments);
			this.needReset = false;
			this.logExit("reset");
		},

		resize: function() {
			this.inherited(arguments);
			if (this.borderContainer && this.borderContainer.resize) {
				this.borderContainer.resize();
			}
		}
	});
});
