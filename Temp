package com.cnb.updater.util;

import org.apache.commons.lang3.StringUtils;
import org.apache.logging.log4j.core.config.Configurator;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Properties;

public final class LoggingInitializer {

    public static final String LOG_PATH_SYSTEM_PROPERTY = "log.path";
    public static final String LOG_DIRECTORY_SYSTEM_PROPERTY = "log.directory";
    public static final String LOG4J_CONFIG_SYSTEM_PROPERTY = "log4j.configurationFile";
    public static final String DEFAULT_LOG4J_CONFIG_FILE = "config/log4j2.xml";

    private LoggingInitializer() {
    }

    public static String initialize(String configFilePath, String utilityName) throws IOException {
        Properties props = new Properties();
        try (InputStream input = new FileInputStream(configFilePath)) {
            props.load(input);
        }

        String configuredLogPath = props.getProperty(LOG_PATH_SYSTEM_PROPERTY, "logs/cis-update.log");
        String uniqueLogPath = buildUniqueLogPath(configuredLogPath, utilityName);
        Path logFilePath = Paths.get(uniqueLogPath);
        Path logDirectory = logFilePath.getParent();
        if (logDirectory != null) {
            Files.createDirectories(logDirectory);
            System.setProperty(LOG_DIRECTORY_SYSTEM_PROPERTY, logDirectory.toString());
        } else {
            System.setProperty(LOG_DIRECTORY_SYSTEM_PROPERTY, ".");
        }

        System.setProperty(LOG_PATH_SYSTEM_PROPERTY, uniqueLogPath);
        reconfigureLog4j();
        return uniqueLogPath;
    }

    static String buildUniqueLogPath(String configuredLogPath, String utilityName) {
        String normalizedUtilityName = normalizeUtilityName(utilityName);
        String timestamp = new SimpleDateFormat("yyyyMMdd-HHmmss").format(new Date());

        Path path = Paths.get(configuredLogPath.trim());
        String fileName = path.getFileName().toString();

        int extensionIndex = fileName.lastIndexOf('.');
        String baseName = extensionIndex > 0 ? fileName.substring(0, extensionIndex) : fileName;
        String extension = extensionIndex > 0 ? fileName.substring(extensionIndex) : ".log";

        String uniqueFileName = baseName + "-" + normalizedUtilityName + "-" + timestamp + extension;
        Path parent = path.getParent();
        if (parent == null) {
            return uniqueFileName;
        }
        return parent.resolve(uniqueFileName).toString();
    }

    private static String normalizeUtilityName(String utilityName) {
        if (StringUtils.isBlank(utilityName)) {
            return "run";
        }
        return utilityName.trim().toLowerCase().replaceAll("[^a-z0-9_-]+", "-");
    }

    private static void reconfigureLog4j() {
        String log4jConfigPath = System.getProperty(LOG4J_CONFIG_SYSTEM_PROPERTY, DEFAULT_LOG4J_CONFIG_FILE);
        File log4jConfigFile = new File(log4jConfigPath);
        if (!log4jConfigFile.isFile()) {
            throw new IllegalStateException("Log4j2 configuration file not found: " + log4jConfigPath);
        }
        Configurator.reconfigure(log4jConfigFile.toURI());
    }
}




package com.cnb.updater.main;

import com.cnb.updater.config.AppConfig;
import com.cnb.updater.csv.CsvReader;
import com.cnb.updater.csv.CsvWriter;
