define([
	"dojo/_base/array",
	"ecm/model/Desktop"
], function(array, Desktop) {

	/**
	 * Loads P8 repositories (object stores) available on the current ICN desktop.
	 */
	var RepositoryService = {

		/**
		 * Returns accessible P8 repositories for the current desktop user.
		 * Each entry maps to a FileNet object store configured on the desktop.
		 */
		getObjectStores: function() {
			var results = [];
			if (!Desktop.repositories || !Desktop.repositories.length) {
				return results;
			}
			array.forEach(Desktop.repositories, function(repository) {
				if (repository && repository.type === "p8") {
					results.push({
						id: repository.id,
						repositoryId: repository.id,
						objectStoreId: repository.objectStoreName || repository.id,
						displayName: repository.objectStoreDisplayName || repository.name || repository.objectStoreName || repository.id,
						repository: repository,
						connected: !!repository.connected
					});
				}
			});
			results.sort(function(a, b) {
				return (a.displayName || "").localeCompare(b.displayName || "", undefined, {
					sensitivity: "base"
				});
			});
			return results;
		},

		getRepositoryById: function(repositoryId) {
			if (!repositoryId) {
				return null;
			}
			return Desktop.getRepository(repositoryId);
		},

		getObjectStoreOption: function(objectStore) {
			if (!objectStore) {
				return null;
			}
			return {
				label: objectStore.displayName,
				value: objectStore.repositoryId
			};
		}
	};

	return RepositoryService;
});
