package com.exportsrc;
import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

/**
 * Imports a human-readable UTF-8 package generated by
 * SourceProjectExporter and recreates the complete folder structure.
 *
 * Java version: 1.8+
 */
public class SourceProjectImporter {

    private static final String DEFAULT_PACKAGE_FILE =
            "D:\\rasystem\\Workspace\\CNBRepoMetadataExportPlugin"
                    + "\\CNBRepoMetadataExportPlugin_Source.txt";

    private static final String DEFAULT_TARGET_FOLDER =
            "D:\\Filenet\\src";

    private static final String PACKAGE_HEADER =
            "@@CNB_PACKAGE_BEGIN@@";

    private static final String PACKAGE_END =
            "@@CNB_PACKAGE_END@@";

    private static final String DIRECTORY_BEGIN =
            "@@CNB_PACKAGE_DIRECTORY_BEGIN@@";

    private static final String DIRECTORY_END =
            "@@CNB_PACKAGE_DIRECTORY_END@@";

    private static final String FILE_BEGIN =
            "@@CNB_PACKAGE_FILE_BEGIN@@";

    private static final String CONTENT_BEGIN =
            "@@CNB_PACKAGE_CONTENT_BEGIN@@";

    private static final String CONTENT_END =
            "@@CNB_PACKAGE_CONTENT_END@@";

    private static final String FILE_END =
            "@@CNB_PACKAGE_FILE_END@@";

    private static final String ESCAPE_PREFIX =
            "@@CNB_PACKAGE_ESCAPED_LINE@@";

    private int fileCount;
    private int folderCount;

    public static void main(String[] args) {

        String packageFile = DEFAULT_PACKAGE_FILE;
        String targetFolder = DEFAULT_TARGET_FOLDER;

        if (args.length >= 1 && !isBlank(args[0])) {
            packageFile = args[0].trim();
        }

        if (args.length >= 2 && !isBlank(args[1])) {
            targetFolder = args[1].trim();
        }

        SourceProjectImporter importer =
                new SourceProjectImporter();

        try {
            importer.importProject(
                    Paths.get(packageFile),
                    Paths.get(targetFolder));

            System.out.println();
            System.out.println("Import completed successfully.");
            System.out.println("Package file  : " + packageFile);
            System.out.println("Target folder : " + targetFolder);
            System.out.println("Folders       : " + importer.folderCount);
            System.out.println("Files         : " + importer.fileCount);

        } catch (Exception e) {
            System.err.println("Import failed.");
            e.printStackTrace();
            System.exit(1);
        }
    }

    public void importProject(
            Path packageFile,
            Path targetRoot) throws IOException {

        packageFile =
                packageFile.toAbsolutePath().normalize();

        targetRoot =
                targetRoot.toAbsolutePath().normalize();

        validateInput(packageFile, targetRoot);

        Files.createDirectories(targetRoot);

        try (BufferedReader reader = Files.newBufferedReader(
                packageFile,
                StandardCharsets.UTF_8)) {

            String firstLine = reader.readLine();

            if (!PACKAGE_HEADER.equals(firstLine)) {
                throw new IOException(
                        "Invalid package file. Expected: "
                                + PACKAGE_HEADER);
            }

            skipHeader(reader);

            String line;

            while ((line = reader.readLine()) != null) {

                if (line.trim().isEmpty()) {
                    continue;
                }

                if (PACKAGE_END.equals(line)) {
                    System.out.println(
                            "End of package reached.");
                    return;
                }

                if (DIRECTORY_BEGIN.equals(line)) {
                    importDirectory(reader, targetRoot);
                    continue;
                }

                if (FILE_BEGIN.equals(line)) {
                    importFile(reader, targetRoot);
                    continue;
                }

                throw new IOException(
                        "Unexpected package line: " + line);
            }

            throw new IOException(
                    "Package end marker was not found.");
        }
    }

    private void skipHeader(
            BufferedReader reader) throws IOException {

        String line;

        while ((line = reader.readLine()) != null) {
            if ("@@CNB_PACKAGE_HEADER_END@@".equals(line)) {
                return;
            }
        }

        throw new IOException(
                "Package header end marker was not found.");
    }

    private void importDirectory(
            BufferedReader reader,
            Path targetRoot) throws IOException {

        String relativePath = null;
        long lastModified = 0L;

        String line;

        while ((line = reader.readLine()) != null) {

            if (line.startsWith("RELATIVE_PATH=")) {
                relativePath =
                        line.substring(
                                "RELATIVE_PATH=".length());

            } else if (line.startsWith("LAST_MODIFIED=")) {
                lastModified =
                        parseLong(
                                line.substring(
                                        "LAST_MODIFIED=".length()),
                                "directory last-modified time");

            } else if (DIRECTORY_END.equals(line)) {
                break;

            } else {
                throw new IOException(
                        "Invalid directory record: " + line);
            }
        }

        if (relativePath == null
                || relativePath.trim().isEmpty()) {

            throw new IOException(
                    "Directory relative path is missing.");
        }

        Path targetDirectory =
                resolveSecurePath(
                        targetRoot,
                        relativePath);

        Files.createDirectories(targetDirectory);

        if (lastModified > 0L) {
            targetDirectory
                    .toFile()
                    .setLastModified(lastModified);
        }

        folderCount++;

        System.out.println(
                "Created folder: " + relativePath);
    }

    private void importFile(
            BufferedReader reader,
            Path targetRoot) throws IOException {

        String fileName = null;
        String relativePath = null;
        String fileType = null;
        long lastModified = 0L;

        String line;

        /*
         * Read file metadata until content starts.
         */
        while ((line = reader.readLine()) != null) {

            if (line.startsWith("FILE_NAME=")) {
                fileName =
                        line.substring(
                                "FILE_NAME=".length());

            } else if (line.startsWith("RELATIVE_PATH=")) {
                relativePath =
                        line.substring(
                                "RELATIVE_PATH=".length());

            } else if (line.startsWith("FILE_TYPE=")) {
                fileType =
                        line.substring(
                                "FILE_TYPE=".length());

            } else if (line.startsWith("LAST_MODIFIED=")) {
                lastModified =
                        parseLong(
                                line.substring(
                                        "LAST_MODIFIED=".length()),
                                "file last-modified time");

            } else if (line.startsWith("FILE_SIZE=")) {
                /*
                 * Informational field. The restored text file size
                 * can vary slightly if its original line endings
                 * were different.
                 */

            } else if (CONTENT_BEGIN.equals(line)) {
                break;

            } else {
                throw new IOException(
                        "Invalid file metadata line: " + line);
            }
        }

        if (line == null) {
            throw new IOException(
                    "Unexpected end of package before file content.");
        }

        if (relativePath == null
                || relativePath.trim().isEmpty()) {

            throw new IOException(
                    "File relative path is missing.");
        }

        Path targetFile =
                resolveSecurePath(
                        targetRoot,
                        relativePath);

        if (targetFile.getParent() != null) {
            Files.createDirectories(
                    targetFile.getParent());
        }

        /*
         * Write the source-code content as UTF-8.
         */
        try (BufferedWriter writer =
                     Files.newBufferedWriter(
                             targetFile,
                             StandardCharsets.UTF_8)) {

            boolean contentEnded = false;

            while ((line = reader.readLine()) != null) {

                if (CONTENT_END.equals(line)) {
                    contentEnded = true;
                    break;
                }

                /*
                 * Restore lines escaped by the exporter.
                 */
                if (line.startsWith(ESCAPE_PREFIX)) {
                    line = line.substring(
                            ESCAPE_PREFIX.length());
                }

                writer.write(line);
                writer.newLine();
            }

            if (!contentEnded) {
                throw new IOException(
                        "Content end marker was not found for: "
                                + relativePath);
            }
        }

        String fileEndLine = reader.readLine();

        if (!FILE_END.equals(fileEndLine)) {
            throw new IOException(
                    "File end marker was not found for: "
                            + relativePath);
        }

        if (lastModified > 0L) {
            targetFile.toFile()
                    .setLastModified(lastModified);
        }

        fileCount++;

        System.out.println(
                "Created file: " + relativePath
                        + " [" + fileType + "]"
                        + " Name=" + fileName);
    }

    private Path resolveSecurePath(
            Path targetRoot,
            String relativePath) throws IOException {

        String operatingSystemPath =
                relativePath.replace(
                        '/',
                        File.separatorChar);

        Path resolvedPath =
                targetRoot.resolve(
                                operatingSystemPath)
                        .normalize()
                        .toAbsolutePath();

        /*
         * Security check to prevent paths such as:
         * ../../outsideFolder/file.java
         */
        if (!resolvedPath.startsWith(targetRoot)) {
            throw new IOException(
                    "Unsafe path found in package: "
                            + relativePath);
        }

        return resolvedPath;
    }

    private void validateInput(
            Path packageFile,
            Path targetRoot) throws IOException {

        if (!Files.exists(packageFile)) {
            throw new IOException(
                    "Package file does not exist: "
                            + packageFile);
        }

        if (!Files.isRegularFile(packageFile)) {
            throw new IOException(
                    "Package path is not a file: "
                            + packageFile);
        }

        if (Files.exists(targetRoot)
                && !Files.isDirectory(targetRoot)) {

            throw new IOException(
                    "Target path is not a folder: "
                            + targetRoot);
        }
    }

    private long parseLong(
            String value,
            String description) throws IOException {

        try {
            return Long.parseLong(value.trim());

        } catch (NumberFormatException e) {
            throw new IOException(
                    "Invalid " + description
                            + ": " + value,
                    e);
        }
    }

    private static boolean isBlank(String value) {
        return value == null
                || value.trim().isEmpty();
    }
}


package com.exportsrc;
import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.FileVisitResult;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.SimpleFileVisitor;
import java.nio.file.attribute.BasicFileAttributes;
import java.nio.file.attribute.FileTime;
import java.text.SimpleDateFormat;
import java.util.Date;

/**
 * Exports all supported source files and empty folders under a source directory
 * into one human-readable UTF-8 text package.
 *
 * Java version: 1.8+
 */
public class SourceProjectExporter {

    private static final String DEFAULT_SOURCE_FOLDER =
            "D:\\rasystem\\Workspace\\CNBRepoMetadataExportPlugin\\src";

    private static final String DEFAULT_OUTPUT_FILE =
            "D:\\rasystem\\Workspace\\CNBRepoMetadataExportPlugin"
                    + "\\CNBRepoMetadataExportPlugin_Source.txt";

    private static final String PACKAGE_HEADER =
            "@@CNB_PACKAGE_BEGIN@@";

    private static final String PACKAGE_END =
            "@@CNB_PACKAGE_END@@";

    private static final String DIRECTORY_BEGIN =
            "@@CNB_PACKAGE_DIRECTORY_BEGIN@@";

    private static final String DIRECTORY_END =
            "@@CNB_PACKAGE_DIRECTORY_END@@";

    private static final String FILE_BEGIN =
            "@@CNB_PACKAGE_FILE_BEGIN@@";

    private static final String CONTENT_BEGIN =
            "@@CNB_PACKAGE_CONTENT_BEGIN@@";

    private static final String CONTENT_END =
            "@@CNB_PACKAGE_CONTENT_END@@";

    private static final String FILE_END =
            "@@CNB_PACKAGE_FILE_END@@";

    private static final String ESCAPE_PREFIX =
            "@@CNB_PACKAGE_ESCAPED_LINE@@";

    private int fileCount;
    private int folderCount;

    public static void main(String[] args) {

        String sourceFolder = DEFAULT_SOURCE_FOLDER;
        String outputFile = DEFAULT_OUTPUT_FILE;

        if (args.length >= 1 && !isBlank(args[0])) {
            sourceFolder = args[0].trim();
        }

        if (args.length >= 2 && !isBlank(args[1])) {
            outputFile = args[1].trim();
        }

        SourceProjectExporter exporter =
                new SourceProjectExporter();

        try {
            exporter.exportProject(
                    Paths.get(sourceFolder),
                    Paths.get(outputFile));

            System.out.println();
            System.out.println("Export completed successfully.");
            System.out.println("Source folder : " + sourceFolder);
            System.out.println("Output file   : " + outputFile);
            System.out.println("Folders       : " + exporter.folderCount);
            System.out.println("Files         : " + exporter.fileCount);

        } catch (Exception e) {
            System.err.println("Export failed.");
            e.printStackTrace();
            System.exit(1);
        }
    }

    public void exportProject(
            Path sourceRoot,
            Path outputFile) throws IOException {

        sourceRoot = sourceRoot.toAbsolutePath().normalize();
        outputFile = outputFile.toAbsolutePath().normalize();

        validateSourceFolder(sourceRoot);

        if (outputFile.getParent() != null) {
            Files.createDirectories(outputFile.getParent());
        }

        final Path finalSourceRoot = sourceRoot;
        final Path finalOutputFile = outputFile;

        try (BufferedWriter writer = Files.newBufferedWriter(
                outputFile,
                StandardCharsets.UTF_8)) {

            writePackageHeader(writer, sourceRoot);

            Files.walkFileTree(
                    sourceRoot,
                    new SimpleFileVisitor<Path>() {

                        @Override
                        public FileVisitResult preVisitDirectory(
                                Path directory,
                                BasicFileAttributes attributes)
                                throws IOException {

                            if (!directory.equals(finalSourceRoot)) {
                                writeDirectory(
                                        writer,
                                        finalSourceRoot,
                                        directory,
                                        attributes.lastModifiedTime());

                                folderCount++;
                            }

                            return FileVisitResult.CONTINUE;
                        }

                        @Override
                        public FileVisitResult visitFile(
                                Path file,
                                BasicFileAttributes attributes)
                                throws IOException {

                            /*
                             * Do not include the generated package itself.
                             */
                            if (file.toAbsolutePath()
                                    .normalize()
                                    .equals(finalOutputFile)) {

                                System.out.println(
                                        "Skipping output package: " + file);

                                return FileVisitResult.CONTINUE;
                            }

                            writeFile(
                                    writer,
                                    finalSourceRoot,
                                    file,
                                    attributes);

                            fileCount++;

                            return FileVisitResult.CONTINUE;
                        }

                        @Override
                        public FileVisitResult visitFileFailed(
                                Path file,
                                IOException exception)
                                throws IOException {

                            throw new IOException(
                                    "Unable to read: " + file,
                                    exception);
                        }
                    });

            writer.write(PACKAGE_END);
            writer.newLine();
        }
    }

    private void writePackageHeader(
            BufferedWriter writer,
            Path sourceRoot) throws IOException {

        writer.write(PACKAGE_HEADER);
        writer.newLine();

        writer.write("FORMAT_VERSION=1");
        writer.newLine();

        writer.write("CHARACTER_ENCODING=UTF-8");
        writer.newLine();

        writer.write("SOURCE_ROOT_NAME="
                + sourceRoot.getFileName().toString());
        writer.newLine();

        writer.write("CREATED_TIME="
                + System.currentTimeMillis());
        writer.newLine();

        writer.write("CREATED_DATE="
                + formatDate(System.currentTimeMillis()));
        writer.newLine();

        writer.write("@@CNB_PACKAGE_HEADER_END@@");
        writer.newLine();
        writer.newLine();
    }

    private void writeDirectory(
            BufferedWriter writer,
            Path sourceRoot,
            Path directory,
            FileTime lastModifiedTime)
            throws IOException {

        String relativePath =
                convertToPackagePath(
                        sourceRoot.relativize(directory));

        writer.write(DIRECTORY_BEGIN);
        writer.newLine();

        writer.write("RELATIVE_PATH=" + relativePath);
        writer.newLine();

        writer.write("LAST_MODIFIED="
                + lastModifiedTime.toMillis());
        writer.newLine();

        writer.write(DIRECTORY_END);
        writer.newLine();
        writer.newLine();

        System.out.println("Folder: " + relativePath);
    }

    private void writeFile(
            BufferedWriter writer,
            Path sourceRoot,
            Path file,
            BasicFileAttributes attributes)
            throws IOException {

        String relativePath =
                convertToPackagePath(
                        sourceRoot.relativize(file));

        String fileName =
                file.getFileName().toString();

        String fileType =
                getFileType(fileName);

        writer.write(FILE_BEGIN);
        writer.newLine();

        writer.write("FILE_NAME=" + fileName);
        writer.newLine();

        writer.write("RELATIVE_PATH=" + relativePath);
        writer.newLine();

        writer.write("FILE_TYPE=" + fileType);
        writer.newLine();

        writer.write("LAST_MODIFIED="
                + attributes.lastModifiedTime().toMillis());
        writer.newLine();

        writer.write("FILE_SIZE="
                + attributes.size());
        writer.newLine();

        writer.write(CONTENT_BEGIN);
        writer.newLine();

        /*
         * Java, JavaScript, HTML, CSS and other source files are read
         * as UTF-8 text.
         */
        try (BufferedReader reader = Files.newBufferedReader(
                file,
                StandardCharsets.UTF_8)) {

            String line;

            while ((line = reader.readLine()) != null) {

                /*
                 * Escape package-control lines that happen to occur
                 * inside source code.
                 */
                if (line.startsWith("@@CNB_PACKAGE_")) {
                    writer.write(ESCAPE_PREFIX);
                }

                writer.write(line);
                writer.newLine();
            }
        }

        writer.write(CONTENT_END);
        writer.newLine();

        writer.write(FILE_END);
        writer.newLine();
        writer.newLine();

        System.out.println(
                "File  : " + relativePath
                        + " [" + fileType + "]");
    }

    private void validateSourceFolder(
            Path sourceRoot) throws IOException {

        if (!Files.exists(sourceRoot)) {
            throw new IOException(
                    "Source folder does not exist: "
                            + sourceRoot);
        }

        if (!Files.isDirectory(sourceRoot)) {
            throw new IOException(
                    "Source path is not a folder: "
                            + sourceRoot);
        }

        if (!Files.isReadable(sourceRoot)) {
            throw new IOException(
                    "Source folder is not readable: "
                            + sourceRoot);
        }
    }

    private String convertToPackagePath(Path relativePath) {
        return relativePath.toString()
                .replace(File.separatorChar, '/');
    }

    private String getFileType(String fileName) {

        String lowerName = fileName.toLowerCase();

        if (lowerName.endsWith(".java")) {
            return "JAVA";
        }

        if (lowerName.endsWith(".js")) {
            return "JAVASCRIPT";
        }

        if (lowerName.endsWith(".html")
                || lowerName.endsWith(".htm")) {
            return "HTML";
        }

        if (lowerName.endsWith(".css")) {
            return "CSS";
        }

        if (lowerName.endsWith(".xml")) {
            return "XML";
        }

        if (lowerName.endsWith(".json")) {
            return "JSON";
        }

        if (lowerName.endsWith(".properties")) {
            return "PROPERTIES";
        }

        if (lowerName.endsWith(".txt")) {
            return "TEXT";
        }

        if (lowerName.endsWith(".jsp")) {
            return "JSP";
        }

        if (lowerName.endsWith(".MF")
                || lowerName.endsWith(".mf")) {
            return "MANIFEST";
        }

        return "OTHER_TEXT";
    }

    private String formatDate(long milliseconds) {
        return new SimpleDateFormat(
                "yyyy-MM-dd HH:mm:ss")
                .format(new Date(milliseconds));
    }

    private static boolean isBlank(String value) {
        return value == null
                || value.trim().isEmpty();
    }
}
