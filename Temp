package com.cnb.reports.filter;

import javax.servlet.http.HttpServletRequest;

import com.cnb.reports.constants.ReportPluginConstants;
import com.ibm.ecm.extension.PluginResponseFilter;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.ecm.json.JSONResultSetColumn;
import com.ibm.ecm.json.JSONResultSetResponse;
import com.ibm.json.java.JSONArray;
import com.ibm.json.java.JSONObject;

/**
 * For {@code /p8/search} and {@code /p8/continueQuery}: when result rows are {@code ReportRequest},
 * <ul>
 * <li>adds/assigns the download column decorator used by the Reports grid</li>
 * <li>sets {@code itemContextMenuDef} to {@code ReportsItemContextMenu}</li>
 * </ul>
 * <p>
 * Follows the same response-filter pattern as {@code UpdateFolderPathResponseFilter}
 * (read {@code rows[].template}, then set column {@code decorator}).
 * </p>
 */
public class ReportRequestSearchResponseFilter extends PluginResponseFilter {

	private static final String DECORATOR =
			"cNBReportsPluginDojo.ReportDownloadDecorator.decorateCell";

	@Override
	public String[] getFilteredServices() {
		return new String[] {
				"/p8/search",
				"/p8/continueQuery"
		};
	}

	@Override
	public void filter(String serverType, PluginServiceCallbacks callbacks, HttpServletRequest request,
			JSONObject jsonResponse) throws Exception {
		try {
			JSONArray rows = (JSONArray) jsonResponse.get("rows");
			if (rows == null || rows.isEmpty()) {
				return;
			}

			boolean hasReportRequest = false;
			for (int i = 0; i < rows.size(); i++) {
				Object item = rows.get(i);
				if (!(item instanceof JSONObject)) {
					continue;
				}
				if (isReportRequestRow((JSONObject) item)) {
					hasReportRequest = true;
					break;
				}
			}
			if (!hasReportRequest) {
				return;
			}

			String downloadField = ReportPluginConstants.REPORT_REQUEST_GRID_DOWNLOAD_FIELD;
			for (int i = 0; i < rows.size(); i++) {
				Object item = rows.get(i);
				if (!(item instanceof JSONObject)) {
					continue;
				}
				JSONObject rowObj = (JSONObject) item;
				if (!isReportRequestRow(rowObj)) {
					setAttributeValue(rowObj, downloadField, "");
					continue;
				}
				String status = readAttributeString(rowObj, ReportPluginConstants.REPORT_REQUEST_PROPERTY_STATUS);
				String downloadFlag = isCompletedStatus(status) ? "download" : "";
				setAttributeValue(rowObj, downloadField, downloadFlag);
			}

			// Same menu type used by ReportsFeatureMainPane ContentList.
			jsonResponse.put("itemContextMenuDef",
					com.cnb.reports.menu.ReportsItemContextMenuType.MENU_TYPE_ID);

			if (!(jsonResponse instanceof JSONResultSetResponse)) {
				return;
			}
			JSONResultSetResponse resultSetResponse = (JSONResultSetResponse) jsonResponse;
			ensureDownloadColumn(resultSetResponse, downloadField);
		} catch (Exception e) {
			if (callbacks != null && callbacks.getLogger() != null) {
				callbacks.getLogger().logError(this, "filter", request, e);
			}
		}
	}

	private static void ensureDownloadColumn(JSONResultSetResponse resultSetResponse, String downloadField) {
		for (int i = 0; i < resultSetResponse.getColumnCount(); i++) {
			JSONResultSetColumn column = resultSetResponse.getColumn(i);
			String columnName = column != null ? (String) column.get("field") : null;
			if (downloadField.equals(columnName)) {
				column.put("decorator", DECORATOR);
				column.put("sortable", Boolean.FALSE);
				column.put("filterable", Boolean.FALSE);
				if (column.get("headerClasses") == null) {
					column.put("headerClasses", "ecmIconCell");
				}
				if (column.get("cellClasses") == null) {
					column.put("cellClasses", "ecmIconCell");
				}
				return;
			}
		}

		JSONResultSetColumn downloadColumn = new JSONResultSetColumn("&nbsp;", "2%", downloadField, null, false);
		downloadColumn.put("decorator", DECORATOR);
		downloadColumn.put("sortable", Boolean.FALSE);
		downloadColumn.put("filterable", Boolean.FALSE);
		downloadColumn.put("headerClasses", "ecmIconCell");
		downloadColumn.put("cellClasses", "ecmIconCell");
		resultSetResponse.addColumn(downloadColumn);
	}

	private static boolean isReportRequestRow(JSONObject rowObj) {
		String templateName = null;
		Object template = rowObj.get("template");
		if (template != null) {
			templateName = String.valueOf(template).trim();
		}
		if (templateName == null || templateName.length() == 0) {
			Object idObject = rowObj.get("id");
			if (idObject != null) {
				String[] idParts = idObject.toString().split(",");
				if (idParts.length > 0) {
					templateName = idParts[0].trim();
				}
			}
		}
		return ReportPluginConstants.REPORT_REQUEST_CLASS.equals(templateName);
	}

	private static String readAttributeString(JSONObject rowObj, String field) {
		Object attributesObj = rowObj.get("attributes");
		if (!(attributesObj instanceof JSONObject)) {
			return null;
		}
		JSONObject attributes = (JSONObject) attributesObj;
		Object valueObj = attributes.get(field);
		if (valueObj instanceof JSONArray) {
			JSONArray arr = (JSONArray) valueObj;
			if (!arr.isEmpty() && arr.get(0) != null) {
				return String.valueOf(arr.get(0)).trim();
			}
			return "";
		}
		return valueObj != null ? String.valueOf(valueObj).trim() : null;
	}

	@SuppressWarnings("unchecked")
	private static void setAttributeValue(JSONObject rowObj, String field, String value) {
		Object attributesObj = rowObj.get("attributes");
		JSONObject attributes;
		if (attributesObj instanceof JSONObject) {
			attributes = (JSONObject) attributesObj;
		} else {
			attributes = new JSONObject();
			rowObj.put("attributes", attributes);
		}

		Object existing = attributes.get(field);
		if (existing instanceof JSONArray) {
			JSONArray arr = (JSONArray) existing;
			if (arr.isEmpty()) {
				arr.add(value);
			} else {
				arr.set(0, value);
			}
			return;
		}

		JSONArray values = new JSONArray();
		values.add(value);
		attributes.put(field, values);
	}

	private static boolean isCompletedStatus(String status) {
		return status != null
				&& ReportPluginConstants.REPORT_REQUEST_STATUS_COMPLETED.equalsIgnoreCase(status.trim());
	}
}
